  "customhud.maps.players.any": "Any players",
  "customhud.maps.players.range": "{0}–{1} players",
  "customhud.maps.players.min": "{0}+ players",
  "customhud.maps.players.max": "Up to {0} players",
  "customhud.maps.chip.vote_ends": "vote ends",
  "customhud.maps.chip.voted": "voted",
