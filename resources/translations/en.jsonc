  "customhud.maps.chip.rounds_left": "rounds left",
  "customhud.maps.votes.one": "{0} vote",
  "customhud.maps.votes.other": "{0} votes",
  "customhud.maps.your_vote": "Your vote",
  "customhud.maps.your_pick": "Your pick",
  "customhud.maps.nominated": "Nominated",
  "customhud.maps.cooldown": "Played recently",
  "customhud.maps.needs": "Needs {0} players",
  "customhud.maps.too_many": "Too many players",
  "customhud.maps.turnout": "{0} of {1} players voted",
