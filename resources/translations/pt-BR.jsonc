{
  // Chat replies to !setnav and !hudscale, each sent after customhud.prefix.
  // [green] and [default] are SwiftlyS2 chat colour tags.
  "customhud.prefix": "[green][CustomHUD][default]",
  "customhud.nav.usage": "Uso: !setnav wasd | buttons | numbers | mouse (atual: {0})",
  "customhud.nav.set": "Navegação definida para [green]{0}[default].",
  "customhud.scale.usage": "Uso: !hudscale {0}",
  "customhud.scale.set": "Escala do menu definida para [green]{0}%[default].",

  // Menu footer per nav mode; ".view" is a menu with nothing to select. {up} {down}
  // {select} {close} name the menu's keys. A "Hints" entry in config.jsonc overrides
  // a key in every language. The footer is one uppercase line, so keep them short.
  "customhud.hint.wasd": "W/S MOVER · E SELECIONAR · R FECHAR",
  "customhud.hint.buttons": "{up}/{down} MOVER · {select} SELECIONAR · {close} FECHAR",
  "customhud.hint.numbers": "1-6 SELECIONAR · 7/8 PÁGINA · 9 FECHAR",
  "customhud.hint.mouse": "Clique para selecionar",
  "customhud.hint.chat": "!N SELECIONAR · !0 SELECIONAR",
  "customhud.hint.wasd.view": "R FECHAR",
  "customhud.hint.buttons.view": "{close} FECHAR",
  "customhud.hint.numbers.view": "9 FECHAR",
  "customhud.hint.mouse.view": "CLIQUE EM {close} PARA FECHAR",
  "customhud.hint.chat.view": "!0 FECHAR",

  // Page lockers (menu_locker): the gold line above a plugin's title when its menu
  // has no root title of its own, and the tag on the row holding the most votes.
  // Any plugin's menus can have that line too: add "customhud.eyebrow.<plugin>", where <plugin>
  // is the first part of its menu ids ("missions" for missions.main; DetailedLogging names
  // them), or "customhud.eyebrow.default" for every plugin without one. "" shows no line.
  // Neither ships, so a key added here reaches players in every language.
  "customhud.eyebrow.shop": "Loja",
  "customhud.eyebrow.maps": "Votação de mapas",
  "customhud.eyebrow.ranks": "Patentes",
  "customhud.eyebrow.vip": "VIP",
  "customhud.eyebrow.admins": "Administrador",
  "customhud.eyebrow.mix": "Mix",
  "customhud.lead": "Na liderança",

  // The list's footer (menu_list): the word beside each key. Shown upper case.
  "customhud.legend.move": "Mover",
  "customhud.legend.select": "Selecionar",
  "customhud.legend.pick": "Escolher",
  "customhud.legend.open": "Abrir",
  "customhud.legend.switch": "Alternar",
  "customhud.legend.edit": "Editar",
  "customhud.legend.change": "Alterar",
  "customhud.legend.vote": "Votar",
  "customhud.legend.apply": "Aplicar",
  "customhud.legend.page": "Página",
  "customhud.legend.back": "Voltar",
  "customhud.legend.close": "Fechar",

  // ---- Provider pages --------------------------------------------------------------------------
  //
  // Captions CustomHUD adds when it draws another plugin's menus from that plugin's API (Ranks and
  // its modules, WeaponSkins, ShopCore, MapChooser). Names, figures and the provider's own lines
  // still come from the provider. Plain text, no colour tags, and no ';', which ends a value.

  "customhud.ranks.xp": "XP",
  "customhud.ranks.cs_rating": "Classificação CS",
  "customhud.ranks.current_rank": "Patente atual",
  "customhud.ranks.band": "Faixa {0} de {1}",
  "customhud.ranks.position": "Patente {0} de {1}",
  // {0} the XP still needed, {1} the next rank.
  "customhud.ranks.to_next": "Faltam {0} XP para {1}",
  "customhud.ranks.top_band": "Maior patente alcançada",
  "customhud.ranks.road": "Progressão de patentes",
  "customhud.ranks.road_count": "{0} patentes",
  // A ladder too long for one line shows the ranks around the player's own: {0}-{1} of them.
  "customhud.ranks.road_shown": "{0}–{1} exibidas",
  "customhud.ranks.you": "Você",
  "customhud.ranks.kills": "Abates",
