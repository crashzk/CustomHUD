  "customhud.ranks.col_player": "Jogador",
  "customhud.ranks.col_tier": "Categoria",
  "customhud.ranks.notifications": "Notificações",
  "customhud.ranks.xp_messages_sub": "Uma mensagem no chat sempre que você ganhar ou perder XP",
