				</Panel>
				<Panel class="sk-body">
					<Panel id="tabs" class="sk-tabs hidden">
						<Button id="tab_0" class="sk-tab hidden"><Label class="sk-tab__label" text="{s:tab}" hittest="false" /><Label class="sk-tab__count" text="{s:tab_count}" hittest="false" /></Button>
