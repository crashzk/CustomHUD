/*
	ShopCore's views on menu_locker; locker.vcss draws the frame and the plain list.
	A price's coin is `vglyph=`, inside the value's group (lk-vglyph); `glyph=` is the item's
	own icon, shown where an item without a picture would show its art.
*/

/* ---- shop-categories: a category as a tile, the way the WeaponSkins locker draws its own ---- */

/* Three to a line, 3 x (286 + 6) = 876 of the list's 882. Fewer categories get taller tiles, so one
   line of them, or two, fills the page rather than leaving a strip above an empty one. */
.lk.view-shop-categories .lk-slot
{
	width: 286px;
	height: 168px;
	margin: 0px 6px 8px 0px;
}

.lk.view-shop-categories .hk-rows-1 .lk-slot,
.lk.view-shop-categories .hk-rows-2 .lk-slot,
.lk.view-shop-categories .hk-rows-3 .lk-slot
{
	height: 320px;
}

.lk.view-shop-categories .hk-rows-4 .lk-slot,
.lk.view-shop-categories .hk-rows-5 .lk-slot,
.lk.view-shop-categories .hk-rows-6 .lk-slot
{
	height: 256px;
}

/* The last line closes square: two left over share it, one left over makes the last two lines pairs. */
.lk.view-shop-categories .hk-rows-1 #option_0 { width: 870px; }
.lk.view-shop-categories .hk-rows-2 #option_0, .lk.view-shop-categories .hk-rows-2 #option_1 { width: 432px; }
.lk.view-shop-categories .hk-rows-4 #option_0, .lk.view-shop-categories .hk-rows-4 #option_1, .lk.view-shop-categories .hk-rows-4 #option_2, .lk.view-shop-categories .hk-rows-4 #option_3 { width: 432px; }
.lk.view-shop-categories .hk-rows-5 #option_3, .lk.view-shop-categories .hk-rows-5 #option_4 { width: 432px; }
.lk.view-shop-categories .hk-rows-7 #option_3, .lk.view-shop-categories .hk-rows-7 #option_4, .lk.view-shop-categories .hk-rows-7 #option_5, .lk.view-shop-categories .hk-rows-7 #option_6 { width: 432px; }
.lk.view-shop-categories .hk-rows-8 #option_6, .lk.view-shop-categories .hk-rows-8 #option_7 { width: 432px; }
.lk.view-shop-categories .hk-rows-10 #option_6, .lk.view-shop-categories .hk-rows-10 #option_7, .lk.view-shop-categories .hk-rows-10 #option_8, .lk.view-shop-categories .hk-rows-10 #option_9 { width: 432px; }
.lk.view-shop-categories .hk-rows-11 #option_9, .lk.view-shop-categories .hk-rows-11 #option_10 { width: 432px; }
.lk.view-shop-categories .hk-rows-13 #option_9, .lk.view-shop-categories .hk-rows-13 #option_10, .lk.view-shop-categories .hk-rows-13 #option_11, .lk.view-shop-categories .hk-rows-13 #option_12 { width: 432px; }
.lk.view-shop-categories .hk-rows-14 #option_12, .lk.view-shop-categories .hk-rows-14 #option_13 { width: 432px; }
.lk.view-shop-categories .hk-rows-16 #option_12, .lk.view-shop-categories .hk-rows-16 #option_13, .lk.view-shop-categories .hk-rows-16 #option_14, .lk.view-shop-categories .hk-rows-16 #option_15 { width: 432px; }
.lk.view-shop-categories .hk-rows-17 #option_15, .lk.view-shop-categories .hk-rows-17 #option_16 { width: 432px; }
.lk.view-shop-categories .hk-rows-19 #option_15, .lk.view-shop-categories .hk-rows-19 #option_16, .lk.view-shop-categories .hk-rows-19 #option_17, .lk.view-shop-categories .hk-rows-19 #option_18 { width: 432px; }
.lk.view-shop-categories .hk-rows-20 #option_18, .lk.view-shop-categories .hk-rows-20 #option_19 { width: 432px; }
.lk.view-shop-categories .hk-rows-22 #option_18, .lk.view-shop-categories .hk-rows-22 #option_19, .lk.view-shop-categories .hk-rows-22 #option_20, .lk.view-shop-categories .hk-rows-22 #option_21 { width: 432px; }
.lk.view-shop-categories .hk-rows-23 #option_21, .lk.view-shop-categories .hk-rows-23 #option_22 { width: 432px; }
.lk.view-shop-categories .hk-rows-25 #option_21, .lk.view-shop-categories .hk-rows-25 #option_22, .lk.view-shop-categories .hk-rows-25 #option_23, .lk.view-shop-categories .hk-rows-25 #option_24 { width: 432px; }
.lk.view-shop-categories .hk-rows-26 #option_24, .lk.view-shop-categories .hk-rows-26 #option_25 { width: 432px; }
.lk.view-shop-categories .hk-rows-28 #option_24, .lk.view-shop-categories .hk-rows-28 #option_25, .lk.view-shop-categories .hk-rows-28 #option_26, .lk.view-shop-categories .hk-rows-28 #option_27 { width: 432px; }
.lk.view-shop-categories .hk-rows-29 #option_27, .lk.view-shop-categories .hk-rows-29 #option_28 { width: 432px; }
.lk.view-shop-categories .hk-rows-31 #option_27, .lk.view-shop-categories .hk-rows-31 #option_28, .lk.view-shop-categories .hk-rows-31 #option_29, .lk.view-shop-categories .hk-rows-31 #option_30 { width: 432px; }
.lk.view-shop-categories .hk-rows-32 #option_30, .lk.view-shop-categories .hk-rows-32 #option_31 { width: 432px; }
.lk.view-shop-categories .hk-rows-34 #option_30, .lk.view-shop-categories .hk-rows-34 #option_31, .lk.view-shop-categories .hk-rows-34 #option_32, .lk.view-shop-categories .hk-rows-34 #option_33 { width: 432px; }
.lk.view-shop-categories .hk-rows-35 #option_33, .lk.view-shop-categories .hk-rows-35 #option_34 { width: 432px; }
.lk.view-shop-categories .hk-rows-37 #option_33, .lk.view-shop-categories .hk-rows-37 #option_34, .lk.view-shop-categories .hk-rows-37 #option_35, .lk.view-shop-categories .hk-rows-37 #option_36 { width: 432px; }
.lk.view-shop-categories .hk-rows-38 #option_36, .lk.view-shop-categories .hk-rows-38 #option_37 { width: 432px; }
.lk.view-shop-categories .hk-rows-40 #option_36, .lk.view-shop-categories .hk-rows-40 #option_37, .lk.view-shop-categories .hk-rows-40 #option_38, .lk.view-shop-categories .hk-rows-40 #option_39 { width: 432px; }
.lk.view-shop-categories .hk-rows-41 #option_39, .lk.view-shop-categories .hk-rows-41 #option_40 { width: 432px; }
.lk.view-shop-categories .hk-rows-43 #option_39, .lk.view-shop-categories .hk-rows-43 #option_40, .lk.view-shop-categories .hk-rows-43 #option_41, .lk.view-shop-categories .hk-rows-43 #option_42 { width: 432px; }
.lk.view-shop-categories .hk-rows-44 #option_42, .lk.view-shop-categories .hk-rows-44 #option_43 { width: 432px; }
.lk.view-shop-categories .hk-rows-46 #option_42, .lk.view-shop-categories .hk-rows-46 #option_43, .lk.view-shop-categories .hk-rows-46 #option_44, .lk.view-shop-categories .hk-rows-46 #option_45 { width: 432px; }
.lk.view-shop-categories .hk-rows-47 #option_45, .lk.view-shop-categories .hk-rows-47 #option_46 { width: 432px; }

/* The tile cuts its art and mark at its edges. The rarity layer, under the art, lights it from behind and
   warms to the accent under the pointer; the shade, over it, rises from the foot so the words stay legible. */
.lk.view-shop-categories .lk-hit
{
	overflow: clip clip;
}

.lk.view-shop-categories .lk-rarity,
.lk.view-shop-categories .lk-rarity.hidden
{
	background-color: gradient( radial, 74% 44%, 0% 0%, 48% 64%, from( chudGlassSoft ), to( chudShadowFade ) );
	visibility: visible;
}

.lk.view-shop-categories .lk-hit:hover .lk-rarity
{
	background-color: gradient( radial, 74% 44%, 0% 0%, 48% 64%, from( chudAccentSoft ), to( chudAccentFade ) );
}

.lk.view-shop-categories .lk-shade
{
	background-color: gradient( linear, 0% 100%, 0% 40%, from( chudShadowDim ), to( chudShadowFade ) );
	visibility: visible;
}

/* A category whose items have no art: its icon as a large, faint mark, cut by the tile's right edge. */
.lk.view-shop-categories .lk-glyph
{
	width: 168px;
	height: 168px;
	horizontal-align: right;
	vertical-align: center;
	margin: 0px -34px 0px 0px;
	opacity: 0.14;
	wash-color: chudTextMain;
	transition-property: opacity;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk.view-shop-categories .hk-rows-4 .lk-glyph,
.lk.view-shop-categories .hk-rows-5 .lk-glyph,
.lk.view-shop-categories .hk-rows-6 .lk-glyph
{
	width: 236px;
	height: 236px;
	margin-right: -52px;
}

.lk.view-shop-categories .hk-rows-1 .lk-glyph,
.lk.view-shop-categories .hk-rows-2 .lk-glyph,
.lk.view-shop-categories .hk-rows-3 .lk-glyph
{
	width: 292px;
	height: 292px;
	margin-right: -64px;
}

.lk.view-shop-categories .lk-hit:hover .lk-glyph
{
	opacity: 0.3;
	wash-color: chudAccentStrong;
}

/* One with art: the item you have on, else its dearest, standing on the tile's foot. The box is the art's
   own 4:3 at 90% of the tile's height, pulled out past the right edge so the figure (13-90% of the frame
   in CS2's renders) ends there, and only the tile ever cuts it. */
.lk.view-shop-categories .lk-thumb
{
	width: 202px;
	height: 90%;
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px -20px 0px 0px;
	background-position: 50% 100%;
}

.lk.view-shop-categories .hk-rows-4 .lk-thumb,
.lk.view-shop-categories .hk-rows-5 .lk-thumb,
.lk.view-shop-categories .hk-rows-6 .lk-thumb
{
	width: 307px;
	margin-right: -31px;
}

.lk.view-shop-categories .hk-rows-1 .lk-thumb,
.lk.view-shop-categories .hk-rows-2 .lk-thumb,
.lk.view-shop-categories .hk-rows-3 .lk-thumb
{
	width: 384px;
	margin-right: -38px;
}
/* Top left, as plain words: the cheapest item left to buy, All owned, or in Inventory what runs out first. */
.lk.view-shop-categories .lk-tags
{
	horizontal-align: left;
	vertical-align: top;
	margin: 16px 0px 0px 18px;
}

.lk.view-shop-categories .lk-tag
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-size: 12px;
	letter-spacing: 1px;
}

.lk.view-shop-categories .lk-slot.has-tagglyph .lk-tag
{
	padding-left: 19px;
}

.lk.view-shop-categories .lk-tagglyph
{
	width: 14px;
	height: 14px;
	margin: 0px -14px 0px 0px;
}

/* Top right: a pill while something in the category is on. */
.lk.view-shop-categories .lk-note
{
	horizontal-align: right;
	vertical-align: top;
	margin: 13px 14px 0px 0px;
	padding: 3px 8px;
	border: 1px solid chudAccentDim;
	border-radius: 2px;
	background-color: chudAccentSoft;
	color: chudAccentStrong;
}

/* Bottom left: the name, large, and how many items it holds. */
.lk.view-shop-categories .lk-slot .lk-text
{
	width: 100%;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 0px 16px 0px;
	padding: 0px 18px;
}

.lk.view-shop-categories .lk-name
{
	font-family: chudFontBody;
	font-size: 22px;
	font-weight: bold;
	text-transform: uppercase;
	white-space: normal;
	text-overflow: clip;
	text-shadow: 1px 1px 4px 1.0 chudShadowText;
}

.lk.view-shop-categories .hk-rows-4 .lk-name,
.lk.view-shop-categories .hk-rows-5 .lk-name,
.lk.view-shop-categories .hk-rows-6 .lk-name
{
	font-size: 28px;
}

.lk.view-shop-categories .hk-rows-1 .lk-name,
.lk.view-shop-categories .hk-rows-2 .lk-name,
.lk.view-shop-categories .hk-rows-3 .lk-name
{
	font-size: 34px;
}

.lk.view-shop-categories .lk-sub
{
	margin-top: 2px;
	font-family: chudFontBody;
	font-size: 13px;
	color: chudTextMuted;
	letter-spacing: 0px;
	text-transform: none;
	text-shadow: 1px 1px 3px 1.0 chudShadowText;
}

/* Along the foot: how much of what can be owned you own, green once it is all of it. */
.lk.view-shop-categories .lk-meter
{
	width: 100%;
	height: 2px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px;
	border-radius: 0px;
	background-color: chudSurfaceEdge;
}

.lk.view-shop-categories .chud-meter__fill
{
	border-radius: 0px;
	background-color: chudAccentBase;
}

.lk.view-shop-categories .meter-good .chud-meter__fill
{
	background-color: chudSuccessBase;
}
/* ---- shop-grid: storefront cards, four to a line ---- */

/* right-wrap pushes an exactly-full line's last card down, so a line keeps slack that
   survives ui-scale rounding: 4 x (212 + 6) = 872 of the list's 882. */
.lk.view-shop-grid .lk-slot
{
	width: 212px;
	height: 240px;
	margin: 0px 6px 8px 0px;
}

.lk.view-shop-grid .lk-thumb
{
	width: 100%;
	height: 136px;
	vertical-align: top;
	margin: 0px;
	background-position: 50% 100%;
}

/* The team's light behind the art, read off the team tag's tone. */
.lk.view-shop-grid .tag-ct .lk-thumb { background-color: gradient( radial, 50% 100%, 0% 0%, 70% 70%, from( chudTeamCtSoft ), to( chudTeamCtFade ) ); }
.lk.view-shop-grid .tag-t .lk-thumb { background-color: gradient( radial, 50% 100%, 0% 0%, 70% 70%, from( chudTeamTSoft ), to( chudTeamTFade ) ); }
.lk.view-shop-grid .lk-slot.danger .lk-thumb { opacity: 0.55; }

.lk.view-shop-grid .lk-tags
{
	horizontal-align: left;
	vertical-align: top;
	margin: 8px 0px 0px 8px;
}

.lk.view-shop-grid .lk-tag,
.lk.view-shop-grid .lk-tag2
{
	margin: 0px 4px 0px 0px;
	padding: 2px 6px;
	border-radius: 2px;
	font-size: 9px;
}

.lk.view-shop-grid .lk-slot .lk-text
{
	width: 188px;
	vertical-align: top;
	margin: 146px 0px 0px 12px;
}

.lk.view-shop-grid .lk-name
{
	font-size: 15px;
}

.lk.view-shop-grid .lk-sub
{
	margin-top: 4px;
}

.lk.view-shop-grid .lk-glyph
{
	visibility: collapse;
}

.lk.view-shop-grid .has-glyph .lk-vglyph,
.lk.view-shop-grid .has-vglyph .lk-vglyph
{
	visibility: visible;
}

/* An item without a picture shows its icon in the picture's place: `vglyph=` carries the price's
   coin, which leaves `glyph=` free for the item. */
.lk.view-shop-grid .has-glyph.has-vglyph .lk-glyph
{
	visibility: visible;
	width: 64px;
	height: 64px;
	horizontal-align: center;
	vertical-align: top;
	margin: 36px 0px 0px 0px;
	wash-color: chudTextMuted;
}

.lk.view-shop-grid .has-vglyph.has-thumb .lk-glyph
{
	visibility: collapse;
}

.lk.view-shop-grid .lk-end
{
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 0px 10px 12px;
}

.lk.view-shop-grid .lk-value
{
	font-size: 18px;
}

.lk.view-shop-grid .lk-note
{
	vertical-align: bottom;
	margin: 0px 12px 13px 0px;
}

/* ---- shared by every shop view ---- */

/* Unaffordable reads in the price, not the name. */
.lk.view-shop-grid .lk-slot.danger .lk-name,
.lk.view-shop-list .lk-slot.danger .lk-name,
.lk.view-shop-product .lk-slot.danger .lk-name
{
	color: chudTextMain;
}

/* Bought already: the price is history. */
.lk.view-shop-grid .tone-faint .lk-value,
.lk.view-shop-list .tone-faint .lk-value
{
	font-size: 14px;
	text-decoration: line-through;
}

/* ---- shop-list: one category flattened into sections, a price per row ---- */

.lk.view-shop-list .lk-slot
{
	height: 40px;
}

.lk.view-shop-list .lk-slot .lk-text
{
	width: fit-children;
	margin-left: 46px;
	flow-children: right;
}

.lk.view-shop-list .lk-name
{
	width: 372px;
	vertical-align: center;
}

.lk.view-shop-list .lk-sub
{
	width: 110px;
	vertical-align: center;
	margin-top: 0px;
}

/* `tag=sells for N` is a quiet column here, not a pill. */
.lk.view-shop-list .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 528px;
}

.lk.view-shop-list .lk-tag,
.lk.view-shop-list .lk-tag2
{
	margin: 0px 10px 0px 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudTextFaint;
	letter-spacing: 1px;
}

.lk.view-shop-list .lk-note
{
	margin-right: 124px;
}

.lk.view-shop-list .lk-glyph
{
	visibility: collapse;
}

.lk.view-shop-list .has-glyph .lk-vglyph,
.lk.view-shop-list .has-vglyph .lk-vglyph
{
	visibility: visible;
}

/* With the coin in `vglyph=`, `glyph=` is the item's icon, in the left gutter. */
.lk.view-shop-list .has-glyph.has-vglyph .lk-glyph
{
	visibility: visible;
}

/* ---- shop-product: the art left; badges, price, facts and the actions right ---- */

.lk.view-shop-product .lk-col
{
	flow-children: none;
}

.lk.view-shop-product .lk-banner
{
	width: 430px;
	height: 100%;
}

/* A flowless column leaves the list's box no height to fill, so it takes the list's size. */
.lk.view-shop-product .lk-listbox
{
	width: 450px;
	height: 470px;
	horizontal-align: right;
}

.lk.view-shop-product .lk-list
{
	padding-right: 0px;
}

.lk.view-shop-product .lk-foot
{
	width: 450px;
	horizontal-align: right;
	vertical-align: bottom;
}

/* The showcase: one slot filling the banner, the art in a spotlight. */
.lk.view-shop-product .lk-banner .lk-slot
{
	width: 100%;
	height: 100%;
	margin: 0px;
}

.lk.view-shop-product .lk-banner .lk-hit,
.lk.view-shop-product .lk-banner .lk-hit:hover
{
	background-color: gradient( radial, 50% 78%, 0% 0%, 62% 52%, from( chudInfoDim ), to( chudTileDeep ) );
}

.lk.view-shop-product .lk-banner .lk-thumb
{
	width: 100%;
	height: 400px;
	vertical-align: bottom;
	margin: 0px 0px 96px 0px;
	background-position: 50% 100%;
}

/* An item without a picture: its icon, large, where the picture would stand. */
.lk.view-shop-product .lk-banner .lk-glyph
{
	width: 150px;
	height: 150px;
	horizontal-align: center;
	vertical-align: center;
	margin: 0px 0px 96px 0px;
	wash-color: chudTextMuted;
}

.lk.view-shop-product .lk-banner .lk-slot .lk-text
{
	width: 386px;
	horizontal-align: center;
	vertical-align: bottom;
	margin: 0px 0px 22px 0px;
	padding-top: 14px;
	border-top: 1px solid chudSurfaceEdge;
}

.lk.view-shop-product .lk-banner .lk-name
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 28px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

/* Badges: chips on one line, toned like the tag pills. */
.lk.view-shop-product .grp-badge
{
	width: fit-children;
	height: 26px;
	margin: 0px 6px 0px 0px;
}

.lk.view-shop-product .grp-badge .lk-text
{
	width: fit-children;
	margin: 0px;
}

.lk.view-shop-product .grp-badge .lk-name
{
	width: fit-children;
	font-size: 11px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-shop-product .grp-badge.tone-info .lk-hit { border: 1px solid chudInfoDim; background-color: chudInfoSoft; }
.lk.view-shop-product .grp-badge.tone-info .lk-name { color: chudInfoStrong; }
.lk.view-shop-product .grp-badge.tone-ct .lk-hit { border: 1px solid chudTeamCtDim; background-color: chudTeamCtSoft; }
.lk.view-shop-product .grp-badge.tone-ct .lk-name { color: chudTeamCtStrong; }
.lk.view-shop-product .grp-badge.tone-t .lk-hit { border: 1px solid chudTeamTDim; background-color: chudTeamTSoft; }
.lk.view-shop-product .grp-badge.tone-t .lk-name { color: chudTeamTStrong; }

/* The price box: the price as the name, its currency before it, the balance after buying below. */
.lk.view-shop-product .grp-price
{
	width: 100%;
	height: 132px;
	margin: 14px 0px 12px 0px;
}

.lk.view-shop-product .grp-price .lk-text
{
	width: 400px;
	vertical-align: top;
	margin: 18px 0px 0px 20px;
}

.lk.view-shop-product .grp-price .lk-type
{
	font-size: 11px;
	color: chudTextMuted;
	letter-spacing: 3px;
}

.lk.view-shop-product .grp-price .lk-name
{
	margin: 4px 0px 0px 42px;
	font-family: chudDigitsBold;
	font-size: 44px;
	color: chudGoldBase;
}

.lk.view-shop-product .grp-price .lk-sub
{
	margin-top: 6px;
	font-size: 13px;
	letter-spacing: 1px;
}

.lk.view-shop-product .grp-price .lk-glyph
{
	width: 30px;
	height: 30px;
	vertical-align: top;
	margin: 52px 0px 0px 20px;
	wash-color: chudGoldBase;
}

/* Facts: a label column and its value. */
.lk.view-shop-product .grp-fact
{
	height: 38px;
}

.lk.view-shop-product .grp-fact .lk-text
{
	width: 150px;
}

.lk.view-shop-product .grp-fact .lk-name
{
	font-size: 12px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-shop-product .grp-fact .lk-end
{
	horizontal-align: left;
	margin: 0px 0px 0px 164px;
}

.lk.view-shop-product .grp-fact .lk-value
{
	font-family: chudFontMedium;
	font-size: 14px;
	color: chudTextMain;
}

.lk.view-shop-product .grp-fact.tone-good .lk-value { color: chudSuccessBase; }
.lk.view-shop-product .grp-fact.tone-bad .lk-value { color: chudDangerBase; }

/* The actions: a secondary button and the primary filling the rest. Wide enough for ShopCore's
   own "Preview item". */
.lk.view-shop-product .lk-foot .lk-slot
{
	width: 174px;
	height: 46px;
	margin: 0px;
}

.lk.view-shop-product .lk-foot .lk-slot.primary
{
	width: fill-parent-flow( 1.0 );
	margin-left: 10px;
}

.lk.view-shop-product .lk-foot .lk-slot .lk-text
{
	width: fit-children;
	margin-left: 46px;
}

.lk.view-shop-product .lk-foot .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-shop-product .lk-foot .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 20px;
	wash-color: chudTextMain;
}

/* The primary's label ends left of centre and its price starts right of it, so the
   pair stays centred around the rule between them whatever the price's width. */
.lk.view-shop-product .lk-foot .primary .lk-text
{
	horizontal-align: right;
	margin: 0px 52% 0px 0px;
}

.lk.view-shop-product .lk-foot .primary .lk-glyph
{
	visibility: collapse;
}

.lk.view-shop-product .lk-foot .primary .lk-end
{
	horizontal-align: left;
	margin: 0px 0px 0px 50%;
	padding-left: 14px;
	border-left: 1px solid chudAccentDim;
}

.lk.view-shop-product .lk-foot .primary.has-glyph .lk-vglyph
{
	visibility: visible;
}

.lk.view-shop-product .lk-foot .lk-value
{
	font-size: 15px;
	letter-spacing: 1px;
}

/* ---- shop-inventory: what the player owns, with time left and a sell button ---- */

.lk.view-shop-inventory .lk-slot
{
	height: 66px;
	margin-bottom: 6px;
}

/* The rarity layer sits under every other part, so it doubles as the media box. */
.lk.view-shop-inventory .lk-rarity,
.lk.view-shop-inventory .lk-rarity.hidden
{
	width: 86px;
	height: 52px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 8px;
	border-radius: 3px;
	background-color: chudTileDeep;
	visibility: visible;
}

.lk.view-shop-inventory .lk-glyph
{
	width: 30px;
	height: 30px;
	margin-left: 36px;
}

.lk.view-shop-inventory .lk-thumb
{
	width: 86px;
	height: 52px;
	margin-left: 8px;
}

/* A tracer's colour as a streak across the box. */
.lk.view-shop-inventory .lk-swatch
{
	width: 66px;
	height: 4px;
	margin-left: 18px;
	border: 0px solid transparent;
	border-radius: 2px;
	transform: rotateZ( -18deg );
}

.lk.view-shop-inventory .lk-slot .lk-text
{
	width: 240px;
	margin-left: 108px;
}

.lk.view-shop-inventory .lk-name
{
	font-size: 15px;
}

.lk.view-shop-inventory .lk-sub
{
	margin-top: 3px;
}

.lk.view-shop-inventory .lk-switch
{
	horizontal-align: left;
	margin: 0px 0px 0px 360px;
}

/* The toggle's state reads beside its switch. */
.lk.view-shop-inventory .lk-slot.kind-toggle .lk-value
{
	visibility: visible;
}

.lk.view-shop-inventory .lk-slot.kind-toggle .lk-end
{
	horizontal-align: left;
	margin: 0px 0px 0px 404px;
}

.lk.view-shop-inventory .lk-slot.kind-toggle.is-on .lk-value
{
	color: chudAccentStrong;
}

/* A row that opens the item's page has no switch, so its state reads in the switch's column. */
.lk.view-shop-inventory .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 360px;
}

.lk.view-shop-inventory .lk-meter
{
	width: 220px;
	height: 5px;
	horizontal-align: left;
	vertical-align: top;
	margin: 21px 0px 0px 496px;
	border-radius: 3px;
}

.lk.view-shop-inventory .lk-note
{
	horizontal-align: left;
	margin: 0px 0px 0px 496px;
	font-size: 11px;
	letter-spacing: 1px;
}

.lk.view-shop-inventory .lk-slot.has-bar .lk-note
{
	vertical-align: top;
	margin-top: 32px;
}

.lk.view-shop-inventory .lk-inline
{
	width: 136px;
}

.lk.view-shop-inventory .lk-inline__label
{
	width: fill-parent-flow( 1.0 );
}

.lk.view-shop-inventory .inline-disabled .lk-inline__label
{
	text-align: right;
}
