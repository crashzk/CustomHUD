/*
	WeaponSkins locker: sidebar + five-column card grid that scrolls past three
	rows. Overrides .chud-tile from
	menu_mouse.vcss, so it must be included after it. Cards keep that rule's
	flow-children: none -- every child is placed by margin from the card top.
*/

.ws-locker
{
	width: 1140px;
	padding: 16px;
	/* Panorama draws every side of a panel in one colour, so the frame is all accent. */
	border-top: 2px solid chudAccentBase;
	border-right: 1px solid chudAccentBase;
	border-bottom: 1px solid chudAccentBase;
	border-left: 1px solid chudAccentBase;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudSurfaceRaised ), to( chudSurfaceDeep ) );
}

.ws-header
{
	width: 100%;
	height: 56px;
	flow-children: down;
}

.ws-heading
{
	width: 100%;
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 26px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* Three visible card rows of 192px (184px card + 2 x 4px margin). Placed by alignment, not
   flow, so the tab strip can take the top of the grid's column: the grid and the card view sit
   right-aligned beside the sidebar, exactly where flowing them would put them. */
.ws-content
{
	width: 100%;
	height: 576px;
	flow-children: none;
}

/* 5 x 176px (card width + 2 x 4px margin) = 880px, plus the 16px scrollbar gutter. */
.ws-grid
{
	width: 896px;
	height: 100%;
	horizontal-align: right;
	vertical-align: bottom;
	overflow: clip scroll;
}

/* The strip's 30px and its 12px gap. A scroll panel needs a fixed height, so no fill. */
.ws-locker.has-tabs .ws-grid
{
	height: 534px;
}

.ws-grid__items
{
	width: 880px;
	flow-children: down;
}

/* The scroll rewind, as .chud-locker__items in menu_mouse.vcss. */
.ws-locker.chud-rewind .ws-grid__items
{
	height: 1px;
	overflow: squish noclip;
}

/* Five cards per line panel, for the reason given at .chud-locker__line in menu_mouse.vcss. */
.ws-line
{
	width: 100%;
	flow-children: right;
}

/* ---- tabs: Weapon Skins' categories (MenuTabsProfile) ---- */

.ws-tabs
{
	width: 896px;
	height: 30px;
	horizontal-align: right;
	flow-children: right;
}

.ws-tabs.hidden
{
	visibility: collapse;
}

.ws-tab
{
	height: 30px;
	margin-right: 6px;
	padding: 0px 14px;
	flow-children: right;
	border: 1px solid chudSurfaceEdge;
	border-radius: 3px;
	background-color: chudSurfaceRow;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.ws-tab.hidden
{
	visibility: collapse;
}

.ws-tab:hover
{
	border: 1px solid chudAccentBase;
	background-color: chudSurfaceHover;
}

/* The open category takes the Chosen look of the locker's tabs, its label in the accent. */
.ws-tab.selected,
.ws-tab.selected:hover
{
	border: 1px solid chudAccentBase;
	background-color: chudAccentSoft;
}

.ws-tab.disabled
{
	opacity: 0.35;
}

.ws-tab__label
{
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
}

.ws-tab:hover .ws-tab__label { color: chudTextMain; }
.ws-tab.selected .ws-tab__label { color: chudAccentStrong; }

.ws-tab__count
{
	vertical-align: center;
	margin-left: 8px;
	font-family: chudDigitsBold;
	font-size: 11px;
	color: chudTextFaint;
	visibility: collapse;
}

.ws-tab.has-count .ws-tab__count
{
	visibility: visible;
}

.ws-card
{
	width: 168px;
	height: 184px;
	margin: 4px;
}

/* chosen: the item the player has on now. Twice the hover edge, so the two never read alike. */

/* Rarity rises from the card's foot instead of underlining it. */
.ws-card .chud-tile__rarity
{
	border-bottom: 0px solid transparent;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint01 ) );
}

.ws-card .chud-tile__rarity.lvl-1 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint01 ) ); }
.ws-card .chud-tile__rarity.lvl-2 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint02 ) ); }
.ws-card .chud-tile__rarity.lvl-3 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint03 ) ); }
.ws-card .chud-tile__rarity.lvl-4 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint04 ) ); }
.ws-card .chud-tile__rarity.lvl-5 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint05 ) ); }
.ws-card .chud-tile__rarity.lvl-6 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint06 ) ); }
.ws-card .chud-tile__rarity.lvl-7 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint07 ) ); }
.ws-card .chud-tile__rarity.lvl-8 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint08 ) ); }
.ws-card .chud-tile__rarity.lvl-9 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint09 ) ); }
.ws-card .chud-tile__rarity.lvl-10 { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.4, transparent ), to( chudTint10 ) ); }

.ws-card__bar
{
	width: 72px;
	height: 2px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 116px;
	background-color: chudRarity01;
}

/* Crisp, never glowing: Panorama draws a box-shadow blur round a 2px line as a thick halo. */
.chud-tile__rarity.lvl-1 .ws-card__bar { background-color: chudRarity01; }
.chud-tile__rarity.lvl-2 .ws-card__bar { background-color: chudRarity02; }
.chud-tile__rarity.lvl-3 .ws-card__bar { background-color: chudRarity03; }
.chud-tile__rarity.lvl-4 .ws-card__bar { background-color: chudRarity04; }
.chud-tile__rarity.lvl-5 .ws-card__bar { background-color: chudRarity05; }
.chud-tile__rarity.lvl-6 .ws-card__bar { background-color: chudRarity06; }
.chud-tile__rarity.lvl-7 .ws-card__bar { background-color: chudRarity07; }
.chud-tile__rarity.lvl-8 .ws-card__bar { background-color: chudRarity08; }
.chud-tile__rarity.lvl-9 .ws-card__bar { background-color: chudRarity09; }
.chud-tile__rarity.lvl-10 .ws-card__bar { background-color: chudRarity10; }

/* The bar sits under the image, so a card without one has nothing to underline. */
.ws-card .ws-card__bar
{
	visibility: collapse;
}

.ws-card.has-thumb .ws-card__bar
{
	visibility: visible;
}

/* The image itself comes from an econ-* class in econ_thumbs.vcss. */
.ws-card__thumb
{
	width: 152px;
	height: 104px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 8px;
	background-size: contain;
	background-position: 50% 50%;
	background-repeat: no-repeat;
	transform: scale3d( 1, 1, 1 );
	transition-property: transform;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.ws-card:hover .ws-card__thumb
{
	transform: scale3d( 1.06, 1.06, 1 );
}

.ws-card__thumb.hidden
{
	visibility: collapse;
}

/* tint=spray-N: the game ships graffiti art untinted and washes it in the chosen colour. */
.ws-card__thumb.tint-spray-1 { wash-color: chudSprayTint01; }
.ws-card__thumb.tint-spray-2 { wash-color: chudSprayTint02; }
.ws-card__thumb.tint-spray-3 { wash-color: chudSprayTint03; }
.ws-card__thumb.tint-spray-4 { wash-color: chudSprayTint04; }
.ws-card__thumb.tint-spray-5 { wash-color: chudSprayTint05; }
.ws-card__thumb.tint-spray-6 { wash-color: chudSprayTint06; }
.ws-card__thumb.tint-spray-7 { wash-color: chudSprayTint07; }
.ws-card__thumb.tint-spray-8 { wash-color: chudSprayTint08; }
.ws-card__thumb.tint-spray-9 { wash-color: chudSprayTint09; }
.ws-card__thumb.tint-spray-10 { wash-color: chudSprayTint10; }
.ws-card__thumb.tint-spray-11 { wash-color: chudSprayTint11; }
.ws-card__thumb.tint-spray-12 { wash-color: chudSprayTint12; }
.ws-card__thumb.tint-spray-13 { wash-color: chudSprayTint13; }
.ws-card__thumb.tint-spray-14 { wash-color: chudSprayTint14; }
.ws-card__thumb.tint-spray-15 { wash-color: chudSprayTint15; }
.ws-card__thumb.tint-spray-16 { wash-color: chudSprayTint16; }
.ws-card__thumb.tint-spray-17 { wash-color: chudSprayTint17; }
.ws-card__thumb.tint-spray-18 { wash-color: chudSprayTint18; }
.ws-card__thumb.tint-spray-19 { wash-color: chudSprayTint19; }

.ws-card__type
{
	width: 154px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 124px;
	font-family: chudFontMedium;
	font-size: 15px;
	color: chudTextMain;
	text-align: center;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.ws-card.has-type .ws-card__type
{
	visibility: visible;
}

/* Without an image the card is a plain action (Reset, a property toggle): centre the name. */
.ws-card__name
{
	width: 150px;
	max-height: 72px;
	horizontal-align: center;
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 16px;
	color: chudTextMain;
	text-align: center;
	white-space: normal;
	text-overflow: ellipsis;
}

/* With an image the name takes the type's slot unless a type label is present. */
.ws-card.has-thumb .ws-card__name
{
	width: 154px;
	max-height: 20px;
	vertical-align: top;
	margin-top: 124px;
	font-size: 15px;
	white-space: nowrap;
}

.ws-card.has-thumb.has-type .ws-card__name
{
	max-height: 15px;
	margin-top: 145px;
	font-family: chudFontBody;
	font-size: 11px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.ws-card.danger .ws-card__name
{
	color: chudDangerBase;
}

.ws-card__value
{
	width: 154px;
	horizontal-align: center;
	vertical-align: bottom;
	margin-bottom: 8px;
	font-family: chudFontMedium;
	font-size: 13px;
	color: chudGoldBase;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* An image card keeps the value small: name and type already fill its foot. */
.ws-card.has-thumb .ws-card__value
{
	margin-bottom: 5px;
	font-size: 10px;
}

/* A PageTiles card: the arrow over the page it leads to. */
.ws-card.page-tile .ws-card__name
{
	font-size: 44px;
	color: chudAccentBase;
}

/* Card mode (MenuLayoutProfile.Card). Why the track is 51 overlapping segments, widest
   first: docs/PanoramaAuthoring.md, "Card layouts". */
.ws-cardview
{
	width: 896px;
	height: 100%;
	horizontal-align: right;
	visibility: collapse;
}

.ws-locker.card-mode .ws-cardview
{
	visibility: visible;
}

.ws-locker.card-mode .ws-grid
{
	visibility: collapse;
}

.ws-inspect
{
	width: 668px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: center;
	padding: 16px;
	flow-children: down;
	border-top: 1px solid chudSurfaceEdge;
	border-right: 1px solid chudSurfaceEdge;
	border-bottom: 1px solid chudSurfaceEdge;
	border-left: 1px solid chudSurfaceEdge;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudTileBase ), to( chudTileDeep ) );
}

.ws-hero
{
	width: 100%;
	height: 212px;
	flow-children: none;
	border-radius: 4px;
	background-color: chudTileDeep;
}

.ws-hero.hidden
{
	visibility: collapse;
}

.ws-hero__glow
{
	width: 100%;
	height: 100%;
	border-radius: 4px;
}

.ws-hero__thumb
{
	width: 618px;
	height: 148px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 8px;
	background-size: contain;
	background-position: 50% 50%;
	background-repeat: no-repeat;
}

.ws-hero__thumb.hidden
{
	visibility: collapse;
}

/* Crisp like the card bars: a box-shadow blur round a 2px line draws as a halo in-game. */
.ws-hero__bar
{
	width: 96px;
	height: 2px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 162px;
	visibility: collapse;
}

.ws-hero__rarity
{
	width: 618px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 170px;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudTextMuted;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.ws-hero.has-type .ws-hero__rarity
{
	visibility: visible;
}

.ws-hero__name
{
	width: 618px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 172px;
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
	color: chudTextMain;
	text-align: center;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.ws-hero.has-type .ws-hero__name
{
	margin-top: 186px;
}

.ws-fields
{
	width: 100%;
	margin-top: 12px;
	flow-children: down;
}

.ws-field
{
	width: 100%;
	margin-bottom: 6px;
	flow-children: down;
}

.ws-field.hidden
{
	visibility: collapse;
}

.ws-field.disabled
{
	opacity: 0.4;
}

.ws-field__row
{
	width: 100%;
	height: 32px;
	flow-children: right;
}

.ws-field__hit
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	padding: 0px 8px 0px 10px;
	flow-children: right;
	border-left: 2px solid transparent;
	border-radius: 3px;
	background-color: chudSurfaceRow;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.ws-field__hit:hover,
.ws-field.selected .ws-field__hit
{
	border-left: 2px solid chudAccentBase;
	background-color: chudSurfaceHover;
}

/* A plain line (a notice) is no control. */
.ws-field.kind-text .ws-field__hit,
.ws-field.kind-text .ws-field__hit:hover
{
	border-left: 2px solid transparent;
	background-color: transparent;
}

.ws-field__label
{
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* A value row's labels form one column, so its boxes line up whatever sits beside them. */
.ws-field.kind-input .ws-field__label,
.ws-field.kind-choice .ws-field__label,
.ws-field.kind-selector .ws-field__label,
.ws-field.kind-slider .ws-field__label
{
	width: 256px;
}

.ws-field__hit:hover .ws-field__label
{
	color: chudTextMain;
}

.ws-field.danger .ws-field__label
{
	color: chudDangerBase;
}

.ws-field__box
{
	width: fill-parent-flow( 1.0 );
	height: 22px;
	vertical-align: center;
	padding: 0px 8px;
	border-top: 1px solid chudSurfaceEdge;
	border-right: 1px solid chudSurfaceEdge;
	border-bottom: 1px solid chudSurfaceEdge;
	border-left: 1px solid chudSurfaceEdge;
	border-radius: 3px;
	background-color: chudTileDeep;
	visibility: collapse;
}

.ws-field.kind-input .ws-field__box,
.ws-field.kind-choice .ws-field__box,
.ws-field.kind-selector .ws-field__box,
.ws-field.kind-slider .ws-field__box
{
	visibility: visible;
}

.ws-field__hit:hover .ws-field__box
{
	border-top: 1px solid chudAccentBase;
	border-right: 1px solid chudAccentBase;
	border-bottom: 1px solid chudAccentBase;
	border-left: 1px solid chudAccentBase;
}

/* An inline switch qualifies the value beside it: off, the value is dimmed. */
.ws-field.aside-toggle .ws-field__box
{
	opacity: 0.45;
}

.ws-field.aside-toggle.aside-on .ws-field__box
{
	opacity: 1;
}

.ws-field__value
{
	width: 100%;
	vertical-align: center;
	font-family: chudFontBody;
	font-size: 13px;
	color: chudTextMain;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.ws-field__chevron
{
	vertical-align: center;
	margin-left: 6px;
	font-family: chudFontMedium;
	font-size: 18px;
	color: chudTextFaint;
	visibility: collapse;
}

.ws-field.kind-action .ws-field__chevron
{
	visibility: visible;
}

.ws-field__hit:hover .ws-field__chevron
{
	color: chudAccentBase;
}

.ws-switch
{
	width: 34px;
	height: 18px;
	horizontal-align: center;
	vertical-align: center;
	border-radius: 9px;
	background-color: chudSurfaceEdge;
	visibility: collapse;
	transition-property: background-color;
	transition-duration: 0.12s;
}

.ws-switch__knob
{
	width: 14px;
	height: 14px;
	vertical-align: center;
	margin-left: 2px;
	border-radius: 7px;
	background-color: chudTextFaint;
	transform: translateX( 0px );
	transition-property: transform, background-color;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.ws-field.kind-toggle .ws-field__hit .ws-switch,
.ws-field.aside-toggle .ws-field__aside .ws-switch
{
	visibility: visible;
}

.ws-field.kind-toggle.is-on .ws-field__hit .ws-switch,
.ws-field.aside-on .ws-field__aside .ws-switch
{
	background-color: chudAccentDim;
}

.ws-field.kind-toggle.is-on .ws-field__hit .ws-switch__knob,
.ws-field.aside-on .ws-field__aside .ws-switch__knob
{
	background-color: chudAccentBase;
	transform: translateX( 16px );
}

.ws-field__aside
{
	width: 46px;
	height: 100%;
	margin-left: 6px;
	flow-children: none;
	border-radius: 3px;
	background-color: chudSurfaceRow;
	visibility: collapse;
	transition-property: background-color;
	transition-duration: 0.12s;
}

.ws-field.aside-toggle .ws-field__aside,
.ws-field.aside-action .ws-field__aside
{
	visibility: visible;
}

.ws-field__aside:hover
{
	background-color: chudSurfaceHover;
}

.ws-field__clear
{
	horizontal-align: center;
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 18px;
	color: chudTextMuted;
	visibility: collapse;
}

.ws-field.aside-action .ws-field__clear
{
	visibility: visible;
}

.ws-field.aside-action .ws-field__aside:hover
{
	background-color: chudDangerSoft;
}

.ws-field.aside-action .ws-field__aside:hover .ws-field__clear
{
	color: chudDangerBase;
}

.ws-track
{
	width: 100%;
	height: 20px;
	margin-top: 4px;
	flow-children: none;
	visibility: collapse;
}

.ws-field.has-track .ws-track
{
	visibility: visible;
}

.ws-track__base
{
	width: 100%;
	height: 8px;
	vertical-align: center;
	flow-children: right;
	border-radius: 4px;
	background-color: chudSurfaceRow;
}

/* fill-N sets the width; noclip lets the knob sit on the edge at 0%. */
.ws-track__fill
{
	width: 0%;
	height: 100%;
	flow-children: none;
	overflow: noclip;
}

.ws-track__clip
{
	width: 100%;
	height: 8px;
	vertical-align: center;
	overflow: clip;
	border-radius: 4px 0px 0px 4px;
}

/* Fixed to the track's width so the clip shows its left part, not a squeezed copy. */
.ws-track__lit
{
	width: 634px;
	height: 100%;
	flow-children: right;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentDim ), to( chudAccentBase ) );
}

.ws-track__knob
{
	width: 4px;
	height: 18px;
	horizontal-align: right;
	vertical-align: center;
	border-radius: 2px;
	background-color: chudTextMain;
	transform: translateX( 2px );
}

.ws-track__hits
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.ws-seg
{
	height: 100%;
	border-radius: 4px;
}

.ws-seg:hover
{
	background-color: chudGlassDim;
}

.ws-band
{
	height: 100%;
	visibility: collapse;
}

.ws-field.track-wear .ws-band
{
	visibility: visible;
}

.ws-track__legend
{
	width: 100%;
	height: 12px;
	margin-top: 1px;
	flow-children: right;
	visibility: collapse;
}

.ws-field.has-track.track-wear .ws-track__legend
{
	visibility: visible;
}

.ws-legend
{
	height: 100%;
	font-family: chudFontMedium;
	font-size: 9px;
	text-align: center;
	letter-spacing: 1px;
}

.ws-hero.lvl-1 .ws-hero__glow { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.35, transparent ), to( chudTint01 ) ); }
.ws-hero.lvl-2 .ws-hero__glow { background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.35, transparent ), to( chudTint02 ) ); }
