/*
	menu_list (Wasd, Buttons, Numbers) and menu_list_mouse (Mouse): the list every menu
	without a page of its own draws in, docked at the left edge. Its rows reuse the page
	locker's part classes (lk-text, lk-tags, lk-mark ...), so locker.vcss styles their
	content; this sheet lays each row out as one flowing line, the text taking whatever
	the right side leaves. Rows are sized by what they hold: 36px, 52px with art or a
	second line, 62px with a badge and a sub, 44px a ballot's answer or a meter, 24px a heading.
*/

/* ---- the panel ---- */

.ls
{
	width: 460px;
	height: fit-children;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 56px;
	padding: 12px 14px 10px 14px;
	flow-children: down;
	/* Panorama draws every side of a panel in one colour, so the accent edge is the only border. */
	border-left: 3px solid chudAccentBase;
	border-radius: 0px 6px 6px 0px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudSurfaceRaised ), to( chudSurfaceDeep ) );
	box-shadow: fill chudShadowDim 0px 8px 20px 0px;
	opacity: 1;
	transform: translateX( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.18s;
	transition-timing-function: ease-in-out;
}

.ls.hidden
{
	opacity: 0;
	transform: translateX( -12px );
}

.ls.hk-scale-80 { ui-scale: 80%; }
.ls.hk-scale-90 { ui-scale: 90%; }
.ls.hk-scale-100 { ui-scale: 100%; }
.ls.hk-scale-110 { ui-scale: 110%; }
.ls.hk-scale-125 { ui-scale: 125%; }
.ls.hk-scale-150 { ui-scale: 150%; }

/* ---- header: the path and the chips on one line, the title under them ---- */

.ls-head
{
	width: 100%;
	flow-children: down;
}

/* The path and chips line takes room only with something on it: a general menu's root has neither,
   and an empty line was a band of space over its title. The gap to the title goes with it. */
.ls-top
{
	width: 100%;
	height: 22px;
	margin-bottom: 4px;
	flow-children: right;
	visibility: collapse;
}

.ls-head.has-eyebrow .ls-top,
.ls-head.has-crumb .ls-top,
.ls.has-chips .ls-top
{
	visibility: visible;
}

.ls-path
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
}

.ls-eyebrow,
.ls-crumb
{
	max-width: 200px;
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 3px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.ls-crumb-sep
{
	vertical-align: center;
	margin: 0px 6px;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudTextFaint;
}

.ls-crumb,
.ls-crumb-sep
{
	visibility: collapse;
}

.ls-head.has-crumb .ls-crumb,
.ls-head.has-crumb .ls-crumb-sep
{
	visibility: visible;
}

.ls-title
{
	width: 100%;
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* Chips: the locker's, at the list's size. Their colours stay locker.vcss's. */
.ls-chips
{
	height: 22px;
	margin-left: 10px;
}

.ls .lk-chip
{
	height: 22px;
	margin-left: 6px;
	padding: 0px 8px 0px 7px;
	border-radius: 3px;
}

.ls .lk-chip__glyph
{
	width: 12px;
	height: 12px;
	margin-right: 6px;
}

.ls .lk-chip__value
{
	font-size: 13px;
}

.ls .lk-chip__label
{
	margin-left: 5px;
	font-size: 9px;
	letter-spacing: 1.5px;
}

/* Three classes, so the row picture's size and tile further down never reach a chip. */
.ls .lk-chip .lk-chip__thumb
{
	width: 40px;
	height: 16px;
	margin: 0px 6px 0px 0px;
	border-radius: 0px;
	background-color: transparent;
}

.ls-divider
{
	width: 100%;
	height: 1px;
	margin: 10px 0px 8px 0px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentBase ), color-stop( 0.4, chudSurfaceEdge ), to( chudSurfaceFade ) );
}

/* ---- the rows ---- */

.ls-list
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.ls-items
{
	width: 100%;
	flow-children: down;
}

/* The row's ground is the slot, so a poll's share (ls-fill) can lie between it and the line. */
.ls .ls-row
{
	width: 100%;
	height: 36px;
	margin-bottom: 3px;
	border-radius: 0px 3px 3px 0px;
	background-color: chudSurfaceRow;
}

.ls .ls-row.has-sub,
.ls .ls-row.has-badge,
.ls .ls-row.has-thumb,
.ls .ls-row.has-mark
{
	height: 52px;
}

.ls .ls-row.kind-progress
{
	height: 44px;
}

/* A fact the cursor skips, and a meter, sit on the panel itself. */
.ls .ls-row.kind-text,
.ls .ls-row.kind-progress
{
	background-color: transparent;
}

.ls .ls-hit,
.ls .ls-hit:hover
{
	width: 100%;
	height: 100%;
	padding-right: 12px;
	flow-children: right;
	border-left: 0px solid transparent;
	border-radius: 0px 3px 3px 0px;
	background-color: transparent;
}

/* The cursor's row (Wasd and Buttons): an accent edge and a glow fading into the row's
   ground, which lies underneath with a poll's share, so neither is covered. */
.ls-edge
{
	width: 3px;
	height: 100%;
}

.ls .selected .ls-edge
{
	background-color: chudAccentBase;
}

.ls .selected .ls-hit,
.ls .selected .ls-hit:hover
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentDim ), color-stop( 0.55, chudAccentSoft ), to( chudAccentFade ) );
}

.ls .selected.danger .ls-edge
{
	background-color: chudDangerBase;
}

.ls .selected.danger .ls-hit,
.ls .selected.danger .ls-hit:hover
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerDim ), color-stop( 0.55, chudDangerSoft ), to( chudDangerFade ) );
}

/* The key: Wasd and Buttons show the item's number faintly, Numbers the key as a keycap. */
.ls-key
{
	width: 30px;
	vertical-align: center;
	font-family: chudDigitsBold;
	font-size: 11px;
	color: chudTextFaint;
	text-align: center;
}

.ls .selected .ls-key
{
	color: chudAccentStrong;
}

.ls.mode-numbers .ls-key
{
	width: 22px;
	height: 22px;
	margin: 0px 9px 0px 6px;
	padding-top: 4px;
	border: 1px solid chudGlassDim;
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudGlassSoft ), to( chudGlassWash ) );
	font-size: 12px;
	color: chudTextMain;
	opacity: 0;
}

.ls.mode-numbers .has-key .ls-key
{
	opacity: 1;
}

/* A heading starts at the panel's edge; it holds no key. */
.ls .section .ls-key
{
	visibility: collapse;
}

/* ---- leading art: an icon, a render, an avatar, a rank badge ---- */

.ls-art
{
	width: fit-children;
	height: fit-children;
	vertical-align: center;
	flow-children: none;
}

.ls .lk-glyph
{
	width: 18px;
	height: 18px;
	margin: 0px 11px 0px 0px;
}

.ls .selected .lk-glyph { wash-color: chudAccentStrong; }
.ls .danger .lk-glyph { wash-color: chudDangerStrong; }
.ls .tone-ct .lk-glyph { wash-color: chudTeamCtBase; }
.ls .tone-t .lk-glyph { wash-color: chudTeamTBase; }

/* A team's emblem stands as tall as an avatar. */
.ls .tone-ct.has-sub .lk-glyph,
.ls .tone-t.has-sub .lk-glyph
{
	width: 26px;
	height: 26px;
}

/* With a render the row's icon moves to its value (a price's coin). */
.ls .has-thumb .lk-glyph
{
	visibility: collapse;
}

.ls .has-thumb.has-glyph.has-value .lk-vglyph
{
	visibility: visible;
}

/* A render on its rarity's glow (the rarity layer under it). */
.ls .lk-rarity,
.ls .lk-thumb
{
	width: 60px;
	height: 40px;
	margin: 0px 12px 0px 0px;
	border-radius: 3px;
}

.ls .lk-thumb
{
	background-color: chudTileDeep;
}

.ls .has-thumb .lk-rarity
{
	visibility: visible;
}

.ls .lk-rarity.lvl-1 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint01 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-2 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint02 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-3 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint03 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-4 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint04 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-5 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint05 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-6 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint06 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-7 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint07 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-8 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint08 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-9 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint09 ), to( chudTileDeep ) ); }
.ls .lk-rarity.lvl-10 { background-color: gradient( radial, 50% 100%, 0% 0%, 60% 80%, from( chudTint10 ), to( chudTileDeep ) ); }

/* The rarity layer glows; the render over it must not hide the glow. */
.ls .has-thumb.rarity-1 .lk-thumb, .ls .has-thumb.rarity-2 .lk-thumb, .ls .has-thumb.rarity-3 .lk-thumb,
.ls .has-thumb.rarity-4 .lk-thumb, .ls .has-thumb.rarity-5 .lk-thumb, .ls .has-thumb.rarity-6 .lk-thumb,
.ls .has-thumb.rarity-7 .lk-thumb, .ls .has-thumb.rarity-8 .lk-thumb, .ls .has-thumb.rarity-9 .lk-thumb,
.ls .has-thumb.rarity-10 .lk-thumb
{
	background-color: transparent;
}

/* A rank emblem has its own outline; the tile is for renders. Every rank image comes with a tier tone. */
.ls .has-thumb.tone-r1 .lk-thumb, .ls .has-thumb.tone-r2 .lk-thumb, .ls .has-thumb.tone-r3 .lk-thumb,
.ls .has-thumb.tone-r4 .lk-thumb, .ls .has-thumb.tone-r5 .lk-thumb, .ls .has-thumb.tone-r6 .lk-thumb,
.ls .has-thumb.tone-r7 .lk-thumb, .ls .has-thumb.tone-l1 .lk-thumb, .ls .has-thumb.tone-l2 .lk-thumb,
.ls .has-thumb.tone-l4 .lk-thumb, .ls .has-thumb.tone-l8 .lk-thumb, .ls .has-thumb.tone-l10 .lk-thumb
{
	background-color: transparent;
}

/* Rasterized at the size drawn, as in locker.vcss; a chip's rules come last, since it matches the row's too. */
.ls .has-thumb.tone-r1 .lk-thumb, .ls .has-thumb.tone-r2 .lk-thumb, .ls .has-thumb.tone-r3 .lk-thumb, .ls .has-thumb.tone-r4 .lk-thumb,
.ls .has-thumb.tone-r5 .lk-thumb, .ls .has-thumb.tone-r6 .lk-thumb, .ls .has-thumb.tone-r7 .lk-thumb
{
	background-texture-size: 60px 24px;
}

.ls .has-thumb.tone-l1 .lk-thumb, .ls .has-thumb.tone-l2 .lk-thumb, .ls .has-thumb.tone-l4 .lk-thumb,
.ls .has-thumb.tone-l8 .lk-thumb, .ls .has-thumb.tone-l10 .lk-thumb
{
	background-texture-size: 40px 40px;
}

.ls .lk-chip.tone-r1 .lk-chip__thumb, .ls .lk-chip.tone-r2 .lk-chip__thumb, .ls .lk-chip.tone-r3 .lk-chip__thumb, .ls .lk-chip.tone-r4 .lk-chip__thumb,
.ls .lk-chip.tone-r5 .lk-chip__thumb, .ls .lk-chip.tone-r6 .lk-chip__thumb, .ls .lk-chip.tone-r7 .lk-chip__thumb
{
	background-texture-size: 39px 16px;
}

.ls .lk-chip.tone-l1 .lk-chip__thumb, .ls .lk-chip.tone-l2 .lk-chip__thumb, .ls .lk-chip.tone-l4 .lk-chip__thumb,
.ls .lk-chip.tone-l8 .lk-chip__thumb, .ls .lk-chip.tone-l10 .lk-chip__thumb
{
	background-texture-size: 16px 16px;
}

/* tint=spray-N: the game ships graffiti art untinted and washes it in the chosen colour. */
.ls .lk-thumb.tint-spray-1 { wash-color: chudSprayTint01; }
.ls .lk-thumb.tint-spray-2 { wash-color: chudSprayTint02; }
.ls .lk-thumb.tint-spray-3 { wash-color: chudSprayTint03; }
.ls .lk-thumb.tint-spray-4 { wash-color: chudSprayTint04; }
.ls .lk-thumb.tint-spray-5 { wash-color: chudSprayTint05; }
.ls .lk-thumb.tint-spray-6 { wash-color: chudSprayTint06; }
.ls .lk-thumb.tint-spray-7 { wash-color: chudSprayTint07; }
.ls .lk-thumb.tint-spray-8 { wash-color: chudSprayTint08; }
.ls .lk-thumb.tint-spray-9 { wash-color: chudSprayTint09; }
.ls .lk-thumb.tint-spray-10 { wash-color: chudSprayTint10; }
.ls .lk-thumb.tint-spray-11 { wash-color: chudSprayTint11; }
.ls .lk-thumb.tint-spray-12 { wash-color: chudSprayTint12; }
.ls .lk-thumb.tint-spray-13 { wash-color: chudSprayTint13; }
.ls .lk-thumb.tint-spray-14 { wash-color: chudSprayTint14; }
.ls .lk-thumb.tint-spray-15 { wash-color: chudSprayTint15; }
.ls .lk-thumb.tint-spray-16 { wash-color: chudSprayTint16; }
.ls .lk-thumb.tint-spray-17 { wash-color: chudSprayTint17; }
.ls .lk-thumb.tint-spray-18 { wash-color: chudSprayTint18; }
.ls .lk-thumb.tint-spray-19 { wash-color: chudSprayTint19; }

.ls .lk-mark
{
	width: 26px;
	height: 26px;
	margin: 0px 11px 0px 0px;
}

.ls .lk-mark__text
{
	font-size: 12px;
}

.ls .has-sub .lk-mark
{
	width: 36px;
	height: 36px;
}

.ls .has-sub .lk-mark__text
{
	font-size: 16px;
}

/* The CS Rating badge leads a rank's own row and ends a player's (after the avatar). */
.ls .lk-rating
{
	width: 78px;
	height: 22px;
	padding-left: 24px;
}

.ls .lk-rating__major { font-size: 15px; }
.ls .lk-rating__minor { margin-top: 2px; font-size: 11px; }

.ls .ls-rating-lead
{
	margin: 0px 11px 0px 0px;
}

.ls .lk-slot .ls-rating-end,
.ls .has-rating.has-mark .ls-rating-lead
{
	visibility: collapse;
}

.ls .has-rating.has-mark .ls-rating-end
{
	vertical-align: center;
	margin-left: 10px;
	visibility: visible;
}

/* The compact view: a rarity stripe instead of art, the rarity named at the end. */
.ls-stripe
{
	width: 4px;
	height: 20px;
	vertical-align: center;
	margin-right: 11px;
	border-radius: 2px;
	background-color: chudSurfaceEdge;
	visibility: collapse;
}

.ls.view-compact .ls-stripe
{
	visibility: visible;
}

.ls.view-compact .ls-art,
.ls.view-compact .lk-badge,
.ls.view-compact .lk-sub
{
	visibility: collapse;
}

.ls.view-compact .ls-row
{
	height: 36px;
}

.ls.view-compact .rarity-1 .ls-stripe { background-color: chudRarity01; }
.ls.view-compact .rarity-2 .ls-stripe { background-color: chudRarity02; }
.ls.view-compact .rarity-3 .ls-stripe { background-color: chudRarity03; }
.ls.view-compact .rarity-4 .ls-stripe { background-color: chudRarity04; }
.ls.view-compact .rarity-5 .ls-stripe { background-color: chudRarity05; }
.ls.view-compact .rarity-6 .ls-stripe { background-color: chudRarity06; }
.ls.view-compact .rarity-7 .ls-stripe { background-color: chudRarity07; }
.ls.view-compact .rarity-8 .ls-stripe { background-color: chudRarity08; }
.ls.view-compact .rarity-9 .ls-stripe { background-color: chudRarity09; }
.ls.view-compact .rarity-10 .ls-stripe { background-color: chudRarity10; }

.ls.view-compact .lk-text
{
	flow-children: none;
}

.ls.view-compact .lk-name
{
	vertical-align: center;
}

.ls.view-compact .lk-type
{
	width: fit-children;
	horizontal-align: right;
	vertical-align: center;
	font-size: 11px;
	color: chudTextMuted;
	letter-spacing: 1px;
}

/* A pill (Equipped) says more than the rarity's name. */
.ls.view-compact .has-tag .lk-type
{
	visibility: collapse;
}

/* ---- the text: name and a pill after it, the second line, a meter ---- */

.ls .lk-text
{
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	flow-children: right-wrap;
}

/* Three classes: locker.vcss's art offsets (.lk-slot.has-glyph .lk-text) are as specific. */
.ls .lk-slot .lk-text
{
	margin: 0px;
}

.ls .lk-type,
.ls .lk-sub,
.ls .ls-meter
{
	width: 100%;
}

.ls .lk-name
{
	width: fit-children;
	max-width: 100%;
	font-size: 14px;
}

.ls .has-sub .lk-name,
.ls .has-badge .lk-name
{
	font-size: 15px;
}

.ls .selected .lk-name
{
	font-family: chudFontBody;
	font-weight: bold;
}

.ls .danger .lk-name { color: chudDangerStrong; }
.ls .chosen .lk-name { color: chudAccentStrong; }

.ls .lk-sub
{
	margin-top: 3px;
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

/* A badge opens the second line: the name takes the first whole. The badge is the list's pill
   size, and a sub goes under it, since beside it a long badge would push the sub out of the row. */
.ls .has-badge .lk-name
{
	width: 100%;
}

.ls .lk-badge
{
	padding: 2px 6px;
	font-size: 9px;
	letter-spacing: 1px;
}

.ls .ls-row.has-badge.has-sub
{
	height: 62px;
}

/* The cursor's row: its second line brightens with the name, so it reads on the orange. */
.ls .selected .lk-sub { color: chudTextMain; }
.ls .selected.sub-info .lk-sub { color: chudInfoStrong; }
.ls .selected.sub-good .lk-sub { color: chudSuccessStrong; }
.ls .selected.sub-gold .lk-sub { color: chudGoldBase; }
.ls .selected.sub-bad .lk-sub { color: chudDangerStrong; }

/* `unit=You`: a pill beside the name. */
.ls .lk-unit
{
	margin: 3px 0px 0px 7px;
	padding: 1px 5px;
	border-radius: 2px;
	background-color: chudAccentSoft;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
	color: chudAccentStrong;
	letter-spacing: 1px;
}

/* Disabled: the words step back; a pill saying why stays readable. */
.ls .lk-slot.disabled
{
	opacity: 1;
}

.ls .disabled .ls-art,
.ls .disabled .lk-text
{
	opacity: 0.4;
}

/* A heading: gold capitals on the panel, its count at the end. */
.ls .ls-row.section
{
	height: 24px;
	margin: 6px 0px 2px 0px;
	background-color: transparent;
}

.ls .section .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 3px;
}

.ls .section .lk-value
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextFaint;
	letter-spacing: 1px;
}

/* ---- the right side: pills, a note, then the control ---- */

.ls .lk-tags
{
	vertical-align: center;
	margin: 0px 0px 0px 8px;
}

.ls .lk-tag,
.ls .lk-tag2
{
	margin-left: 0px;
	padding: 2px 6px;
	border-radius: 2px;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
}

.ls .lk-tag2
{
	margin-left: 6px;
}

/* The value over its small print, right-aligned at the row's end. */
.ls-val
{
	vertical-align: center;
	flow-children: down;
}

.ls .ls-val .lk-end
{
	horizontal-align: right;
}

.ls .ls-row .lk-note
{
	horizontal-align: right;
	margin: 2px 0px 0px 0px;
	font-size: 9px;
	letter-spacing: 1.5px;
}

.ls-end
{
	height: fit-children;
	vertical-align: center;
	margin-left: 10px;
	flow-children: right;
}

.ls .lk-end
{
	vertical-align: center;
	margin: 0px;
}

.ls .lk-value
{
	font-size: 14px;
}

.ls .lk-vglyph
{
	width: 14px;
	height: 14px;
	margin-right: 5px;
}

/* A page's count, a progress share: quieter than a value. */
.ls .kind-submenu .lk-value,
.ls .kind-progress .lk-value
{
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudTextFaint;
}

/* A rich row (a render or an avatar) reads as the thing itself: its value is a price
   or a score rather than a count, and it needs no chevron to say it opens. */
.ls .has-thumb .lk-value,
.ls .has-mark .lk-value
{
	font-family: chudDigitsBold;
	font-size: 14px;
	color: chudGoldBase;
}

.ls .lk-slot.has-thumb .lk-chev,
.ls .lk-slot.has-mark .lk-chev
{
	visibility: collapse;
}

.ls .ls-row.tone-main .lk-value,
.ls .tone-ct .lk-value,
.ls .tone-t .lk-value
{
	color: chudTextMain;
}

.ls .ls-row.tone-bad .lk-value
{
	color: chudDangerStrong;
}

/* A page: › at the end. */
.ls .kind-submenu .lk-chev
{
	vertical-align: center;
	margin: 0px 0px 2px 10px;
	font-size: 18px;
	visibility: visible;
}

.ls .selected .lk-chev
{
	color: chudAccentStrong;
}

/* A switch. */
.ls .lk-switch
{
	vertical-align: center;
	margin: 0px 0px 0px 10px;
}

/* A selector: ‹ value ›, A and D step it. */
.ls-arrow
{
	vertical-align: center;
	margin-bottom: 2px;
	font-family: chudFontBody;
	font-size: 16px;
	color: chudTextFaint;
	visibility: collapse;
}

.ls .kind-selector .ls-arrow
{
	visibility: visible;
}

.ls .kind-selector .lk-end
{
	margin: 0px 8px;
}

.ls .selected .ls-arrow
{
	color: chudAccentStrong;
}

.ls .kind-selector .lk-value,
.ls .kind-choice .lk-value
{
	font-size: 13px;
}

/* A choice: its value and a cycle mark, E steps it. */
.ls-cycle
{
	width: 12px;
	height: 12px;
	vertical-align: center;
	margin-left: 7px;
	wash-color: chudTextFaint;
	visibility: collapse;
}

.ls .kind-choice .ls-cycle
{
	visibility: visible;
}

.ls .selected .ls-cycle
{
	wash-color: chudAccentStrong;
}

/* An input: its text in a field, the pen after it. */
.ls-pen
{
	width: 11px;
	height: 11px;
	vertical-align: center;
	margin-left: 8px;
	wash-color: chudTextFaint;
	visibility: collapse;
}

.ls .kind-input .ls-pen
{
	visibility: visible;
}

.ls .kind-input .ls-end
{
	height: 24px;
	padding: 0px 8px;
	border: 1px solid chudSurfaceEdge;
	border-radius: 3px;
	background-color: chudTileDeep;
}

.ls .kind-input .lk-value
{
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	color: chudTextMain;
}

/* A slider: its track, then the value. `bar-N` (menu.vcss) sizes the fill. */
.ls .lk-slot .ls-track,
.ls .lk-slot .ls-meter,
.ls .lk-slot .ls-fill
{
	visibility: collapse;
}

.ls .kind-slider .ls-track
{
	width: 120px;
	height: 6px;
	vertical-align: center;
	margin-left: 10px;
	border-radius: 3px;
	background-color: chudShadowDim;
	visibility: visible;
}

.ls .ls-track .chud-meter__fill
{
	border-radius: 3px;
	background-color: chudAccentBase;
}

.ls .track-wear .ls-track
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudWearFnDim ), color-stop( 0.07, chudWearFnDim ), color-stop( 0.07, chudWearMwDim ), color-stop( 0.15, chudWearMwDim ), color-stop( 0.15, chudWearFtDim ), color-stop( 0.38, chudWearFtDim ), color-stop( 0.38, chudWearWwDim ), color-stop( 0.45, chudWearWwDim ), color-stop( 0.45, chudWearBsDim ), to( chudWearBsDim ) );
}

.ls .track-wear .ls-track .chud-meter__fill
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudWearFnBase ), to( chudWearMwBase ) );
}

.ls .kind-slider .lk-end
{
	width: 44px;
}

.ls .kind-slider .lk-value
{
	width: 100%;
	text-align: right;
}

/* A ProgressBarComponent: its meter under the label, the share at the end. */
.ls .kind-progress .ls-meter
{
	height: 4px;
	margin-top: 6px;
	border-radius: 2px;
	background-color: chudShadowDim;
	visibility: visible;
}

/* A poll: the share fills the row behind its text, the leader in gold, your own in the accent. */
.ls .has-bar .ls-fill
{
	width: 100%;
	height: 100%;
	border-radius: 0px;
	background-color: transparent;
	visibility: visible;
}

.ls .kind-progress .ls-fill
{
	visibility: collapse;
}

.ls .ls-fill .chud-meter__fill
{
	border-radius: 0px;
	border-right: 2px solid chudInfoHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudInfoWash ), to( chudInfoSoft ) );
}

.ls .lead .ls-fill .chud-meter__fill
{
	border-right: 2px solid chudGoldHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudGoldWash ), to( chudGoldSoft ) );
}

.ls .chosen .ls-fill .chud-meter__fill
{
	border-right: 2px solid chudAccentHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentWash ), to( chudAccentSoft ) );
}

.ls .has-bar .lk-value
{
	color: chudTextMain;
}

/* ---- ballots: Yes and No as the two big rows, the turnout and its rule below ---- */

.ls.view-ballot .ls-row.kind-action
{
	height: 44px;
}

.ls.view-ballot .kind-action .lk-name
{
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.ls.view-ballot .kind-action .lk-glyph
{
	width: 16px;
	height: 16px;
}

.ls .tone-good .lk-glyph { wash-color: chudSuccessBase; }
.ls .tone-bad .lk-glyph { wash-color: chudDangerStrong; }

/* ---- ranks: Ranks' pages, whose mouse views caption meters this list does not draw ---- */

/* A pair of tags labels the page's meters (the rank's two thresholds, a weapon's
   headshots and accuracy); a weapon's figures read from its sub line here instead. */
.ls.view-ranks .has-tag2 .lk-tags,
.ls.view-ranks .has-bar2 .lk-mark,
.ls.view-ranks .has-bar2 .ls-val .lk-end
{
	visibility: collapse;
}

/* A unit is a word after its number ("1 210 won", "812 kills"), not a pill. */
.ls.view-ranks .lk-unit
{
	margin-top: 4px;
	padding: 0px;
	background-color: transparent;
	font-size: 10px;
	color: chudTextMuted;
}

/* The ladder's ranks are cards on the row's ground, as MapChooser's maps are, not facts on the panel. */
.ls.view-ranks .ls-row.grp-road
{
	background-color: chudSurfaceRow;
}

/* ---- below the rows: a ballot's turnout and the rule that passes it ---- */

.ls-foot
{
	width: 100%;
	flow-children: down;
}

.ls .ls-foot-row
{
	width: 100%;
	height: 22px;
	margin: 0px;
}

.ls .ls-foot-row .lk-hit,
.ls .ls-foot-row .lk-hit:hover
{
	flow-children: right;
	border: 0px solid transparent;
	background-color: transparent;
}

.ls .ls-foot-row.has-pips
{
	height: 30px;
	margin-top: 6px;
}

.ls .ls-foot-row .lk-pips
{
	width: fill-parent-flow( 1.0 );
	height: 8px;
	vertical-align: center;
	margin-right: 12px;
}

.ls .ls-foot-row .lk-pip
{
	margin-right: 4px;
	border-radius: 2px;
	background-color: chudSuccessBase;
}

.ls .ls-foot-row .lk-text
{
	width: fit-children;
}

.ls .ls-foot-row.has-glyph .lk-text
{
	width: fill-parent-flow( 1.0 );
}

.ls .ls-foot-row .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.ls .ls-foot-row .lk-glyph
{
	width: 12px;
	height: 12px;
	vertical-align: center;
	margin: 0px 7px 0px 0px;
	wash-color: chudTextFaint;
}

.ls .ls-foot-row.has-glyph .lk-name
{
	font-size: 11px;
	color: chudTextFaint;
	letter-spacing: 1px;
}

.ls .ls-foot-row .lk-end
{
	vertical-align: center;
}

.ls .ls-foot-row .lk-value
{
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* A foot row's parts flow left to right, so its note follows the caption: a gap before it,
   and none of the right margin a list row's note keeps clear of the value column. */
.ls .ls-foot-row .lk-note
{
	vertical-align: center;
	margin: 0px 0px 0px 12px;
}

/* ---- the legend: the keys that work now, then the page ---- */

.ls-keys .ls-bar
{
	width: 100%;
	height: 38px;
	margin-top: 7px;
	padding-top: 8px;
	flow-children: right;
	border-top: 1px solid chudSurfaceEdge;
}

.ls-legend
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
}

.ls-lg
{
	height: 100%;
	margin-right: 13px;
	flow-children: right;
}

.ls-lg.hidden
{
	visibility: collapse;
}

.ls-cap
{
	min-width: 18px;
	height: 18px;
	vertical-align: center;
	margin-right: 3px;
	padding: 3px 4px 0px 4px;
	border: 1px solid chudGlassDim;
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudGlassSoft ), to( chudGlassWash ) );
	font-family: chudFontBody;
	font-size: 10px;
	font-weight: bold;
	color: chudTextMain;
	text-align: center;
}

.ls-cap2
{
	visibility: collapse;
}

.ls-lg.has-key2 .ls-cap2
{
	visibility: visible;
}

.ls-verb
{
	vertical-align: center;
	margin-left: 3px;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
}

/* The plain hint where no legend is drawn (a Chat menu, an operator's Hints entry). */
.ls-hint
{
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.ls-legend.has-legend .ls-hint
{
	visibility: collapse;
}

.ls-page
{
	height: 100%;
	flow-children: right;
}

.ls-page.hidden
{
	visibility: collapse;
}

.ls-page__num
{
	vertical-align: center;
	font-family: chudDigitsBold;
	font-size: 11px;
	color: chudInfoBase;
}

.ls-dots
{
	vertical-align: center;
	margin-left: 4px;
	flow-children: right;
}

.ls-dot
{
	width: 6px;
	height: 6px;
	margin-left: 4px;
	border-radius: 3px;
	background-color: chudSurfaceEdge;
	visibility: collapse;
}

/* A dot per page, up to eight: pages-N shows N, page-I lights the one you're on. */
/* A rule per line: CS2 rejects the whole sheet when one rule lists too many selectors. */
.pages-2 .ls-dot-1, .pages-2 .ls-dot-2 { visibility: visible; }
.pages-3 .ls-dot-1, .pages-3 .ls-dot-2, .pages-3 .ls-dot-3 { visibility: visible; }
.pages-4 .ls-dot-1, .pages-4 .ls-dot-2, .pages-4 .ls-dot-3, .pages-4 .ls-dot-4 { visibility: visible; }
.pages-5 .ls-dot-1, .pages-5 .ls-dot-2, .pages-5 .ls-dot-3, .pages-5 .ls-dot-4, .pages-5 .ls-dot-5 { visibility: visible; }
.pages-6 .ls-dot-1, .pages-6 .ls-dot-2, .pages-6 .ls-dot-3, .pages-6 .ls-dot-4, .pages-6 .ls-dot-5, .pages-6 .ls-dot-6 { visibility: visible; }
.pages-7 .ls-dot-1, .pages-7 .ls-dot-2, .pages-7 .ls-dot-3, .pages-7 .ls-dot-4, .pages-7 .ls-dot-5, .pages-7 .ls-dot-6, .pages-7 .ls-dot-7 { visibility: visible; }
.pages-8 .ls-dot-1, .pages-8 .ls-dot-2, .pages-8 .ls-dot-3, .pages-8 .ls-dot-4, .pages-8 .ls-dot-5, .pages-8 .ls-dot-6, .pages-8 .ls-dot-7, .pages-8 .ls-dot-8 { visibility: visible; }

.page-1 .ls-dot-1, .page-2 .ls-dot-2, .page-3 .ls-dot-3, .page-4 .ls-dot-4,
.page-5 .ls-dot-5, .page-6 .ls-dot-6, .page-7 .ls-dot-7, .page-8 .ls-dot-8
{
	background-color: chudInfoBase;
}

/* ---- mouse: no keys and no cursor; the row under the pointer is the bright one ---- */

/* Ten rows show; a longer chunk scrolls. The bar is drawn because a captured panel may
   not get the wheel. */
.ls-mouse .ls-list
{
	max-height: 390px;
	overflow: squish scroll;
}

.ls-mouse .ls-items
{
	padding-right: 8px;
}

/* No key column: the edge keeps the text off it, and stays at the row's left side as the keyboard cursor's does. */
.ls-mouse .ls-edge
{
	margin-right: 9px;
}

/* Room at the end for the control laid over it (.ls-ctl). */
.ls-mouse .kind-slider .ls-hit
{
	padding-right: 214px;
}

.ls-mouse .kind-selector .ls-hit
{
	padding-right: 104px;
}

.ls-mouse .ls-row.section .ls-edge
{
	margin-right: 0px;
}

/* The pointer's row is drawn as the keyboard cursor's (.selected), on the rows a click acts on only:
   a fact, a meter and a heading stay still under it. */
.ls-mouse .kind-action .ls-hit:hover, .ls-mouse .kind-submenu .ls-hit:hover, .ls-mouse .kind-toggle .ls-hit:hover,
.ls-mouse .kind-choice .ls-hit:hover, .ls-mouse .kind-selector .ls-hit:hover, .ls-mouse .kind-slider .ls-hit:hover,
.ls-mouse .kind-input .ls-hit:hover
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentDim ), color-stop( 0.55, chudAccentSoft ), to( chudAccentFade ) );
}

.ls-mouse .kind-action .ls-hit:hover .ls-edge, .ls-mouse .kind-submenu .ls-hit:hover .ls-edge, .ls-mouse .kind-toggle .ls-hit:hover .ls-edge,
.ls-mouse .kind-choice .ls-hit:hover .ls-edge, .ls-mouse .kind-selector .ls-hit:hover .ls-edge, .ls-mouse .kind-slider .ls-hit:hover .ls-edge,
.ls-mouse .kind-input .ls-hit:hover .ls-edge
{
	background-color: chudAccentBase;
}

.ls-mouse .danger.kind-action .ls-hit:hover, .ls-mouse .danger.kind-submenu .ls-hit:hover, .ls-mouse .danger.kind-toggle .ls-hit:hover,
.ls-mouse .danger.kind-choice .ls-hit:hover, .ls-mouse .danger.kind-selector .ls-hit:hover, .ls-mouse .danger.kind-slider .ls-hit:hover,
.ls-mouse .danger.kind-input .ls-hit:hover
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerDim ), color-stop( 0.55, chudDangerSoft ), to( chudDangerFade ) );
}

.ls-mouse .danger.kind-action .ls-hit:hover .ls-edge, .ls-mouse .danger.kind-submenu .ls-hit:hover .ls-edge, .ls-mouse .danger.kind-toggle .ls-hit:hover .ls-edge,
.ls-mouse .danger.kind-choice .ls-hit:hover .ls-edge, .ls-mouse .danger.kind-selector .ls-hit:hover .ls-edge, .ls-mouse .danger.kind-slider .ls-hit:hover .ls-edge,
.ls-mouse .danger.kind-input .ls-hit:hover .ls-edge
{
	background-color: chudDangerBase;
}

.ls-mouse .kind-action .ls-hit:hover .lk-name, .ls-mouse .kind-submenu .ls-hit:hover .lk-name, .ls-mouse .kind-toggle .ls-hit:hover .lk-name,
.ls-mouse .kind-choice .ls-hit:hover .lk-name, .ls-mouse .kind-selector .ls-hit:hover .lk-name, .ls-mouse .kind-slider .ls-hit:hover .lk-name,
.ls-mouse .kind-input .ls-hit:hover .lk-name
{
	font-family: chudFontBody;
	font-weight: bold;
}

/* As on the cursor's row, the second line brightens with the name so it reads on the orange. */
.ls-mouse .kind-action .ls-hit:hover .lk-sub, .ls-mouse .kind-submenu .ls-hit:hover .lk-sub, .ls-mouse .kind-toggle .ls-hit:hover .lk-sub,
.ls-mouse .kind-choice .ls-hit:hover .lk-sub, .ls-mouse .kind-selector .ls-hit:hover .lk-sub, .ls-mouse .kind-slider .ls-hit:hover .lk-sub,
.ls-mouse .kind-input .ls-hit:hover .lk-sub
{
	color: chudTextMain;
}

.ls-mouse .kind-submenu .ls-hit:hover .lk-chev
{
	color: chudAccentStrong;
}

.ls-mouse .kind-choice .ls-hit:hover .ls-cycle
{
	wash-color: chudAccentStrong;
}

/* Outranks the locker's hover for plain text, which would give a fact a ground under the pointer. */
.ls-mouse .kind-text .ls-hit:hover,
.ls-mouse .kind-progress .ls-hit:hover,
.ls-mouse .section .ls-hit:hover
{
	border-left: 0px solid transparent;
	background-color: transparent;
}

/* A slider's or selector's control, over the row's end: its track to click, then ‹ value ›. */
.ls-ctl
{
	height: 100%;
	horizontal-align: right;
	margin-right: 12px;
	flow-children: right;
	visibility: collapse;
}

.ls .kind-slider .ls-ctl,
.ls .kind-selector .ls-ctl
{
	visibility: visible;
}

.ls-mouse .kind-slider .ls-end,
.ls-mouse .kind-selector .ls-end
{
	visibility: collapse;
}

.ls-ctl__track
{
	width: 110px;
	height: 20px;
	vertical-align: center;
	margin-right: 10px;
	flow-children: none;
	visibility: collapse;
}

.ls .kind-slider .ls-ctl__track
{
	visibility: visible;
}

.ls-ctl .ls-track
{
	width: 100%;
	height: 6px;
	vertical-align: center;
	margin: 0px;
}

.ls-segs
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.ls-seg
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	border-radius: 2px;
}

.ls-seg:hover
{
	background-color: chudGlassWash;
}

.ls-step
{
	width: 18px;
	height: 18px;
	vertical-align: center;
	border: 1px solid chudSurfaceEdge;
	border-radius: 3px;
	transition-property: border, background-color;
	transition-duration: 0.12s;
}

.ls-step Label
{
	horizontal-align: center;
	vertical-align: center;
	margin-bottom: 2px;
	font-family: chudFontBody;
	font-size: 13px;
	color: chudTextFaint;
}

.ls-step:hover
{
	border: 1px solid chudAccentBase;
	background-color: chudAccentSoft;
}

.ls-step:hover Label
{
	color: chudAccentStrong;
}

.ls-ctl__value
{
	min-width: 34px;
	vertical-align: center;
	margin: 0px 6px;
	font-family: chudDigitsBold;
	font-size: 14px;
	color: chudGoldBase;
	text-align: center;
	white-space: nowrap;
}

/* The bar: < back a level, × out of every level; the page between when a list has pages. */
.ls-mouse .ls-bar
{
	height: 42px;
	margin-top: 7px;
	padding-top: 8px;
}

.ls .chud-nav
{
	width: 46px;
	height: 30px;
	border-radius: 3px;
}

.ls .chud-nav Label
{
	font-size: 15px;
}

.ls .chud-nav--page
{
	width: 34px;
}

.ls-mouse .ls-page
{
	margin: 0px 2px 0px 8px;
}
