/*
	Icon vocabulary: a .chud-ico panel draws the default, and one token class
	(MenuSidebarProfile.IconClass, "ico-{0}") swaps the art. Every image is the
	game's own except the field-of-view dials and a white mute icon, which ship in
	this addon's images/custom_game/customhud. A token with no rule keeps
	the default, which is why an unmapped sidebar entry still has an icon.

	Art only: the layout sets the panel's size and colour (wash-color), and must
	not set background-image, or it would tie these rules and win by order.
*/

.chud-ico
{
	background-image: url( "s2r://panorama/images/icons/ui/large_tiles.vsvg" );
	background-size: contain;
	background-position: 50% 50%;
	background-repeat: no-repeat;
}

/* A gear in the corner turns an item icon into that item's settings. */
.chud-ico__badge
{
	width: 10px;
	height: 10px;
	horizontal-align: right;
	vertical-align: bottom;
	background-image: url( "s2r://panorama/images/icons/ui/settings.vsvg" );
	background-size: 100% 100%;
	background-repeat: no-repeat;
	visibility: collapse;
}

/* WeaponSkins */
.chud-ico.ico-weapons { background-image: url( "s2r://panorama/images/icons/equipment/deagle.vsvg" ); }
.chud-ico.ico-knives { background-image: url( "s2r://panorama/images/icons/equipment/melee.vsvg" ); }
.chud-ico.ico-gloves { background-image: url( "s2r://panorama/images/icons/equipment/clothing_hands.vsvg" ); }
.chud-ico.ico-agents { background-image: url( "s2r://panorama/images/icons/ui/ct_silhouette.vsvg" ); }
.chud-ico.ico-music-kits { background-image: url( "s2r://panorama/images/icons/ui/music_kit.vsvg" ); }
.chud-ico.ico-graffiti { background-image: url( "s2r://panorama/images/icons/equipment/spray0.vsvg" ); }
.chud-ico.ico-pins { background-image: url( "s2r://panorama/images/icons/equipment/flair0.vsvg" ); }
.chud-ico.ico-stickers { background-image: url( "s2r://panorama/images/icons/ui/sticker.vsvg" ); }
.chud-ico.ico-weapon-props { background-image: url( "s2r://panorama/images/icons/equipment/deagle.vsvg" ); }
.chud-ico.ico-knife-props { background-image: url( "s2r://panorama/images/icons/equipment/melee.vsvg" ); }
.chud-ico.ico-glove-props { background-image: url( "s2r://panorama/images/icons/equipment/clothing_hands.vsvg" ); }
.chud-ico.ico-agent-props { background-image: url( "s2r://panorama/images/icons/ui/ct_silhouette.vsvg" ); }

.chud-ico.ico-weapon-props,
.chud-ico.ico-knife-props,
.chud-ico.ico-glove-props,
.chud-ico.ico-agent-props
{
	background-size: 15px auto;
	background-position: 0% 0%;
}

.chud-ico.ico-weapon-props .chud-ico__badge,
.chud-ico.ico-knife-props .chud-ico__badge,
.chud-ico.ico-glove-props .chud-ico__badge,
.chud-ico.ico-agent-props .chud-ico__badge
{
	visibility: visible;
}

