/*
	Ranks' views on menu_locker. A tier's colour reaches the page as tone-<token>
	(csr0..6 Premier bands, r1..7 skill groups, l1..l10 levels),
	and the generated block at the end maps each to its CS2 colour.
*/

/* ---- ranks-rank: the rank as a hero card, the road around it as a card below ---- */

.lk.view-ranks-rank .lk-banner .lk-slot
{
	width: 100%;
	height: 292px;
	margin: 0px 0px 12px 0px;
}

/* The rarity layer sits under every other part: here the tier's light behind the badge. */
.lk.view-ranks-rank .lk-banner .lk-rarity,
.lk.view-ranks-rank .lk-banner .lk-rarity.hidden
{
	visibility: visible;
}

.lk.view-ranks-rank .lk-banner .lk-rating
{
	width: 278px;
	height: 100px;
	margin-left: 42px;
	padding-left: 92px;
}

.lk.view-ranks-rank .lk-banner .lk-rating__major { font-size: 52px; }
.lk.view-ranks-rank .lk-banner .lk-rating__minor { margin-top: 10px; font-size: 36px; }

.lk.view-ranks-rank .lk-banner .lk-thumb
{
	width: 270px;
	height: 184px;
	margin-left: 45px;
	/* An SVG rasterizes at its declared size, 32x13 for an emblem: these views draw only emblems, so each gives the size drawn. */
	background-texture-size: 270px 110px;
}

.lk.view-ranks-rank .lk-banner .lk-slot .lk-text
{
	width: 494px;
	vertical-align: top;
	margin: 30px 0px 0px 365px;
}

.lk.view-ranks-rank .lk-banner .lk-name
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 40px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-ranks-rank .lk-banner .has-rating .lk-name
{
	font-size: 54px;
	letter-spacing: 3px;
}

.lk.view-ranks-rank .lk-banner .lk-sub
{
	margin-top: 2px;
	font-size: 12px;
	letter-spacing: 2px;
}

/* XP or points, under the tier (Premier's rating is the badge itself). */
.lk.view-ranks-rank .lk-banner .lk-end
{
	horizontal-align: left;
	vertical-align: top;
	margin: 124px 0px 0px 365px;
}

.lk.view-ranks-rank .lk-banner .lk-value
{
	font-size: 40px;
	color: chudTextMain;
	text-transform: uppercase;
}

/* The progress: this tier and the next above the bar, what is left below it. */
.lk.view-ranks-rank .lk-banner .lk-tags
{
	width: 494px;
	horizontal-align: left;
	vertical-align: top;
	margin: 136px 0px 0px 365px;
}

.lk.view-ranks-rank .lk-banner .has-value .lk-tags { margin-top: 186px; }

.lk.view-ranks-rank .lk-banner .lk-tag,
.lk.view-ranks-rank .lk-banner .lk-tag2
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-size: 11px;
	color: chudTextMuted;
}

.lk.view-ranks-rank .lk-banner .lk-tag
{
	width: fill-parent-flow( 1.0 );
}

.lk.view-ranks-rank .lk-banner .lk-meter
{
	width: 494px;
	height: 10px;
	horizontal-align: left;
	vertical-align: top;
	margin: 156px 0px 0px 365px;
	border-radius: 5px;
	background-color: chudSurfaceRow;
}

.lk.view-ranks-rank .lk-banner .has-value .lk-meter { margin-top: 206px; }

.lk.view-ranks-rank .lk-banner .chud-meter__fill
{
	border-radius: 5px;
}

.lk.view-ranks-rank .lk-banner .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 174px 0px 0px 365px;
	font-size: 13px;
	letter-spacing: 1px;
}

.lk.view-ranks-rank .lk-banner .has-value .lk-note { margin-top: 224px; }

/* The road: one node per rank, a line running through their badges. */
.lk.view-ranks-rank .lk-list
{
	padding: 16px 20px 16px 20px;
}

.lk.view-ranks-rank .lk-content .lk-slot.section
{
	width: 100%;
	height: 24px;
	margin: 0px 0px 18px 0px;
}

.lk.view-ranks-rank .lk-content .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

/* Heading and count on one line; the nodes' text rule would align only the heading. */
.lk.view-ranks-rank .lk-content .lk-slot.section .lk-text
{
	width: fill-parent-flow( 1.0 );
	vertical-align: top;
	margin: 0px;
}

.lk.view-ranks-rank .lk-content .lk-slot.section .lk-end
{
	vertical-align: top;
	margin: 0px 0px 0px 8px;
}

/* 7 x (118 + 3) = 847 of 858; a ladder of 8 to 10 narrows to fit, so it is never cut. */
.lk.view-ranks-rank .lk-slot
{
	width: 118px;
	height: 140px;
	margin: 0px 3px 0px 0px;
}

.lk.view-ranks-rank .hk-rows-9 .lk-slot
{
	width: 103px;
}

.lk.view-ranks-rank .hk-rows-10 .lk-slot
{
	width: 91px;
}

.lk.view-ranks-rank .hk-rows-11 .lk-slot
{
	width: 81px;
}

.lk.view-ranks-rank .lk-list .lk-hit,
.lk.view-ranks-rank .lk-list .lk-hit:hover
{
	border: 2px solid transparent;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudShadowFade ), color-stop( 0.293, chudShadowFade ), color-stop( 0.293, chudAccentHalf ), color-stop( 0.321, chudAccentHalf ), color-stop( 0.321, chudShadowFade ), to( chudShadowFade ) );
}

.lk.view-ranks-rank .lk-list .lk-slot.disabled .lk-hit
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudShadowFade ), color-stop( 0.293, chudShadowFade ), color-stop( 0.293, chudSurfaceEdge ), color-stop( 0.321, chudSurfaceEdge ), color-stop( 0.321, chudShadowFade ), to( chudShadowFade ) );
}

.lk.view-ranks-rank .lk-list .lk-slot.chosen .lk-hit,
.lk.view-ranks-rank .lk-list .lk-slot.chosen .lk-hit:hover
{
	border: 2px solid chudAccentBase;
	background-color: chudAccentSoft;
}

.lk.view-ranks-rank .lk-list .lk-rating
{
	width: 94px;
	height: 34px;
	horizontal-align: center;
	vertical-align: top;
	margin: 26px 0px 0px 0px;
	padding-left: 30px;
}

.lk.view-ranks-rank .lk-list .lk-rating__major { font-size: 20px; }
.lk.view-ranks-rank .lk-list .lk-rating__minor { margin-top: 4px; font-size: 14px; }

.lk.view-ranks-rank .lk-list .lk-thumb
{
	width: 96px;
	height: 44px;
	horizontal-align: center;
	vertical-align: top;
	margin: 22px 0px 0px 0px;
	background-texture-size: 96px 39px;
}

.lk.view-ranks-rank .lk-list .lk-slot .lk-text
{
	width: 100%;
	horizontal-align: center;
	vertical-align: top;
	margin: 76px 0px 0px 0px;
}

.lk.view-ranks-rank .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

/* Skill-group names are long: two lines, as CS2 writes them. */
.lk.view-ranks-rank .lk-list .has-thumb .lk-name
{
	height: 32px;
	font-size: 12px;
	text-transform: none;
	letter-spacing: 0.5px;
	white-space: normal;
}

.lk.view-ranks-rank .lk-list .lk-sub
{
	margin-top: 6px;
	font-family: chudDigitsBold;
	font-size: 12px;
	color: chudTextMuted;
	text-align: center;
	letter-spacing: 0px;
}

.lk.view-ranks-rank .lk-list .lk-glyph
{
	width: 11px;
	height: 11px;
	horizontal-align: center;
	vertical-align: bottom;
	margin: 0px 0px 10px 0px;
	wash-color: chudTextFaint;
}

/* Under a two-line skill group and its points there is no room: the lock takes the corner. */
.lk.view-ranks-rank .lk-list .has-thumb .lk-glyph
{
	horizontal-align: right;
	vertical-align: top;
	margin: 8px 8px 0px 0px;
}

.lk.view-ranks-rank .lk-list .lk-tags
{
	horizontal-align: center;
	vertical-align: top;
	margin: 4px 0px 0px 0px;
}

.lk.view-ranks-rank .lk-list .lk-tag
{
	margin: 0px;
	padding: 2px 9px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* A windowed road's way to the whole ladder: a small control under the road, not a node. */
.lk.view-ranks-rank .lk-foot
{
	width: fit-children;
	horizontal-align: right;
	margin-top: 8px;
}

.lk.view-ranks-rank .lk-foot .lk-slot
{
	width: fit-children;
	height: 32px;
	margin: 0px;
}

.lk.view-ranks-rank .lk-foot .lk-hit
{
	width: fit-children;
	padding: 0px 16px;
	border: 1px solid chudSurfaceEdge;
	border-radius: 4px;
	background-color: chudSurfaceRow;
}

.lk.view-ranks-rank .lk-foot .lk-hit:hover
{
	border: 1px solid chudAccentBase;
	background-color: chudSurfaceHover;
}

.lk.view-ranks-rank .lk-foot .lk-slot .lk-text
{
	width: fit-children;
	vertical-align: center;
	margin: 0px;
}

.lk.view-ranks-rank .lk-foot .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

/* ---- ranks-stats: lifetime totals as tiles, 3 x (282 + 8) = 870 of 882 ---- */

/* A counter carries its caption as type=; a row without one is the list's own line
   (loading, nothing yet, failed) and keeps the plain row shape. */
.lk.view-ranks-stats .lk-slot.has-type
{
	width: 282px;
	height: 164px;
	margin: 0px 8px 8px 0px;
}

.lk.view-ranks-stats .lk-glyph
{
	width: 15px;
	height: 15px;
	vertical-align: top;
	margin: 18px 0px 0px 18px;
	wash-color: chudTextFaint;
}

/* The total and its unit share a line whatever the total's width. */
.lk.view-ranks-stats .lk-slot.has-type .lk-text
{
	width: 246px;
	vertical-align: top;
	margin: 16px 0px 0px 18px;
	flow-children: right-wrap;
}

.lk.view-ranks-stats .lk-type
{
	margin-left: 23px;
	font-size: 11px;
	color: chudTextMuted;
	letter-spacing: 2px;
}

.lk.view-ranks-stats .has-type .lk-name
{
	width: fit-children;
	margin-top: 8px;
	font-family: chudDigitsBold;
	font-size: 46px;
}

.lk.view-ranks-stats .lk-unit
{
	margin: 30px 0px 0px 6px;
	font-size: 15px;
}

.lk.view-ranks-stats .lk-sub
{
	margin-top: 4px;
	font-size: 12px;
	letter-spacing: 1px;
}

.lk.view-ranks-stats .lk-meter
{
	width: 246px;
	height: 5px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 0px 16px 18px;
	border-radius: 3px;
	background-color: chudSurfaceRow;
}

.lk.view-ranks-stats .chud-meter__fill
{
	border-radius: 3px;
}

/* A won/lost split: the share won green, the rest of the track red. */
.lk.view-ranks-stats .meter-split .lk-meter
{
	background-color: chudDangerBase;
}

.lk.view-ranks-stats .meter-split .chud-meter__fill
{
	border-right: 2px solid chudTileDeep;
	border-radius: 0px;
	background-color: chudSuccessBase;
}

/* Ten to twelve tiles take four rows, which fit under the tabs only this much shorter (Ranks 1.3's ten counters). */
.lk.view-ranks-stats .hk-rows-10 .lk-slot.has-type,
.lk.view-ranks-stats .hk-rows-11 .lk-slot.has-type,
.lk.view-ranks-stats .hk-rows-12 .lk-slot.has-type
{
	height: 122px;
}

.lk.view-ranks-stats .hk-rows-10 .lk-glyph,
.lk.view-ranks-stats .hk-rows-11 .lk-glyph,
.lk.view-ranks-stats .hk-rows-12 .lk-glyph
{
	margin-top: 14px;
}

.lk.view-ranks-stats .hk-rows-10 .lk-slot.has-type .lk-text,
.lk.view-ranks-stats .hk-rows-11 .lk-slot.has-type .lk-text,
.lk.view-ranks-stats .hk-rows-12 .lk-slot.has-type .lk-text
{
	margin-top: 12px;
}

.lk.view-ranks-stats .hk-rows-10 .has-type .lk-name,
.lk.view-ranks-stats .hk-rows-11 .has-type .lk-name,
.lk.view-ranks-stats .hk-rows-12 .has-type .lk-name
{
	margin-top: 2px;
	font-size: 38px;
}

.lk.view-ranks-stats .hk-rows-10 .lk-unit,
.lk.view-ranks-stats .hk-rows-11 .lk-unit,
.lk.view-ranks-stats .hk-rows-12 .lk-unit
{
	margin-top: 22px;
}

.lk.view-ranks-stats .hk-rows-10 .lk-sub,
.lk.view-ranks-stats .hk-rows-11 .lk-sub,
.lk.view-ranks-stats .hk-rows-12 .lk-sub
{
	margin-top: 2px;
}

.lk.view-ranks-stats .hk-rows-10 .lk-meter,
.lk.view-ranks-stats .hk-rows-11 .lk-meter,
.lk.view-ranks-stats .hk-rows-12 .lk-meter
{
	margin-bottom: 12px;
}

/* ---- ranks-weapons: the weapons played most, 4 x (212 + 6) = 872 of 882 ---- */

/* A card carries the weapon as type=; the list's own line (loading, nothing yet) does not. */
.lk.view-ranks-weapons .lk-slot.has-type
{
	width: 212px;
	height: 258px;
	margin: 0px 6px 8px 0px;
}

.lk.view-ranks-weapons .lk-thumb
{
	width: 100%;
	height: 104px;
	vertical-align: top;
	margin: 0px;
}

/* The favourite's badge. */
.lk.view-ranks-weapons .lk-note
{
	vertical-align: top;
	margin: 8px 8px 0px 0px;
	padding: 3px 8px;
	border-radius: 3px;
	background-color: chudGoldBase;
	font-family: chudFontBody;
	font-weight: bold;
	color: chudTextInk;
}

.lk.view-ranks-weapons .lk-slot.has-type .lk-text
{
	width: 184px;
	vertical-align: top;
	margin: 104px 0px 0px 14px;
	flow-children: right-wrap;
}

.lk.view-ranks-weapons .lk-type
{
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	color: chudTextMain;
	letter-spacing: 1px;
}

.lk.view-ranks-weapons .has-type .lk-name
{
	width: fit-children;
	margin-top: 2px;
	font-family: chudDigitsBold;
	font-size: 32px;
}

.lk.view-ranks-weapons .lk-unit
{
	margin: 16px 0px 0px 6px;
}

/* Two labelled meters: headshots (value) over accuracy (mark). The sub says the same in
   words for the keyboard list, which draws neither meter. */
.lk.view-ranks-weapons .lk-slot.has-sub .lk-sub
{
	visibility: collapse;
}

.lk.view-ranks-weapons .lk-tags
{
	horizontal-align: left;
	vertical-align: top;
	margin: 176px 0px 0px 14px;
	flow-children: down;
}

.lk.view-ranks-weapons .lk-tag,
.lk.view-ranks-weapons .lk-tag2
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	color: chudTextMuted;
}

.lk.view-ranks-weapons .lk-tag
{
	margin-bottom: 20px;
}

.lk.view-ranks-weapons .lk-end
{
	vertical-align: top;
	margin: 174px 14px 0px 0px;
}

.lk.view-ranks-weapons .lk-value
{
	font-size: 12px;
	color: chudTextMain;
}

.lk.view-ranks-weapons .lk-mark
{
	width: fit-children;
	height: 16px;
	horizontal-align: right;
	vertical-align: top;
	margin: 205px 14px 0px 0px;
	background-color: transparent;
}

.lk.view-ranks-weapons .lk-mark__text
{
	horizontal-align: right;
	font-family: chudDigitsBold;
	font-size: 12px;
	font-weight: normal;
}

.lk.view-ranks-weapons .lk-meter,
.lk.view-ranks-weapons .lk-meter2
{
	width: 184px;
	height: 5px;
	horizontal-align: left;
	vertical-align: top;
	margin: 193px 0px 0px 14px;
	border-radius: 3px;
	background-color: chudSurfaceRow;
}

.lk.view-ranks-weapons .lk-meter2
{
	margin-top: 225px;
}

.lk.view-ranks-weapons .chud-meter__fill
{
	border-radius: 3px;
	background-color: chudAccentBase;
}

/* ---- ranks-board: the top three on a podium, the rest as a table ---- */

.lk.view-ranks-board .lk-banner
{
	height: 210px;
	margin-bottom: 14px;
	flow-children: none;
}

.lk.view-ranks-board .lk-banner .lk-slot
{
	width: 280px;
	height: 210px;
	horizontal-align: center;
	vertical-align: bottom;
	margin: 0px;
}

/* Second on the left, third on the right, each a step lower. */
.lk.view-ranks-board #banner_1
{
	height: 186px;
	horizontal-align: left;
	margin-left: 16px;
}

.lk.view-ranks-board #banner_2
{
	height: 174px;
	horizontal-align: right;
	margin-right: 16px;
}

.lk.view-ranks-board #banner_1 .lk-hit { border: 1px solid chudTint01; }
.lk.view-ranks-board #banner_2 .lk-hit { border: 1px solid chudTint08; }

.lk.view-ranks-board .lk-banner .lk-tags
{
	horizontal-align: center;
	vertical-align: top;
	margin: 14px 0px 0px 0px;
}

.lk.view-ranks-board .lk-banner .lk-tag
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-family: chudDigitsBold;
	font-size: 26px;
	letter-spacing: 0px;
}

.lk.view-ranks-board #banner_0 .lk-tag { color: chudGoldBase; }
.lk.view-ranks-board #banner_1 .lk-tag { color: chudRarity01; }
.lk.view-ranks-board #banner_2 .lk-tag { color: chudRarity08; }

.lk.view-ranks-board .lk-banner .lk-rating
{
	width: 111px;
	height: 40px;
	horizontal-align: center;
	vertical-align: top;
	margin: 54px 0px 0px 0px;
	padding-left: 36px;
}

.lk.view-ranks-board .lk-banner .lk-rating__major { font-size: 24px; }
.lk.view-ranks-board .lk-banner .lk-rating__minor { margin-top: 4px; font-size: 17px; }

.lk.view-ranks-board .lk-banner .lk-thumb
{
	width: 104px;
	height: 48px;
	horizontal-align: center;
	vertical-align: top;
	margin: 50px 0px 0px 0px;
	background-texture-size: 104px 42px;
}

.lk.view-ranks-board .lk-banner .lk-slot .lk-text
{
	width: 100%;
	horizontal-align: center;
	vertical-align: top;
	margin: 104px 0px 0px 0px;
}

.lk.view-ranks-board .lk-banner .lk-name
{
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
	text-align: center;
}

.lk.view-ranks-board .lk-banner .lk-sub
{
	font-family: chudFontBody;
	font-weight: bold;
	text-align: center;
	letter-spacing: 2px;
}

.lk.view-ranks-board .lk-banner .has-thumb .lk-sub
{
	font-size: 12px;
	text-transform: none;
	letter-spacing: 0.5px;
}

.lk.view-ranks-board .lk-banner .lk-end
{
	horizontal-align: center;
	vertical-align: top;
	margin: 148px 0px 0px 0px;
}

.lk.view-ranks-board .lk-banner .lk-value
{
	text-transform: uppercase;
}

/* The table: # | art | player | tier | points, columns shared with the head. */
.lk.view-ranks-board .lk-thead
{
	padding: 0px 16px 4px 16px;
}

.lk.view-ranks-board .lk-col-head
{
	color: chudAccentStrong;
}

.lk.view-ranks-board .lk-col-head-0 { width: 64px; }
.lk.view-ranks-board .lk-col-head-1 { width: 96px; }
.lk.view-ranks-board .lk-col-head-2 { width: fill-parent-flow( 1.0 ); }
.lk.view-ranks-board .lk-col-head-3 { width: 151px; }

.lk.view-ranks-board .lk-list .lk-slot
{
	height: 38px;
	margin: 4px 0px 0px 0px;
}

.lk.view-ranks-board .lk-list .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 16px;
}

.lk.view-ranks-board .lk-list .lk-tag
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-family: chudDigitsBold;
	font-size: 15px;
	color: chudGoldBase;
	letter-spacing: 0px;
}

.lk.view-ranks-board .lk-list .lk-rating
{
	width: 67px;
	height: 24px;
	margin-left: 80px;
	padding-left: 22px;
}

.lk.view-ranks-board .lk-list .lk-rating__major { font-size: 15px; }
.lk.view-ranks-board .lk-list .lk-rating__minor { margin-top: 2px; font-size: 11px; }

.lk.view-ranks-board .lk-list .lk-thumb
{
	width: 52px;
	height: 21px;
	margin-left: 80px;
	background-texture-size: 52px 21px;
}

.lk.view-ranks-board .lk-list .lk-slot .lk-text
{
	width: fit-children;
	margin-left: 176px;
	flow-children: right;
}

.lk.view-ranks-board .lk-list .lk-slot.has-thumb .lk-text
{
	margin-left: 164px;
}

.lk.view-ranks-board .lk-list .lk-name
{
	width: 553px;
	vertical-align: center;
	font-size: 15px;
}

.lk.view-ranks-board .lk-list .has-thumb .lk-name
{
	width: 386px;
}

.lk.view-ranks-board .lk-list .lk-sub
{
	width: 150px;
	vertical-align: center;
	margin: 0px;
	font-family: chudFontBody;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 1.5px;
}

.lk.view-ranks-board .lk-list .has-thumb .lk-sub
{
	width: 220px;
	font-size: 13px;
	text-transform: none;
	letter-spacing: 0.5px;
}

.lk.view-ranks-board .lk-list .lk-value
{
	color: chudTextMain;
}

/* The break between the table and the player's own row. Scoped under .lk-list so it
   outranks the table's own text rules above. */
.lk.view-ranks-board .lk-list .lk-slot.grp-gap
{
	height: 18px;
}

.lk.view-ranks-board .lk-list .lk-slot.grp-gap .lk-text
{
	width: 100%;
	margin: 0px;
}

.lk.view-ranks-board .lk-list .grp-gap .lk-name
{
	width: 100%;
	font-size: 12px;
	color: chudTextFaint;
	text-align: center;
	letter-spacing: 6px;
}

/* ---- ranks-settings: a narrow form of switches and help, the reset kept apart ---- */

.lk.view-ranks-settings .lk-list
{
	width: 668px;
	horizontal-align: center;
	padding-right: 0px;
}

.lk.view-ranks-settings .lk-content .lk-slot.section
{
	height: 22px;
	margin: 10px 0px 6px 0px;
}

.lk.view-ranks-settings .lk-content .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

.lk.view-ranks-settings .lk-slot
{
	height: 60px;
	margin-bottom: 6px;
}

.lk.view-ranks-settings .lk-slot .lk-text
{
	margin-left: 16px;
}

.lk.view-ranks-settings .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-ranks-settings .lk-sub
{
	margin-top: 3px;
	font-size: 13px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-ranks-settings .lk-switch
{
	margin-right: 18px;
}

.lk.view-ranks-settings .kind-submenu .lk-chev
{
	visibility: visible;
}

.lk.view-ranks-settings .grp-danger
{
	height: 74px;
	margin-top: 20px;
}

.lk.view-ranks-settings .grp-danger .lk-hit,
.lk.view-ranks-settings .grp-danger .lk-hit:hover
{
	border: 1px solid chudDangerDim;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerWash ), to( chudDangerFade ) );
}

.lk.view-ranks-settings .grp-danger .lk-name
{
	color: chudDangerStrong;
	letter-spacing: 1.5px;
}

.lk.view-ranks-settings .grp-danger .lk-inline
{
	margin-right: 18px;
}

.lk.view-ranks-settings .grp-danger .lk-inline__label
{
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	color: chudDangerStrong;
}

/* ---- tier colours (generated by css-audit/palette.py from the rank tokens) ---- */
.lk.view-ranks-rank .tone-csr0 .lk-name,
.lk.view-ranks-board .tone-csr0 .lk-sub,
.lk .lk-chip.tone-csr0 .lk-chip__value { color: chudRating0Base; }
.lk.view-ranks-rank .tone-csr0 .chud-meter__fill { background-color: chudRating0Base; }
.lk.view-ranks-rank .lk-banner .tone-csr0 .lk-rarity { background-color: gradient( radial, 20% 55%, 0% 0%, 42% 70%, from( chudRating0Glow ), to( chudShadowFade ) ); }

