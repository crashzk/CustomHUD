/* Generated by scripts/generate-v2-sheets.ps1 from locker_maps.vcss in the store palette. Do not edit. */

/*
	MapChooser's views on menu_locker. Map shots and logos come from locker_art.vcss
	(econ-<token> on lk-thumb and lk-logo). A map without art gets its prefix as its
	mark and tone (awp_lego_2: "awp"), which pick the stand-in art below.
*/

/* ---- shared: logos on the shot's corner, and the stand-in for maps without art ---- */

.lk.view-maps-board .lk-logo,
.lk.view-maps-rows .lk-logo,
.lk.view-maps-pool .lk-logo,
.lk.view-maps-rtv .lk-logo,
.lk.view-maps-cycle .lk-logo
{
	width: 28px;
	height: 28px;
	horizontal-align: left;
	vertical-align: top;
	margin: 10px 0px 0px 10px;
	visibility: visible;
}

.lk.view-maps-board .lk-logo.hidden,
.lk.view-maps-rows .lk-logo.hidden,
.lk.view-maps-pool .lk-logo.hidden,
.lk.view-maps-rtv .lk-logo.hidden,
.lk.view-maps-cycle .lk-logo.hidden
{
	visibility: collapse;
}

.lk.view-maps-board .lk-mark,
.lk.view-maps-rows .lk-mark,
.lk.view-maps-pool .lk-mark,
.lk.view-maps-rtv .lk-mark,
.lk.view-maps-cycle .lk-mark
{
	horizontal-align: left;
	vertical-align: top;
	margin: 0px;
	border-radius: 0px;
	overflow: clip clip;
	background-image: url( "s2r://panorama/images/custom_game/customhud/stripes.vsvg" );
	background-size: 28px 28px;
	background-repeat: repeat;
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudMapOtherBase ), to( chudMapOtherDeep ) );
}

.lk.view-maps-board .tone-awp .lk-mark, .lk.view-maps-rows .tone-awp .lk-mark,
.lk.view-maps-pool .tone-awp .lk-mark, .lk.view-maps-rtv .tone-awp .lk-mark,
.lk.view-maps-cycle .tone-awp .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudMapAwpBase ), to( chudMapAwpDeep ) );
}

.lk.view-maps-board .tone-aim .lk-mark, .lk.view-maps-rows .tone-aim .lk-mark,
.lk.view-maps-pool .tone-aim .lk-mark, .lk.view-maps-rtv .tone-aim .lk-mark,
.lk.view-maps-cycle .tone-aim .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudMapAimBase ), to( chudMapAimDeep ) );
}

.lk.view-maps-board .tone-surf .lk-mark, .lk.view-maps-rows .tone-surf .lk-mark,
.lk.view-maps-pool .tone-surf .lk-mark, .lk.view-maps-rtv .tone-surf .lk-mark,
.lk.view-maps-cycle .tone-surf .lk-mark
{
	background-color: gradient( linear, 0% 0%, 100% 100%, from( chudMapSurfBase ), to( chudMapSurfDeep ) );
}

/* The prefix, huge and faint, cut off by the art's lower edge. */
.lk.view-maps-board .lk-mark__text,
.lk.view-maps-rows .lk-mark__text,
.lk.view-maps-pool .lk-mark__text,
.lk.view-maps-rtv .lk-mark__text,
.lk.view-maps-cycle .lk-mark__text
{
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 10px -14px 0px;
	font-size: 76px;
	color: chudGlassSoft;
	letter-spacing: 4px;
}

/* Tags on the shot: its top-right corner, or the top-left where a workshop map has no logo.
   Their colours are the Solid pill look in locker.vcss. */
.lk.view-maps-board .lk-tags,
.lk.view-maps-pool .lk-tags
{
	horizontal-align: right;
	vertical-align: top;
	margin: 10px 10px 0px 0px;
}

/* The tags' own 6px left margin brings the first one to 10px from the corner. */
.lk.view-maps-board .has-mark .lk-tags,
.lk.view-maps-pool .has-mark .lk-tags
{
	horizontal-align: left;
	margin: 10px 0px 0px 4px;
}

.lk.view-maps-board .lk-tag,
.lk.view-maps-board .lk-tag2,
.lk.view-maps-pool .lk-tag,
.lk.view-maps-pool .lk-tag2
{
	margin: 0px 0px 0px 6px;
	padding: 3px 8px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* The maps' pills pad 8px, not 7px; the glyph's offsets follow (see .lk-tagglyph). */
.lk.view-maps-board .lk-tagglyph,
.lk.view-maps-rows .lk-tagglyph,
.lk.view-maps-pool .lk-tagglyph,
.lk.view-maps-cycle .lk-tagglyph
{
	margin: 0px -26px 0px 14px;
}

.lk.view-maps-board .has-tagglyph .lk-tag,
.lk.view-maps-rows .has-tagglyph .lk-tag,
.lk.view-maps-pool .has-tagglyph .lk-tag,
.lk.view-maps-cycle .has-tagglyph .lk-tag
{
	padding-left: 25px;
}

/* A solid pill's size is all padding; its edge would add 2px the design doesn't have. */
.lk.view-maps-board .tag-gold .lk-tag, .lk.view-maps-board .tag-accent .lk-tag, .lk.view-maps-board .tag-info .lk-tag,
.lk.view-maps-rows .tag-gold .lk-tag, .lk.view-maps-rows .tag-accent .lk-tag, .lk.view-maps-rows .tag-info .lk-tag,
.lk.view-maps-pool .tag-gold .lk-tag, .lk.view-maps-pool .tag-accent .lk-tag, .lk.view-maps-pool .tag-info .lk-tag
{
	border: 0px solid transparent;
}

/* ---- maps-board: vote cards, three to a line ---- */

/* 3 x (285 + 8) = 879 of the list's 882. */
.lk.view-maps-board .lk-slot
{
	width: 285px;
	height: 276px;
	margin: 0px 8px 8px 0px;
}

/* The shot fades into the card, so the tile stays one flat colour under it. */
.lk.view-maps-board .lk-list .lk-hit,
.lk.view-maps-board .lk-list .lk-hit:hover,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit:hover
{
	background-color: chudStoreTileDeep;
}

/* Extend has no map: its art is dark amber under a glow behind its icon, faded like a shot.
   The card's top 158px (0.572 of 276) is the amber, the mark the glow, the shade the fade. */
.lk.view-maps-board .lk-list .lk-slot.tone-extend .lk-hit,
.lk.view-maps-board .lk-list .lk-slot.tone-extend .lk-hit:hover
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudExtendShade ), color-stop( 0.572, chudExtendDeep ), color-stop( 0.572, chudStoreTileDeep ), to( chudStoreTileDeep ) );
}

.lk.view-maps-board .tone-extend .lk-hit
{
	border: 1px solid chudExtendDim;
}

.lk.view-maps-board .lk-thumb
{
	width: 100%;
	height: 158px;
	vertical-align: top;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-board .lk-mark
{
	width: 100%;
	height: 158px;
}

/* The shot fades into the card under the map's name. */
.lk.view-maps-board .lk-shade
{
	height: 158px;
	vertical-align: top;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileFade ), color-stop( 0.45, chudStoreTileFade ), to( chudStoreTileDeep ) );
	visibility: visible;
}

.lk.view-maps-board .tone-extend .lk-mark
{
	visibility: visible;
	background-image: none;
	background-color: gradient( radial, 50% 60%, 0% 0%, 58% 47%, from( chudExtendSoft ), to( chudExtendFade ) );
}

.lk.view-maps-board .lk-glyph
{
	width: 54px;
	height: 54px;
	horizontal-align: center;
	vertical-align: top;
	margin: 52px 0px 0px 0px;
	wash-color: chudNavBase;
}

.lk.view-maps-board .tone-extend .lk-glyph,
.lk.view-maps-rows .tone-extend .lk-glyph
{
	wash-color: chudExtendBase;
	opacity: 0.85;
}

.lk.view-maps-board .lk-slot .lk-text
{
	width: 257px;
	vertical-align: top;
	margin: 124px 0px 0px 14px;
}

.lk.view-maps-board .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	text-shadow: 0px 1px 3px 1.0 chudShadowText;
}

.lk.view-maps-board .tone-extend .lk-name
{
	color: chudExtendStrong;
}

.lk.view-maps-board .lk-slot .lk-sub
{
	visibility: collapse;
}

/* The map's kind, boxed under its name (as on the rows and the pool). */
.lk.view-maps-board .lk-badge
{
	margin-top: 6px;
}

.lk.view-maps-board .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 194px 0px 0px 14px;
	font-size: 12px;
}

.lk.view-maps-board .lk-end
{
	vertical-align: top;
	margin: 171px 14px 0px 0px;
}

.lk.view-maps-board .lk-value
{
	font-size: 38px;
	color: chudTextMain;
}

.lk.view-maps-board .lead .lk-value
{
	color: chudGoldBase;
}

/* The unit sits on the value's baseline: the bigger font's taller descent, lifted out. */
.lk.view-maps-board .lk-vunit
{
	margin: 0px 0px 5px 2px;
	font-size: 18px;
}

.lk.view-maps-board .lk-meter
{
	width: 257px;
	height: 6px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 0px 40px 14px;
	border-radius: 3px;
	background-color: chudStoreRow;
}

.lk.view-maps-board .chud-meter__fill
{
	border-radius: 3px;
}

.lk.view-maps-board .tone-extend .chud-meter__fill
{
	background-color: chudExtendBase;
}

/* Two lines of cards fill the page; the turnout is in the header's chips. */
.lk.view-maps-board .lk-foot
{
	visibility: collapse;
}

/* ---- maps-rows: one poll row per map, its share filling the row ---- */

/* 880 of the list's 882, as wide as the turnout under the rows. */
.lk.view-maps-rows .lk-slot
{
	width: 880px;
	height: 74px;
	margin-bottom: 8px;
}

.lk.view-maps-rows .lk-thumb
{
	width: 132px;
	height: 100%;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-rows .lk-logo
{
	width: 24px;
	height: 24px;
	margin: 8px 0px 0px 8px;
}

.lk.view-maps-rows .lk-mark
{
	width: 132px;
	height: 100%;
}

.lk.view-maps-rows .lk-mark__text
{
	margin: 0px 10px -8px 0px;
	font-size: 44px;
}

.lk.view-maps-rows .tone-extend .lk-mark
{
	visibility: visible;
	background-image: none;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudExtendShade ), to( chudExtendDeep ) );
}

.lk.view-maps-rows .tone-extend .lk-shade
{
	width: 132px;
	horizontal-align: left;
	background-color: gradient( radial, 50% 60%, 0% 0%, 58% 47%, from( chudExtendSoft ), to( chudExtendFade ) );
	visibility: visible;
}

.lk.view-maps-rows .lk-glyph
{
	width: 32px;
	height: 32px;
	margin-left: 50px;
	wash-color: chudNavBase;
}

/* The share: a fill behind the row from the art's edge, with a bright leading edge. */
.lk.view-maps-rows .lk-meter
{
	width: 746px;
	height: 100%;
	horizontal-align: right;
	vertical-align: top;
	margin: 0px;
	border-radius: 0px;
	background-color: transparent;
}

/* The fill is drawn after the text; z-index keeps the words on top of it. */
.lk.view-maps-rows .lk-text,
.lk.view-maps-rows .lk-tags,
.lk.view-maps-rows .lk-note,
.lk.view-maps-rows .lk-end
{
	z-index: 1;
}

.lk.view-maps-rows .lk-slot .lk-text
{
	width: 420px;
	margin-left: 150px;
}

.lk.view-maps-rows .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rows .tone-extend .lk-name
{
	color: chudExtendStrong;
}

.lk.view-maps-rows .lk-sub
{
	margin-top: 4px;
}

.lk.view-maps-rows .lk-tags
{
	margin-right: 150px;
}

.lk.view-maps-rows .lk-tag,
.lk.view-maps-rows .lk-tag2
{
	padding: 3px 8px;
	font-family: chudFontBody;
	font-weight: bold;
}

.lk.view-maps-rows .lk-end
{
	vertical-align: top;
	margin: 7px 18px 0px 0px;
}

.lk.view-maps-rows .lk-value
{
	font-size: 30px;
	color: chudTextMain;
}

.lk.view-maps-rows .lead .lk-value
{
	color: chudGoldBase;
}

.lk.view-maps-rows .lk-vunit
{
	margin: 0px 0px 4px 2px;
	font-size: 15px;
}

/* Extend's share fills its row in its own orange. */
.lk.view-maps-rows .tone-extend .chud-meter__fill
{
	border-right: 2px solid chudExtendHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudExtendWash ), to( chudExtendSoft ) );
}

.lk.view-maps-rows .lk-note
{
	vertical-align: top;
	margin: 48px 18px 0px 0px;
}

/* The turnout under the rows: a caption, a pip per player, the time left. The list is as tall
   as its rows, so the turnout follows the last one; past 542px (the column less the turnout's
   34px) the list scrolls. */
.lk.view-maps-rows .lk-listbox,
.lk.view-maps-rows .lk-list
{
	height: fit-children;
	max-height: 542px;
}

.lk.view-maps-rows.chud-rewind .lk-items
{
	height: fit-children;
	max-height: 542px;
}

.lk.view-maps-rows .lk-foot .lk-slot
{
	height: 34px;
	margin: 0px;
}

.lk.view-maps-rows .lk-foot .lk-slot .lk-text
{
	width: 160px;
	margin-left: 4px;
}

.lk.view-maps-rows .lk-foot .lk-pips
{
	width: 622px;
	height: 8px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 163px;
}

.lk.view-maps-rows .lk-foot .lk-pip
{
	margin-right: 4px;
}

.lk.view-maps-rows .lk-foot .lk-note
{
	vertical-align: center;
	margin: 0px 4px 0px 0px;
	font-size: 11px;
}

/* ---- maps-cycle: the cycle in order, each map moved or removed from its own row ---- */

/* 880 of the list's 882: the place, the shot, the name over its kind and players, the tags, then
   the act= buttons, 3 x 38 + 12 = 126px at the right end. */
.lk.view-maps-cycle .lk-slot
{
	width: 880px;
	height: 72px;
	margin-bottom: 6px;
}

/* The map's place in the cycle, in a column left of the shot; green for the map on now. */
.lk.view-maps-cycle .lk-end
{
	width: 48px;
	horizontal-align: left;
	margin: 0px;
}

.lk.view-maps-cycle .lk-value
{
	horizontal-align: center;
	font-size: 22px;
	color: chudStoreFaint;
}

.lk.view-maps-cycle .tag-good .lk-value
{
	color: chudSuccessBase;
}

.lk.view-maps-cycle .lk-thumb
{
	width: 128px;
	height: 100%;
	margin: 0px 0px 0px 48px;
	background-size: 100% 100%;
}

.lk.view-maps-cycle .lk-logo
{
	width: 22px;
	height: 22px;
	margin: 6px 0px 0px 54px;
}

.lk.view-maps-cycle .lk-mark
{
	width: 128px;
	height: 100%;
	margin-left: 48px;
}

.lk.view-maps-cycle .lk-mark__text
{
	margin: 0px 8px -8px 0px;
	font-size: 40px;
}

.lk.view-maps-cycle .lk-slot .lk-text
{
	width: 400px;
	margin-left: 192px;
}

.lk.view-maps-cycle .lk-name
{
	font-family: chudFontBody;
	font-size: 18px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-cycle .lk-sub
{
	margin-top: 4px;
}

.lk.view-maps-cycle .lk-tags
{
	margin-right: 140px;
}

.lk.view-maps-cycle .lk-tag,
.lk.view-maps-cycle .lk-tag2
{
	padding: 3px 8px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* ---- maps-pool: every map as a card, four to a line, 4 x (212 + 8) = 880 of 882 ---- */

.lk.view-maps-pool .lk-slot
{
	width: 212px;
	height: 196px;
	margin: 0px 8px 8px 0px;
}

.lk.view-maps-pool .lk-thumb
{
	width: 100%;
	height: 118px;
	vertical-align: top;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-pool .lk-mark
{
	width: 100%;
	height: 118px;
}

/* 4px higher than the design's 130px, which had no badge between the name and the players. */
.lk.view-maps-pool .lk-slot .lk-text
{
	width: 188px;
	vertical-align: top;
	margin: 126px 0px 0px 12px;
}

.lk.view-maps-pool .lk-name
{
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-maps-pool .lk-sub
{
	margin-top: 5px;
}

/* A map that can't be picked dims its art and words; the tag saying why stays clear, on its shot
   just above its name. */
.lk.view-maps-pool .lk-slot.disabled
{
	opacity: 1.0;
}

.lk.view-maps-pool .lk-slot.disabled .lk-thumb,
.lk.view-maps-pool .lk-slot.disabled .lk-logo,
.lk.view-maps-pool .lk-slot.disabled .lk-mark,
.lk.view-maps-pool .lk-slot.disabled .lk-text
{
	opacity: 0.35;
}

.lk.view-maps-pool .lk-slot.disabled .lk-tags
{
	horizontal-align: left;
	margin: 88px 0px 0px 3px;
}

/* Start a vote ticks maps: a ticked map is outlined like a pick and glows, lifted over its
   neighbours so the glow shows on every side. A card has no room for a toggle's switch. */
.lk.view-maps-board .kind-toggle .lk-switch,
.lk.view-maps-pool .kind-toggle .lk-switch
{
	visibility: collapse;
}

.lk.view-maps-pool .lk-list .lk-slot.chosen.kind-toggle
{
	z-index: 1;
}

.lk.view-maps-pool .lk-list .lk-slot.chosen.kind-toggle .lk-hit
{
	box-shadow: fill chudNavDim 0px 0px 12px 0px;
}

/* Its start button, among the maps: an icon where a shot would be, and under its name what it
   does or why it can't. Until it can start, its icon and name dim but that line stays clear;
   ready (tone-ready), it takes an accent edge and a wash from the top over the tile's ground. */
.lk.view-maps-pool .grp-start .lk-glyph
{
	width: 48px;
	height: 48px;
	horizontal-align: center;
	vertical-align: top;
	margin: 35px 0px 0px 0px;
	wash-color: chudStoreText;
}

.lk.view-maps-pool .lk-list .grp-start.tone-ready .lk-hit
{
	border: 1px solid chudNavBase;
}

.lk.view-maps-pool .grp-start.tone-ready .lk-shade
{
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudNavSoft ), to( chudNavFade ) );
	visibility: visible;
}

.lk.view-maps-pool .grp-start.tone-ready .lk-glyph
{
	wash-color: chudNavBase;
}

.lk.view-maps-pool .grp-start.tone-ready .lk-name
{
	color: chudNavStrong;
}

.lk.view-maps-pool .grp-start .lk-sub
{
	white-space: normal;
	text-overflow: clip;
}

.lk.view-maps-pool .lk-slot.disabled.grp-start .lk-text
{
	opacity: 1.0;
}

.lk.view-maps-pool .lk-slot.disabled.grp-start .lk-glyph,
.lk.view-maps-pool .lk-slot.disabled.grp-start .lk-name
{
	opacity: 0.35;
}

/* ---- maps-rtv: the vote's progress in one panel, the nominations beside it ---- */

.lk.view-maps-rtv .lk-col
{
	padding: 30px 32px 28px 32px;
}

.lk.view-maps-rtv .lk-banner .lk-slot
{
	width: 100%;
	height: 262px;
	margin: 0px;
}

/* "9" then "/ 12": the count and its unit share a line whatever their widths. */
.lk.view-maps-rtv .lk-banner .lk-slot .lk-text
{
	width: 100%;
	vertical-align: top;
	margin: 0px;
	flow-children: right-wrap;
}

.lk.view-maps-rtv .lk-banner .lk-type
{
	font-size: 12px;
	color: chudGoldBase;
	letter-spacing: 3px;
}

.lk.view-maps-rtv .lk-banner .lk-name
{
	width: fit-children;
	margin-top: 14px;
	font-family: chudDigitsBold;
	font-size: 104px;
}

.lk.view-maps-rtv .lk-banner .lk-unit
{
	margin: 70px 0px 0px 12px;
	font-family: chudDigitsBold;
	font-size: 44px;
	color: chudStoreFaint;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-maps-rtv .lk-banner .lk-sub
{
	margin-top: 6px;
	font-size: 13px;
	letter-spacing: 2px;
}

.lk.view-maps-rtv .lk-banner .lk-pips
{
	height: 14px;
	vertical-align: top;
	margin-top: 195px;
}

.lk.view-maps-rtv .lk-banner .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 224px 0px 0px 0px;
	font-size: 14px;
	letter-spacing: 1px;
}

/* The voters as name chips. */
.lk.view-maps-rtv .lk-list
{
	padding-right: 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot
{
	width: fit-children;
	height: 24px;
	margin: 0px 6px 6px 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot .lk-text
{
	width: fit-children;
	margin: 0px;
}

.lk.view-maps-rtv .lk-list .lk-name
{
	width: fit-children;
	font-size: 12px;
}

.lk.view-maps-rtv .lk-content .lk-slot.section
{
	width: 100%;
	height: 22px;
	margin: 0px 0px 8px 0px;
}

.lk.view-maps-rtv .lk-content .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

.lk.view-maps-rtv .lk-content .lk-slot.section .lk-text
{
	margin: 0px;
}

.lk.view-maps-rtv .lk-list .lk-slot.section .lk-name
{
	font-size: 10px;
	color: chudStoreText;
	letter-spacing: 2px;
}

/* The player's own state, then the action, at the panel's foot. */
.lk.view-maps-rtv .lk-foot
{
	flow-children: down;
}

.lk.view-maps-rtv .lk-foot .lk-slot
{
	height: 26px;
	margin: 0px;
}

.lk.view-maps-rtv .lk-foot .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 0px;
}

.lk.view-maps-rtv .lk-foot .tone-good .lk-glyph
{
	wash-color: chudSuccessBase;
}

.lk.view-maps-rtv .lk-foot .lk-slot .lk-text
{
	margin-left: 24px;
}

.lk.view-maps-rtv .lk-foot .lk-name
{
	font-family: chudFontMedium;
	font-size: 13px;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rtv .lk-foot .tone-good .lk-name
{
	color: chudSuccessBase;
}

.lk.view-maps-rtv .lk-foot .kind-action
{
	height: 46px;
	margin-top: 12px;
}

.lk.view-maps-rtv .lk-foot .kind-action .lk-text
{
	width: fit-children;
	horizontal-align: center;
	margin-left: 0px;
}

.lk.view-maps-rtv .lk-foot .kind-action .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	letter-spacing: 2px;
}

/* The side: the nominations in one box, the facts in another under it. */
.lk.view-maps-rtv .lk-detail__box,
.lk.view-maps-rtv .lk-detail__body
{
	height: fit-children;
}

.lk.view-maps-rtv.chud-rewind .lk-detail__items
{
	height: fit-children;
	overflow: squish squish;
}

.lk.view-maps-rtv .lk-detail__body
{
	padding: 16px;
}

.lk.view-maps-rtv .lk-detail .lk-slot.section .lk-name
{
	color: chudGoldBase;
}

/* The count at the box's right edge. */
.lk.view-maps-rtv .lk-detail .lk-slot.section .lk-text
{
	width: fill-parent-flow( 1.0 );
}

.lk.view-maps-rtv .grp-nomination
{
	height: 54px;
	margin-bottom: 6px;
}

.lk.view-maps-rtv .grp-nomination .lk-thumb
{
	width: 96px;
	height: 100%;
	margin: 0px;
	background-size: 100% 100%;
}

.lk.view-maps-rtv .grp-nomination .lk-logo
{
	width: 18px;
	height: 18px;
	margin: 6px 0px 0px 6px;
}

.lk.view-maps-rtv .grp-nomination .lk-mark
{
	width: 96px;
	height: 100%;
}

.lk.view-maps-rtv .grp-nomination .lk-mark__text
{
	margin: 0px 6px -6px 0px;
	font-size: 30px;
}

.lk.view-maps-rtv .grp-nomination .lk-text
{
	width: 180px;
	margin-left: 108px;
}

.lk.view-maps-rtv .grp-nomination .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-maps-rtv .grp-more
{
	height: 40px;
}

.lk.view-maps-rtv .grp-more .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 14px;
	wash-color: chudNavStrong;
}

.lk.view-maps-rtv .grp-more .lk-text
{
	margin-left: 38px;
}

.lk.view-maps-rtv .grp-more .lk-name
{
	font-size: 12px;
	color: chudNavStrong;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-maps-rtv .lk-detail__bar
{
	margin-top: 12px;
	padding: 16px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 44px;
	margin: 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-slot .lk-text
{
	horizontal-align: left;
	vertical-align: top;
	margin: 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-end
{
	horizontal-align: left;
	vertical-align: top;
	margin: 18px 0px 0px 0px;
}

.lk.view-maps-rtv .lk-detail__bar .lk-value
{
	font-family: chudFontBody;
	font-size: 22px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
}
