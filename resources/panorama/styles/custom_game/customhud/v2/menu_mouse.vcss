/* Generated by scripts/generate-v2-sheets.ps1 from menu_mouse.vcss in the store palette. Do not edit. */

/*
	Mouse menu (locker grid). Ids and classes mirror Profiles.Mouse in
	config.example.jsonc. Requires customhud_tokens.vcss. Tiles are hover-driven:
	the composer never sets "selected" in Mouse mode.
*/

.chud-root
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.chud-locker
{
	width: 550px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: center;
	padding: 16px 20px 12px 20px;
	flow-children: down;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreRaised ), to( chudStoreDeep ) );
	/* Panorama draws every side of a panel in one colour, so the frame is all accent. */
	border-top: 2px solid chudNavBase;
	border-right: 1px solid chudNavBase;
	border-bottom: 1px solid chudNavBase;
	border-left: 1px solid chudNavBase;
	border-radius: 6px;
	box-shadow: fill chudShadowDrop 0px 8px 24px 0px;
	opacity: 1;
	transform: translateY( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.2s;
	transition-timing-function: ease-in-out;
}

.chud-locker.hidden
{
	opacity: 0;
	transform: translateY( 12px );
}

.chud-locker__header
{
	width: 100%;
	flow-children: down;
}

/* Eyebrow: the gold caption over a title: the grid's heading, a hero's name, a form's title. */
.chud-locker__eyebrow,
.lk.view-shop-product .lk-banner .lk-type,
.lk.view-ranks-rank .lk-banner .lk-type,
.lk.view-admins-votes .lk-banner .lk-type,
.lk.view-admins-ban .grp-title .lk-name
{
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 3px;
}

.chud-locker__heading
{
	max-width: 508px;
	font-family: chudFontBody;
	font-size: 26px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* An accent rule that fades out: the header's one splash of colour. */
.chud-locker__divider
{
	width: 100%;
	height: 1px;
	margin: 10px 0px 10px 0px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavBase ), color-stop( 0.35, chudStoreEdge ), to( transparent ) );
}

/*
	Height follows hk-tiles-N: ceil(N / 3) lines of 104px (96px tile + 2 x 4px
	margin). Past four lines the default height holds and the tiles scroll; the
	16px beyond the tiles' 492px is the scrollbar gutter.
*/
.chud-locker__grid
{
	width: 508px;
	height: 416px;
	overflow: clip scroll;
	transition-property: height;
	transition-duration: 0.15s;
	transition-timing-function: ease-in-out;
}

.chud-locker__items
{
	width: 492px;
	flow-children: down;
}

/* The renderer's scroll rewind (LayoutClasses.Rewind): for three ticks after a new list replaces
   the last, the items measure 1px and draw past it, so the offset clamps to the top with the new
   tiles already showing. */
.chud-locker.chud-rewind .chud-locker__items
{
	height: 1px;
	overflow: squish noclip;
}

/*
	Lines are explicit panels, not one right-wrap flow: wrap moves a line's last
	child down on an exact fit like this one (3 x 164px = 492px). A line never
	wraps, and its default overflow: squish absorbs any rounding.
*/
.chud-locker__line
{
	width: 100%;
	flow-children: right;
}

/* layout-position: fixed keeps the bar in place while the content scrolls under it. */
.chud-scroll VerticalScrollBar
{
	width: 6px;
	height: 100%;
	horizontal-align: right;
	vertical-align: center;
	margin: 4px 2px;
	border-radius: 3px;
	background-color: chudStoreRow;
	layout-position: fixed;
	z-index: 2;
}

.chud-scroll VerticalScrollBar .ScrollThumb
{
	width: 6px;
	min-height: 32px;
	border-radius: 3px;
	background-color: chudNavBase;
	opacity: 0.7;
	transition-property: opacity;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.chud-scroll VerticalScrollBar:hover .ScrollThumb,
.chud-scroll VerticalScrollBar:active .ScrollThumb
{
	opacity: 1;
}

.chud-locker__grid.hk-tiles-1 { height: 104px; }
.chud-locker__grid.hk-tiles-2 { height: 104px; }
.chud-locker__grid.hk-tiles-3 { height: 104px; }
.chud-locker__grid.hk-tiles-4 { height: 208px; }
.chud-locker__grid.hk-tiles-5 { height: 208px; }
.chud-locker__grid.hk-tiles-6 { height: 208px; }
.chud-locker__grid.hk-tiles-7 { height: 312px; }
.chud-locker__grid.hk-tiles-8 { height: 312px; }
.chud-locker__grid.hk-tiles-9 { height: 312px; }
.chud-locker__grid.hk-tiles-10 { height: 416px; }
.chud-locker__grid.hk-tiles-11 { height: 416px; }
.chud-locker__grid.hk-tiles-12 { height: 416px; }

.chud-tile
{
	width: 156px;
	height: 96px;
	margin: 4px;
	flow-children: none;
	transition-property: background-color, border, opacity;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.chud-tile.hidden
{
	visibility: collapse;
}

.chud-tile.disabled
{
	opacity: 0.4;
}

.chud-tile__rarity
{
	width: 100%;
	height: 100%;
	border-radius: 4px;
	border-bottom: 3px solid chudRarity01;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint01 ) );
}

.chud-tile__rarity.hidden
{
	visibility: collapse;
}

.chud-tile__rarity.lvl-1
{
	border-bottom: 3px solid chudRarity01;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint01 ) );
}

.chud-tile__rarity.lvl-2
{
	border-bottom: 3px solid chudRarity02;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint02 ) );
}

.chud-tile__rarity.lvl-3
{
	border-bottom: 3px solid chudRarity03;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint03 ) );
}

.chud-tile__rarity.lvl-4
{
	border-bottom: 3px solid chudRarity04;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint04 ) );
}

.chud-tile__rarity.lvl-5
{
	border-bottom: 3px solid chudRarity05;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint05 ) );
}

.chud-tile__rarity.lvl-6
{
	border-bottom: 3px solid chudRarity06;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint06 ) );
}

.chud-tile__rarity.lvl-7
{
	border-bottom: 3px solid chudRarity07;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint07 ) );
}

.chud-tile__rarity.lvl-8
{
	border-bottom: 3px solid chudRarity08;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint08 ) );
}

.chud-tile__rarity.lvl-9
{
	border-bottom: 3px solid chudRarity09;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint09 ) );
}

.chud-tile__rarity.lvl-10
{
	border-bottom: 3px solid chudRarity10;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( transparent ), color-stop( 0.45, transparent ), to( chudTint10 ) );
}

.chud-tile__name
{
	width: 132px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 12px 27px 12px;
	font-family: chudFontMedium;
	font-size: 15px;
	color: chudTextMain;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.chud-tile.danger .chud-tile__name
{
	color: chudDangerBase;
}

.chud-tile__value
{
	width: 132px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 12px 11px 12px;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 1px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* The bar=N meter (menu.vcss) runs under the value, inside the rarity edge. */
.chud-tile .chud-meter
{
	width: 132px;
	horizontal-align: left;
	vertical-align: bottom;
	margin: 0px 12px 6px 12px;
}

.chud-tile.chosen .chud-tile__name
{
	color: chudNavStrong;
}

.chud-locker.hk-scale-80 { ui-scale: 80%; }
.chud-locker.hk-scale-90 { ui-scale: 90%; }
.chud-locker.hk-scale-100 { ui-scale: 100%; }
.chud-locker.hk-scale-110 { ui-scale: 110%; }
.chud-locker.hk-scale-125 { ui-scale: 125%; }
.chud-locker.hk-scale-150 { ui-scale: 150%; }

/* ---- Tile: a card in a grid, the same in every mouse layout ----
   The generic grid (chud-tile), WeaponSkins (ws-card) and the plugin pages' card
   views all draw it from here; a plugin view joins by adding its selector. Only
   tiles you can pick react to the pointer: a static tile lists its :hover here too. */

.chud-tile,
.ws-card,
.lk.view-shop-categories .lk-list .lk-hit,
.lk.view-shop-grid .lk-list .lk-hit,
.lk.view-maps-board .lk-list .lk-hit,
.lk.view-maps-pool .lk-list .lk-hit,
.lk.view-ranks-stats .lk-list .lk-hit,
.lk.view-ranks-stats .lk-list .lk-hit:hover,
.lk.view-ranks-weapons .lk-list .lk-hit,
.lk.view-ranks-weapons .lk-list .lk-hit:hover,
.lk.view-vip-perks .lk-list .lk-hit,
.lk.view-vip-options .grp-fov .lk-hit,
.lk.view-vip-guns .lk-list .kind-action .lk-hit,
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier .lk-hit
{
	border: 1px solid chudStoreEdge;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileBase ), to( chudStoreTileDeep ) );
}

.chud-tile:hover,
.ws-card:hover,
.lk.view-shop-categories .lk-list .lk-hit:hover,
.lk.view-shop-grid .lk-list .lk-hit:hover,
.lk.view-maps-board .lk-list .lk-hit:hover,
.lk.view-maps-pool .lk-list .lk-hit:hover,
.lk.view-vip-perks .lk-list .lk-hit:hover,
.lk.view-vip-options .grp-fov .lk-hit:hover,
.lk.view-vip-guns .lk-list .kind-action .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier .lk-hit:hover
{
	border: 1px solid chudNavBase;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileHover ), to( chudStoreTileBase ) );
	box-shadow: fill chudNavSoft 0px 0px 10px 0px;
}

/* The player's own pick: a heavier edge. Plugin tiles name .lk-list so they outrank
   the list's chosen fill in locker.vcss, which is included after this sheet. */
.chud-tile.chosen,
.ws-card.chosen,
.ws-card.chosen:hover,
.lk.view-shop-grid .lk-list .lk-slot.chosen .lk-hit,
.lk.view-shop-grid .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-maps-pool .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-pool .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-vip-options .lk-list .grp-fov.chosen .lk-hit,
.lk.view-vip-options .lk-list .grp-fov.chosen .lk-hit:hover,
.lk.view-vip-guns .lk-list .kind-action.chosen .lk-hit,
.lk.view-vip-guns .lk-list .kind-action.chosen .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier.chosen .lk-hit,
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier.chosen .lk-hit:hover
{
	border: 2px solid chudNavBase;
}

.lk.view-shop-grid .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit,
.lk.view-maps-pool .lk-list .lk-slot.chosen .lk-hit,
.lk.view-vip-options .lk-list .grp-fov.chosen .lk-hit,
.lk.view-vip-guns .lk-list .kind-action.chosen .lk-hit
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileBase ), to( chudStoreTileDeep ) );
}

.lk.view-shop-grid .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-maps-board .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-maps-pool .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-vip-options .lk-list .grp-fov.chosen .lk-hit:hover,
.lk.view-vip-guns .lk-list .kind-action.chosen .lk-hit:hover
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileHover ), to( chudStoreTileBase ) );
}

/* ---- Locker chrome: the sidebar, footer and nav buttons of both lockers ----
   menu_skins_mouse (WeaponSkins, ws-*) and menu_locker (plugin pages, lk-*) both
   include this sheet, so the frame they share is written once, here. */

.ws-sidebar,
.lk-side
{
	width: 194px;
	height: 100%;
	margin-right: 16px;
	padding-right: 12px;
	border-right: 1px solid chudStoreEdge;
	flow-children: down;
}

.ws-category,
.lk-category
{
	width: 100%;
	height: 34px;
	margin-bottom: 4px;
	padding: 0px 10px;
	border-left: 3px solid transparent;
	border-radius: 3px;
	background-color: chudStoreRow;
	flow-children: right;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

/* Size and colour only; customhud_icons.vcss picks the art. */
.ws-category .chud-ico,
.lk-category .chud-ico
{
	width: 22px;
	height: 18px;
	margin-right: 10px;
	vertical-align: center;
	wash-color: chudStoreText;
	transition-property: wash-color;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.ws-category Label,
.lk-category__label
{
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 13px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.ws-category:hover,
.lk-category:hover
{
	border-left: 3px solid chudNavBase;
	background-color: chudStoreHover;
}

.ws-category:hover Label,
.lk-category:hover .lk-category__label
{
	color: chudTextMain;
}

.ws-category:hover .chud-ico,
.lk-category:hover .chud-ico
{
	wash-color: chudTextMain;
}

/* The page the player is on, at any depth below it: a dim accent fill under a bright edge. */
.ws-category.selected,
.lk-category.selected
{
	border-left: 3px solid chudNavBase;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavDim ), to( chudNavSoft ) );
}

.ws-category.selected Label,
.lk-category.selected .lk-category__label
{
	font-family: chudFontBody;
	font-weight: bold;
	color: chudTextMain;
}

.ws-category.selected .chud-ico,
.ws-category.selected:hover .chud-ico,
.lk-category.selected .chud-ico,
.lk-category.selected:hover .chud-ico
{
	wash-color: chudNavStrong;
}

.ws-category.disabled,
.lk-category.disabled
{
	opacity: 0.35;
}

.ws-category.hidden,
.lk-category.hidden
{
	visibility: collapse;
}

/* A root-menu DividerComponent: the slot shrinks to a rule. */
.ws-category.divider,
.ws-category.divider:hover,
.lk-category.divider,
.lk-category.divider:hover
{
	height: 1px;
	margin: 7px 0px 10px 0px;
	padding: 0px;
	border-left: 0px solid transparent;
	border-radius: 0px;
	background-color: chudStoreEdge;
}

.ws-category.divider Label,
.ws-category.divider .chud-ico,
.lk-category.divider Label,
.lk-category.divider .chud-ico
{
	visibility: collapse;
}

/* Footer buttons take a nav item's size: 34px tall. */
.ws-bar,
.lk-bar
{
	height: 44px;
}

.ws-locker .chud-nav,
.lk .chud-nav
{
	width: 52px;
	height: 34px;
	border-radius: 3px;
}

.ws-locker .chud-nav Label,
.lk .chud-nav Label
{
	font-size: 17px;
	color: chudTextMain;
}

.ws-locker .chud-nav--close,
.lk .chud-nav--close,
.ls .chud-nav--close
{
	background-color: chudDangerSoft;
	border: 1px solid chudDangerBase;
}

.ws-locker .chud-nav--close:hover,
.lk .chud-nav--close:hover,
.ls .chud-nav--close:hover
{
	background-color: chudDangerDim;
	border: 1px solid chudDangerBase;
}