/* Generated by scripts/generate-v2-sheets.ps1 from menu.vcss in the store palette. Do not edit. */

/*
	Default menu (Wasd / Buttons / Numbers). Ids and classes mirror
	Profiles.Default in config.example.jsonc. Requires customhud_tokens.vcss.
*/

.chud-root
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.chud-menu
{
	width: 420px;
	height: fit-children;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 40px;
	padding: 12px 12px 10px 12px;
	flow-children: down;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreRaised ), to( chudStoreDeep ) );
	/* Panorama draws every side of a panel in one colour, so the accent edge is the only border. */
	border-left: 3px solid chudNavBase;
	border-radius: 4px;
	box-shadow: fill chudShadowDim 0px 3px 9px 0px;
	opacity: 1;
	transform: translateX( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.18s;
	transition-timing-function: ease-in-out;
}

.chud-menu.hidden
{
	opacity: 0;
	transform: translateX( -12px );
}

.chud-menu__title
{
	width: 100%;
	flow-children: right;
	margin-bottom: 10px;
	padding-bottom: 8px;
	border-bottom: 1px solid chudStoreEdge;
}

.chud-menu__heading
{
	width: 100%;
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* Height follows hk-rows-N (one 38px pitch per visible row) so it can transition. */
.chud-menu__options
{
	width: 100%;
	height: 38px;
	flow-children: down;
	overflow: clip;
	transition-property: height;
	transition-duration: 0.15s;
	transition-timing-function: ease-in-out;
}

.chud-menu__options.hk-rows-1 { height: 38px; }
.chud-menu__options.hk-rows-2 { height: 76px; }
.chud-menu__options.hk-rows-3 { height: 114px; }
.chud-menu__options.hk-rows-4 { height: 152px; }
.chud-menu__options.hk-rows-5 { height: 190px; }
.chud-menu__options.hk-rows-6 { height: 228px; }
.chud-menu__options.hk-rows-7 { height: 266px; }
.chud-menu__options.hk-rows-8 { height: 304px; }
.chud-menu__options.hk-rows-9 { height: 342px; }
.chud-menu__options.hk-rows-10 { height: 380px; }
.chud-menu__options.hk-rows-11 { height: 418px; }
.chud-menu__options.hk-rows-12 { height: 456px; }
.chud-menu__options.hk-rows-13 { height: 494px; }
.chud-menu__options.hk-rows-14 { height: 532px; }
.chud-menu__options.hk-rows-15 { height: 570px; }
.chud-menu__options.hk-rows-16 { height: 608px; }
.chud-menu__options.hk-rows-17 { height: 646px; }
.chud-menu__options.hk-rows-18 { height: 684px; }
.chud-menu__options.hk-rows-19 { height: 722px; }
.chud-menu__options.hk-rows-20 { height: 760px; }

.chud-row
{
	width: 100%;
	height: 34px;
	margin-bottom: 4px;
	flow-children: right;
	background-color: chudStoreRow;
	border-radius: 3px;
	transition-property: background-color, opacity;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.chud-row.hidden
{
	visibility: collapse;
}

.chud-row:hover
{
	background-color: chudStoreHover;
}

/* After :hover, so the cursor row keeps its glow under the mouse too. */
.chud-row.selected
{
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavSoft ), to( chudNavFade ) );
}

.chud-row.disabled
{
	opacity: 0.4;
}

.chud-row__bar
{
	width: 3px;
	height: 100%;
	background-color: transparent;
	border-radius: 3px 0px 0px 3px;
}

.chud-row.selected .chud-row__bar
{
	background-color: chudNavBase;
}

.chud-row.danger .chud-row__bar
{
	background-color: chudDangerBase;
}

.chud-row__key
{
	width: 24px;
	margin-left: 5px;
	vertical-align: center;
	font-family: chudDigitsBold;
	font-size: 13px;
	color: chudStoreFaint;
	text-align: center;
}

.chud-row.selected .chud-row__key
{
	color: chudNavBase;
}

.chud-row__clip
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin-left: 5px;
	flow-children: none;
	overflow: clip;
}

.chud-row__label
{
	width: 100%;
	vertical-align: center;
	font-family: chudFontBody;
	font-size: 15px;
	color: chudTextMain;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.chud-row.selected .chud-row__label
{
	font-weight: bold;
}

.chud-row.danger .chud-row__label
{
	color: chudDangerBase;
}

/* Marquee: the label grows to its text and slides inside the clip. Keyframes stay
   in this sheet; cross-sheet keyframe lookup is untested. */
@keyframes 'chud-marquee'
{
	0%
	{
		transform: translateX( 0px );
	}

	100%
	{
		transform: translateX( -140px );
	}
}

.chud-row.marquee .chud-row__label
{
	width: fit-children;
	text-overflow: noclip;
	animation-name: chud-marquee;
	animation-duration: 4s;
	animation-timing-function: linear;
	animation-iteration-count: infinite;
	animation-direction: alternate;
}

.chud-row__value
{
	max-width: 150px;
	margin: 0px 10px 0px 8px;
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 14px;
	color: chudGoldBase;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.chud-row.disabled .chud-row__value
{
	color: chudDangerBase;
}

.chud-row__icon
{
	width: 8px;
	height: 8px;
	margin-right: 12px;
	vertical-align: center;
	border-radius: 50%;
	background-color: chudRarity01;
}

.chud-row__icon.hidden
{
	visibility: collapse;
}

.chud-row__icon.lvl-1 { background-color: chudRarity01; }
.chud-row__icon.lvl-2 { background-color: chudRarity02; }
.chud-row__icon.lvl-3 { background-color: chudRarity03; }
.chud-row__icon.lvl-4 { background-color: chudRarity04; }
.chud-row__icon.lvl-5 { background-color: chudRarity05; }
.chud-row__icon.lvl-6 { background-color: chudRarity06; }
.chud-row__icon.lvl-7 { background-color: chudRarity07; }
.chud-row__icon.lvl-8 { background-color: chudRarity08; }
.chud-row__icon.lvl-9 { background-color: chudRarity09; }
.chud-row__icon.lvl-10 { background-color: chudRarity10; }

/* bar=N: a meter filled to N%, such as one map's share of a vote. Lists draw it under the name. */
.chud-meter
{
	height: 3px;
	border-radius: 2px;
	background-color: chudStoreEdge;
	visibility: collapse;
}

.has-bar .chud-meter
{
	visibility: visible;
}

.chud-meter__fill
{
	width: 0%;
	height: 100%;
	border-radius: 2px;
	background-color: chudInfoBase;
	transition-property: width;
	transition-duration: 0.2s;
	transition-timing-function: ease-in-out;
}

.chud-row .chud-meter
{
	width: 100%;
	vertical-align: bottom;
	margin-bottom: 4px;
}

/* One count width, so every meter in the list ends at the same x. */
.chud-row.has-bar .chud-row__value
{
	min-width: 28px;
	text-align: right;
}

/* chosen: the player's own pick, such as their vote in a tally. */
.chud-row.chosen .chud-row__label
{
	color: chudNavStrong;
	font-weight: bold;
}

.chosen .chud-meter__fill
{
	background-color: chudNavBase;
}

.bar-0 .chud-meter__fill { width: 0%; }
.bar-1 .chud-meter__fill { width: 1%; }
.bar-2 .chud-meter__fill { width: 2%; }
.bar-3 .chud-meter__fill { width: 3%; }
.bar-4 .chud-meter__fill { width: 4%; }
