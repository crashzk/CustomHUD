.chud-menu__footer
{
	width: 100%;
	margin-top: 6px;
	font-family: chudFontBody;
	font-size: 11px;
	color: chudStoreFaint;
	text-transform: uppercase;
	letter-spacing: 2px;
	text-align: center;
}

/* Shared by list and mouse layouts; FrameComposer hides the controls in keyboard modes. */
.chud-bar
{
	width: 100%;
	height: 48px;
	margin-top: 8px;
	padding-top: 8px;
	flow-children: right;
	border-top: 1px solid chudStoreEdge;
}

.chud-bar__hint
{
	width: fill-parent-flow(1.0);
	vertical-align: center;
	margin: 0px 12px;
	font-family: chudFontBody;
	font-size: 11px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 2px;
	text-align: center;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.chud-bar--list
{
	height: fit-children;
	margin-top: 8px;
	padding-top: 0px;
	border-top: 0px solid transparent;
}

.chud-bar--list .chud-menu__footer
{
	width: fill-parent-flow(1.0);
	vertical-align: center;
	margin-top: 0px;
}

/* Only on a menu with more than one page: FrameComposer writes "{0} / {1}". */
.chud-bar__page
{
	vertical-align: center;
	margin: 0px 2px 0px 12px;
	font-family: chudDigitsBold;
	font-size: 12px;
	color: chudInfoBase;
	letter-spacing: 1px;
	white-space: nowrap;
}

.chud-bar__page.hidden
{
	visibility: collapse;
}

.chud-nav
{
	height: 34px;
	vertical-align: center;
	background-color: chudStoreRow;
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	transition-property: background-color, border-color;
	transition-duration: 0.12s;
}

.chud-nav:hover
{
	background-color: chudStoreHover;
	border: 1px solid chudNavBase;
}

.chud-nav Label
{
	horizontal-align: center;
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 18px;
	color: chudNavStrong;
}

.chud-nav--back
{
	width: 64px;
	background-color: chudNavSoft;
	border: 1px solid chudNavBase;
}

.chud-nav--back:hover
{
	background-color: chudNavDim;
}

.chud-nav--back Label
{
	font-size: 20px;
	color: chudTextMain;
}

.chud-nav--page
{
	width: 40px;
	margin-left: 6px;
}

.chud-nav.hidden
{
	visibility: collapse;
}

.chud-menu.hk-scale-80 { ui-scale: 80%; }
.chud-menu.hk-scale-90 { ui-scale: 90%; }
.chud-menu.hk-scale-100 { ui-scale: 100%; }
.chud-menu.hk-scale-110 { ui-scale: 110%; }
.chud-menu.hk-scale-125 { ui-scale: 125%; }
.chud-menu.hk-scale-150 { ui-scale: 150%; }
