/* Generated by scripts/generate-v2-sheets.ps1 from hud_text.vcss in the store palette. Do not edit. */

/*
	Captured native HUD text (NativeText Default / Center profiles). The shell
	carries kind-<name> for the TextMsg destination. Requires customhud_tokens.vcss.
*/

.chud-root
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.chud-toast
{
	width: fit-children;
	height: fit-children;
	max-width: 760px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 200px;
	padding: 10px 18px 10px 16px;
	background-color: chudStoreDeep;
	border-left: 3px solid chudNavBase;
	border-radius: 4px;
	box-shadow: fill chudShadowDrop 0px 0px 8px 0px;
	opacity: 1;
	transform: translateY( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.18s;
	transition-timing-function: ease-in-out;
}

.chud-toast.hidden
{
	opacity: 0;
	transform: translateY( -8px );
}

.chud-toast__text
{
	max-width: 724px;
	font-family: chudFontBody;
	font-size: 20px;
	color: chudTextMain;
	white-space: normal;
	text-align: left;
	text-shadow: 1px 1px 2px 2 chudShadowText;
}

.chud-toast.kind-notify .chud-toast__text
{
	color: chudNavStrong;
}

.chud-toast.kind-center .chud-toast__text
{
	color: chudTextCream;
	text-align: center;
}

.chud-toast.kind-chat
{
	border-left: 3px solid chudStoreFaint;
}

.chud-toast.kind-chat .chud-toast__text
{
	color: chudStoreText;
}

.chud-toast.kind-chatendofround
{
	border-left: 3px solid chudGoldBase;
}

.chud-toast.kind-chatendofround .chud-toast__text
{
	color: chudGoldBase;
}

.chud-toast.kind-console .chud-toast__text
{
	font-family: chudFontMono;
	font-size: 17px;
}

.chud-toast.kind-alert
{
	border-left: 3px solid chudDangerBase;
}

.chud-toast.kind-alert .chud-toast__text
{
	color: chudDangerBase;
	text-transform: uppercase;
}
