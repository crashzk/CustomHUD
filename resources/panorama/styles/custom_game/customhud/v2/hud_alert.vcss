/* Generated by scripts/generate-v2-sheets.ps1 from hud_alert.vcss in the store palette. Do not edit. */

/*
	Captured native alerts (NativeText Alert profile). Same ids and kind classes as
	hud_text, bigger and louder. Requires customhud_tokens.vcss.
*/

.chud-root
{
	width: 100%;
	height: 100%;
	flow-children: none;
}

.chud-alert
{
	width: fit-children;
	height: fit-children;
	max-width: 900px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 140px;
	padding: 12px 28px 12px 28px;
	background-color: chudStoreDeep;
	border-top: 2px solid chudNavBase;
	border-bottom: 2px solid chudNavBase;
	box-shadow: fill chudShadowDrop 0px 0px 10px 0px;
	opacity: 1;
	transform: translateY( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.2s;
	transition-timing-function: ease-in-out;
}

.chud-alert.hidden
{
	opacity: 0;
	transform: translateY( -10px );
}

.chud-alert__text
{
	max-width: 844px;
	font-family: chudFontMedium;
	font-size: 28px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: normal;
	text-align: center;
	text-shadow: 1px 1px 2px 2 chudShadowText;
}

.chud-alert.kind-notify .chud-alert__text
{
	color: chudNavStrong;
}

.chud-alert.kind-center .chud-alert__text
{
	color: chudTextCream;
}

.chud-alert.kind-chat .chud-alert__text
{
	color: chudStoreText;
}

.chud-alert.kind-chatendofround
{
	border-top: 2px solid chudGoldBase;
	border-bottom: 2px solid chudGoldBase;
}

.chud-alert.kind-console .chud-alert__text
{
	font-family: chudFontMono;
}

.chud-alert.kind-alert
{
	border-top: 2px solid chudDangerBase;
	border-bottom: 2px solid chudDangerBase;
}

.chud-alert.kind-alert .chud-alert__text
{
	color: chudDangerBase;
}
