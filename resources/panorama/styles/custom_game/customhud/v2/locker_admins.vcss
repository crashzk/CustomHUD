/* ---- admins-votes: the running vote in one panel, the preview and the kinds beside ---- */

.lk.view-admins-votes .lk-detail
{
	width: 368px;
	margin-left: 16px;
}

.lk.view-admins-votes .lk-col
{
	padding: 22px 24px;
