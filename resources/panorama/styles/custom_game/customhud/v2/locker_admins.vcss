	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

/* The share is the fill and the count; the leader needs no tag. */
.lk.view-admins-votes .lk-list .lk-tags
{
	visibility: collapse;
}

.lk.view-admins-votes .lk-list .lk-meter
{
	width: 100%;
	height: 100%;
	horizontal-align: left;
	vertical-align: top;
	margin: 0px;
