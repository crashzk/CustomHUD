.lk.view-admins-bans .lk-col-head-0 { width: 50px; }
.lk.view-admins-bans .lk-col-head-1 { width: 194px; }
.lk.view-admins-bans .lk-col-head-2 { width: 132px; }

.lk.view-admins-bans .lk-list .lk-slot
{
	height: 46px;
	margin: 4px 0px 0px 0px;
}

/* A record that has ended stays listed, a step back from the live ones. */
