	font-weight: bold;
	color: chudTextMain;
}

.lk.view-admins-players .lk-detail .lk-slot.section,
.lk.view-admins-player .lk-detail .lk-slot.section,
.lk.view-admins-bans .lk-detail .lk-slot.section,
.lk.view-admins-record .lk-detail .lk-slot.section
