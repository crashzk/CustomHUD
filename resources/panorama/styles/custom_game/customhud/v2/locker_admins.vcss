}

.lk.view-admins-votes .lk-list .lk-note
{
	margin-right: 18px;
	font-size: 13px;
	letter-spacing: 0px;
}

/* Turnout, who goes, and the two decisions. */
.lk.view-admins-votes .lk-foot
