	font-size: 15px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-admins-player .lk-list .grp-group .lk-sub
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 12px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-admins-player .lk-list .grp-group .lk-chev
{
	visibility: visible;
}

/* Actions: three tiles to a line, 3 x (133 + 6) = 417 of the list's 452 (466 less its gutter). */
.lk.view-admins-player .lk-list .grp-action
{
	width: 133px;
	height: 72px;
	margin: 0px 6px 6px 0px;
}

.lk.view-admins-player .lk-list .grp-action .lk-glyph
{
	width: 22px;
	height: 22px;
	horizontal-align: center;
	vertical-align: top;
	margin: 14px 0px 0px 0px;
	wash-color: chudTextMain;
}

.lk.view-admins-player .lk-list .grp-action.danger .lk-glyph { wash-color: chudDangerStrong; }
.lk.view-admins-player .lk-list .grp-action.chosen .lk-glyph { wash-color: chudNavStrong; }

.lk.view-admins-player .lk-list .grp-action .lk-text
{
	width: 100%;
	vertical-align: bottom;
	margin: 0px 0px 12px 0px;
}

.lk.view-admins-player .lk-list .grp-action .lk-name
{
	font-family: chudFontBody;
	font-size: 10px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* Their record, newest first: what and how long, the reason, by whom and when. */
.lk.view-admins-player .lk-list .grp-record
{
	height: 40px;
	margin-bottom: 4px;
}

.lk.view-admins-player .lk-list .grp-record .lk-text
{
	width: 112px;
	margin-left: 12px;
}

.lk.view-admins-player .lk-list .grp-record .lk-name
{
	font-family: chudFontBody;
	font-size: 11px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-admins-player .lk-list .grp-record.tone-bad .lk-name { color: chudDangerStrong; }
.lk.view-admins-player .lk-list .grp-record.tone-faint .lk-name { color: chudStoreText; }

.lk.view-admins-player .lk-list .grp-record .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 128px;
}

.lk.view-admins-player .lk-list .grp-record .lk-tag
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
