{
	width: 80px;
	margin-left: 38px;
}

.lk.view-admins-ban .grp-pick2.has-glyph .lk-text
{
	width: 206px;
	margin-left: 40px;
}

.lk.view-admins-ban .grp-pick2 .lk-name
{
	text-overflow: ellipsis;
}

.lk.view-admins-ban .grp-pick .lk-glyph,
.lk.view-admins-ban .grp-pick2 .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 14px;
}

.lk.view-admins-ban .grp-length .lk-name,
.lk.view-admins-ban .grp-pick .lk-name,
.lk.view-admins-ban .grp-pick2 .lk-name,
.lk.view-admins-ban .grp-wide .lk-name
{
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-admins-ban .grp-pick.has-glyph .lk-name,
.lk.view-admins-ban .grp-pick2.has-glyph .lk-name
{
	text-align: left;
}

/* Permanent: the whole line, in red. */
.lk.view-admins-ban .grp-wide
{
	width: 526px;
	height: 46px;
	margin: 0px 0px 6px 0px;
}

.lk.view-admins-ban .lk-list .grp-wide .lk-hit
{
	border: 1px solid chudDangerDim;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerSoft ), to( chudStoreRow ) );
}

.lk.view-admins-ban .grp-wide .lk-name,
.lk.view-admins-ban .lk-list .grp-wide.danger .lk-name
{
	color: chudDangerStrong;
}

.lk.view-admins-ban .grp-wide .lk-glyph
{
	width: 14px;
	height: 14px;
	horizontal-align: center;
	margin: 0px 110px 0px 0px;
	wash-color: chudDangerStrong;
}

/* What the player will read, as a quote. */
.lk.view-admins-ban .grp-quote
{
	width: 526px;
	height: 120px;
	margin: 14px 0px 0px 0px;
}

.lk.view-admins-ban .lk-list .grp-quote .lk-hit,
.lk.view-admins-ban .lk-list .grp-quote .lk-hit:hover
{
	border-top: 0px solid chudDangerDim;
	border-right: 0px solid chudDangerDim;
	border-bottom: 0px solid chudDangerDim;
	border-left: 2px solid chudDangerDim;
	background-color: chudShadowSoft;
	box-shadow: none;
}

.lk.view-admins-ban .grp-quote .lk-text
{
	width: 494px;
	vertical-align: top;
	margin: 12px 0px 0px 14px;
}

.lk.view-admins-ban .grp-quote .lk-type
{
	color: chudStoreText;
}

.lk.view-admins-ban .grp-quote .lk-name
{
	margin-top: 6px;
	font-family: chudFontBody;
	font-size: 13px;
}

.lk.view-admins-ban .grp-quote .lk-sub
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 13px;
	color: chudTextMain;
	text-transform: none;
	letter-spacing: 0px;
	white-space: normal;
}

/* The rail: the ban as it stands, its two buttons stacked at the foot. */
.lk.view-admins-ban .grp-title
{
	height: 26px;
}

.lk.view-admins-ban .grp-title .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 0px;
