.lk.view-admins-votes .lk-foot .kind-action .lk-name
{
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-admins-votes .lk-foot .kind-action.danger .lk-name
