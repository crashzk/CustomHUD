	vertical-align: top;
	margin: 24px 0px 0px 12px;
}

/* ---- admins-ban: the steps, the length to pick, the ban as it stands ---- */

/* The stepper spans both columns, so the rail is laid over the body's right edge
   below it instead of beside the column. */
.lk.view-admins-ban .lk-body
{
	flow-children: none;
}

.lk.view-admins-ban .lk-col
{
	width: 100%;
}

.lk.view-admins-ban .lk-list
{
	width: 548px;
}

.lk.view-admins-ban .lk-detail
{
	width: 332px;
	height: 504px;
	horizontal-align: right;
	vertical-align: bottom;
	margin-left: 0px;
}

/* Under a tab strip the body is 42px shorter; the rail still starts below the stepper. */
.lk.has-tabs.view-admins-ban .lk-detail
{
	height: 462px;
}

/* The stepper: five steps, each one's line running on to the next. */
.lk.view-admins-ban .lk-banner
{
	height: 58px;
	margin-bottom: 14px;
	padding: 0px 16px;
}

.lk.view-admins-ban .lk-banner .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin: 0px;
}

/* The last step is narrower and runs on to nothing; a flow can have fewer than five. */
.lk.view-admins-ban #banner_4,
.lk.view-admins-ban .lk-banner .grp-step-last
{
	width: 110px;
}

/* The rarity layer is the step's circle. */
.lk.view-admins-ban .lk-banner .lk-rarity,
.lk.view-admins-ban .lk-banner .lk-rarity.hidden
{
	width: 26px;
	height: 26px;
	horizontal-align: left;
	vertical-align: center;
	border: 1px solid chudStoreEdge;
	border-radius: 13px;
	visibility: visible;
}

.lk.view-admins-ban .lk-banner .tone-good .lk-rarity
{
	border: 1px solid chudSuccessBase;
	background-color: chudSuccessSoft;
}

.lk.view-admins-ban .lk-banner .chosen .lk-rarity
{
	border: 1px solid chudNavBase;
	background-color: chudNavSoft;
}

.lk.view-admins-ban .lk-banner .lk-glyph
{
	width: 12px;
	height: 12px;
	margin-left: 7px;
	wash-color: chudSuccessBase;
}

.lk.view-admins-ban .lk-banner .lk-mark
{
	width: 26px;
	height: 26px;
	margin: 0px;
	background-color: transparent;
}

.lk.view-admins-ban .lk-banner .lk-mark__text
{
	font-family: chudFontBody;
	font-size: 12px;
	color: chudStoreFaint;
}

.lk.view-admins-ban .lk-banner .chosen .lk-mark__text
{
	color: chudTextMain;
}

.lk.view-admins-ban .lk-banner .lk-slot .lk-text
{
	width: 110px;
	margin-left: 35px;
}

.lk.view-admins-ban .lk-banner .lk-name
{
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudStoreFaint;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-admins-ban .lk-banner .tone-good .lk-name { color: chudStoreText; }
.lk.view-admins-ban .lk-banner .chosen .lk-name { color: chudTextMain; }

.lk.view-admins-ban .lk-banner .lk-sub
{
	margin-top: 2px;
	font-size: 12px;
	color: chudTextMain;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-admins-ban .lk-banner .chosen .lk-sub
{
	color: chudNavStrong;
}

/* The line on to the next step: four steps share (864 - 110) px, so each is ~188 wide. */
.lk.view-admins-ban .lk-banner .lk-shade
{
	width: 34px;
	height: 1px;
	horizontal-align: right;
	vertical-align: center;
	margin: 0px 14px 0px 0px;
	background-color: chudStoreEdge;
	visibility: visible;
}

.lk.view-admins-ban .lk-banner .tone-good .lk-shade
{
	background-color: chudSuccessHalf;
}

.lk.view-admins-ban #banner_4 .lk-shade,
.lk.view-admins-ban .lk-banner .grp-step-last .lk-shade
{
	visibility: collapse;
}

/* Lengths and kinds: four to a line, 4 x (126 + 6) = 528 of 548. Reasons and scopes, which
   run longer, two: 2 x (260 + 6) = 532. */
.lk.view-admins-ban .grp-length,
.lk.view-admins-ban .grp-pick
{
	width: 126px;
	height: 46px;
	margin: 0px 6px 6px 0px;
}

.lk.view-admins-ban .grp-pick2
{
	width: 260px;
	height: 46px;
	margin: 0px 6px 6px 0px;
}

.lk.view-admins-ban .grp-length .lk-text,
.lk.view-admins-ban .grp-pick .lk-text,
.lk.view-admins-ban .grp-pick2 .lk-text,
.lk.view-admins-ban .grp-wide .lk-text
{
	width: 100%;
	margin: 0px;
}

/* A chip with a glyph (a kind, a scope) reads from the glyph, left-aligned beside it. */
