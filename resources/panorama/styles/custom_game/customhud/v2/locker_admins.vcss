.lk.view-admins-votes .lk-banner .lk-slot
{
	height: 92px;
	margin: 0px;
}

.lk.view-admins-votes .lk-banner .lk-slot .lk-text
{
	width: 100%;
	vertical-align: top;
	margin: 0px;
}

.lk.view-admins-votes .lk-banner .lk-name
{
	margin-top: 12px;
	font-family: chudFontBody;
	font-size: 32px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* The tallies: each answer's share filling its row. */
.lk.view-admins-votes .lk-list
{
