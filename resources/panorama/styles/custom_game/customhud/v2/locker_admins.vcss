}

/* The side: the poll as players get it, framed like the real one. */
.lk.view-admins-votes .lk-detail .lk-slot.section
{
	height: 22px;
	margin: 16px 0px 8px 0px;
}

.lk.view-admins-votes #detail_0
{
	margin-top: 0px;
}

.lk.view-admins-votes .lk-detail .lk-slot.section .lk-hit
{
