}

.lk.view-admins-votes .grp-outcome .lk-note
{
	width: 250px;
	horizontal-align: left;
	margin: 0px 0px 0px 204px;
	font-family: chudFontBody;
	font-size: 12px;
	color: chudStoreText;
	letter-spacing: 1px;
	white-space: normal;
}

/* End now | Cancel vote, side by side: 2 x 226 + 10 = 462. */
.lk.view-admins-votes .lk-foot .kind-action
{
	width: 226px;
	height: 44px;
	margin: 0px;
}

.lk.view-admins-votes #foot_3
{
	margin-left: 10px;
}

.lk.view-admins-votes .lk-foot .kind-action .lk-text
{
	width: 100%;
	margin: 0px;
