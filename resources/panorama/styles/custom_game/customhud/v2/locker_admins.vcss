}

.lk.view-admins-players .grp-stat .lk-end,
.lk.view-admins-player .grp-stat .lk-end,
.lk.view-admins-bans .grp-field .lk-end,
.lk.view-admins-record .grp-field .lk-end
{
	horizontal-align: left;
	vertical-align: top;
	margin: 24px 0px 0px 0px;
}

.lk.view-admins-players .grp-stat .lk-value,
.lk.view-admins-player .grp-stat .lk-value,
.lk.view-admins-player .grp-playtime .lk-value,
.lk.view-admins-player .grp-playtime-end .lk-value,
