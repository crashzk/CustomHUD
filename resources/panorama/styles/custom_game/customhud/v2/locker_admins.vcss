	background-color: chudStoreRow;
	visibility: visible;
}

.lk.view-admins-votes .grp-answer.chosen .lk-rarity
{
	border-left: 2px solid chudNavBase;
	background-color: chudStoreHover;
}

.lk.view-admins-votes .grp-answer .lk-mark
{
	width: 20px;
	margin-left: 26px;
	background-color: transparent;
}

.lk.view-admins-votes .grp-answer .lk-mark__text
{
	font-size: 12px;
	color: chudStoreFaint;
}

.lk.view-admins-votes .grp-answer .lk-text
{
	margin-left: 50px;
}

.lk.view-admins-votes .grp-answer .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-admins-votes .grp-hint
{
	height: 30px;
	margin: 0px;
}

/* A hint without an icon is the preview's footnote and closes its frame; the one
   after the vote kinds carries an icon and stays plain. */
.lk.view-admins-votes .grp-hint .lk-hit,
.lk.view-admins-votes .grp-hint .lk-hit:hover
{
	border-top: 0px solid chudNavBase;
	border-right: 1px solid chudNavBase;
	border-bottom: 1px solid chudNavBase;
	border-left: 1px solid chudNavBase;
	border-radius: 0px 0px 6px 6px;
	background-color: chudStoreRaised;
}

.lk.view-admins-votes .grp-hint .lk-text
{
	width: 100%;
	margin: 0px;
}

.lk.view-admins-votes .grp-hint .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreFaint;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-admins-votes .grp-hint.has-glyph .lk-name
{
	text-align: left;
}

.lk.view-admins-votes .grp-hint.has-glyph .lk-glyph
{
	width: 12px;
	height: 12px;
	margin-left: 0px;
	wash-color: chudStoreFaint;
}

.lk.view-admins-votes .grp-hint.has-glyph .lk-text
{
	margin-left: 19px;
}

.lk.view-admins-votes .grp-kind
{
	height: 54px;
	margin-bottom: 6px;
}

.lk.view-admins-votes .grp-kind .lk-glyph
{
	width: 20px;
	height: 20px;
	margin-left: 14px;
}

.lk.view-admins-votes .grp-kind .lk-text
{
	margin-left: 48px;
}

.lk.view-admins-votes .grp-kind .lk-name
{
	font-size: 13px;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-admins-votes .grp-kind .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-admins-votes .lk-slot.disabled
{
	opacity: 0.45;
}

/* ---- admins-staff: who can do what, and where ---- */

.lk.view-admins-staff .lk-col-head-0 { width: 216px; }
.lk.view-admins-staff .lk-col-head-1 { width: 200px; }
.lk.view-admins-staff .lk-col-head-2 { width: 170px; }
.lk.view-admins-staff .lk-col-head-3 { width: fill-parent-flow( 1.0 ); }

.lk.view-admins-staff .lk-col-head-4
{
	width: 96px;
	text-align: right;
}

.lk.view-admins-staff .lk-list .lk-slot
{
	height: 46px;
	margin: 4px 0px 0px 0px;
}

.lk.view-admins-staff .lk-list .lk-slot .lk-text
{
	width: 700px;
	margin-left: 52px;
}

/* The servers column. */
.lk.view-admins-staff .lk-list .lk-type
{
	width: 160px;
	vertical-align: center;
	margin-left: 534px;
	font-size: 12px;
	color: chudStoreText;
	letter-spacing: 1px;
}

.lk.view-admins-staff .lk-list .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 220px;
}

/* A group is outlined in its colour: the owner red, head admins gold, admins accent. */

/* Immunity: the number, then its bar. */
.lk.view-admins-staff .lk-list .lk-note
{
	horizontal-align: left;
	margin: 0px 0px 0px 420px;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	color: chudTextMain;
	letter-spacing: 0px;
}

.lk.view-admins-staff .lk-list .lk-meter
{
	width: 108px;
	height: 6px;
	horizontal-align: left;
	vertical-align: center;
	margin: 0px 0px 0px 458px;
	border-radius: 3px;
	background-color: chudShadowDim;
}

/* Reload and Add admin, right-aligned under the table. */
.lk.view-admins-staff .lk-foot
{
	width: fit-children;
	horizontal-align: right;
	margin-top: 14px;
}

.lk.view-admins-staff .lk-foot .lk-slot
{
	width: 120px;
	height: 40px;
	margin: 0px 0px 0px 10px;
}

.lk.view-admins-staff .lk-foot .lk-slot.primary
{
	width: 160px;
}

.lk.view-admins-staff .lk-foot .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 16px;
	wash-color: chudTextMain;
}

.lk.view-admins-staff .lk-foot .lk-slot .lk-text
{
	margin-left: 40px;
}

.lk.view-admins-staff .lk-foot .lk-name
{
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}
