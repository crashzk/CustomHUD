/* Generated by scripts/generate-v2-sheets.ps1 from locker_admins.vcss in the store palette. Do not edit. */

/*
	Admins' views on menu_locker. People rows share one anatomy: the avatar is the mark,
	the team or group the tag, and a column the row has no part for (a ban's reason, an
	admin's servers) is the type label, moved out of the name's column.
*/

/* ---- admins-players: everyone on the server, the selected player's sheet beside ---- */

.lk.view-admins-players .lk-detail,
.lk.view-admins-player .lk-detail
{
	width: 416px;
}

.lk.view-admins-players .lk-list .lk-slot.disabled
{
	opacity: 0.55;
}

.lk.view-admins-players .lk-list .lk-slot .lk-text
{
	width: 190px;
	margin-left: 52px;
}

.lk.view-admins-players .lk-list .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

/* Clear of K / D, which ends the row where locker.vcss puts .lk-end. */
.lk.view-admins-players .lk-list .lk-tags
{
	margin-right: 80px;
}

.lk.view-admins-players .lk-list .lk-tag,
.lk.view-admins-players .lk-list .lk-tag2
{
	padding: 2px 6px;
	border-radius: 2px;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
}

/* The sheet: the whole pane is one card, its buttons inside at the foot; its items
   wrap so stats and actions share lines. */
.lk.view-admins-players .lk-detail,
.lk.view-admins-player .lk-detail,
.lk.view-admins-bans .lk-detail,
.lk.view-admins-record .lk-detail,
.lk.view-admins-ban .lk-detail
{
	padding: 16px;
}

.lk.view-admins-players .lk-detail__items,
.lk.view-admins-player .lk-detail__items,
.lk.view-admins-bans .lk-detail__items,
.lk.view-admins-record .lk-detail__items
{
	flow-children: right-wrap;
}

/* The head: a large avatar, the name, its team in the corner, the state as a red badge. */
.lk.view-admins-players .grp-head,
.lk.view-admins-player .grp-head,
.lk.view-admins-bans .grp-head,
.lk.view-admins-record .grp-head
{
	height: 72px;
}

.lk.view-admins-players .grp-head .lk-mark,
.lk.view-admins-player .grp-head .lk-mark,
.lk.view-admins-bans .grp-head .lk-mark,
.lk.view-admins-record .grp-head .lk-mark
{
	width: 64px;
	height: 64px;
	vertical-align: top;
	margin: 0px;
	border-radius: 4px;
}

.lk.view-admins-players .grp-head .lk-mark__text,
.lk.view-admins-player .grp-head .lk-mark__text,
.lk.view-admins-bans .grp-head .lk-mark__text,
.lk.view-admins-record .grp-head .lk-mark__text
{
	font-size: 30px;
}

.lk.view-admins-players .grp-head .lk-text,
.lk.view-admins-player .grp-head .lk-text,
.lk.view-admins-bans .grp-head .lk-text,
.lk.view-admins-record .grp-head .lk-text
{
	width: 290px;
	vertical-align: top;
	margin: 4px 0px 0px 78px;
}

.lk.view-admins-players .grp-head .lk-name,
.lk.view-admins-player .grp-head .lk-name,
.lk.view-admins-bans .grp-head .lk-name,
.lk.view-admins-record .grp-head .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
}

.lk.view-admins-players .grp-head .lk-tags,
.lk.view-admins-player .grp-head .lk-tags
{
	vertical-align: top;
	margin: 6px 0px 0px 0px;
}

.lk.view-admins-players .grp-head .lk-tag,
.lk.view-admins-player .grp-head .lk-tag
{
	padding: 2px 6px;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
}

.lk.view-admins-players .grp-head .lk-note,
.lk.view-admins-player .grp-head .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 46px 0px 0px 78px;
	padding: 3px 8px;
	border-radius: 3px;
	background-color: chudDangerSoft;
	font-size: 10px;
	letter-spacing: 1px;
}

.lk.view-admins-players .grp-head .note-bad .lk-note,
.lk.view-admins-player .grp-head .note-bad .lk-note
{
