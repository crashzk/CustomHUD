.lk.view-admins-votes .grp-turnout .lk-pips
{
	height: 14px;
	vertical-align: bottom;
}

.lk.view-admins-votes .grp-outcome
{
	width: 100%;
	height: 62px;
	margin: 22px 0px 14px 0px;
}

.lk.view-admins-votes .lk-foot .grp-outcome .lk-hit
{
	border: 1px solid chudDangerDim;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerWash ), to( chudDangerFade ) );
}

.lk.view-admins-votes .grp-outcome .lk-mark
{
	margin-left: 14px;
}

.lk.view-admins-votes .grp-outcome .lk-text
{
