	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-admins-player .lk-list .grp-record .lk-note
{
	margin-right: 12px;
	letter-spacing: 1px;
}

/* Playtime: three tiles, then this year beside a total two wide. Each line is 3 x 146 + 2 x 6
   = 450 of the list's 452, as wide as the rows below, since a line's last tile has no gap. */
.lk.view-admins-player .lk-list .grp-playtime,
.lk.view-admins-player .lk-list .grp-playtime-end,
.lk.view-admins-player .lk-list .grp-playtime-total
