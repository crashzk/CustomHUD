/* ---- admins-bans: the bans as a table, the selected one's fields beside it ---- */

.lk.view-admins-bans .lk-thead,
.lk.view-admins-staff .lk-thead
{
	padding: 0px 12px 4px 10px;
}

.lk.view-admins-bans .lk-col-head,
