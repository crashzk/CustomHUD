.bar2-98 .lk-meter2__fill { width: 98%; }
.bar2-99 .lk-meter2__fill { width: 99%; }
.bar2-100 .lk-meter2__fill { width: 100%; }

/* pips=K/N: N pips, K lit. A pip's own colour is the lit one, so a view or tone
   recolours lit pips with one rule; the ladder below greys the unlit ones and
   outranks any such rule. */
.lk-pips
{
	width: 100%;
	height: 10px;
	flow-children: right;
	visibility: collapse;
}

.lk-slot.has-pips .lk-pips
{
	visibility: visible;
}

.lk-pip
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin-right: 5px;
	border-radius: 2px;
	background-color: chudInfoBase;
}

.meter-accent .lk-pip { background-color: chudNavBase; }
.meter-gold .lk-pip { background-color: chudGoldBase; }
.meter-good .lk-pip { background-color: chudSuccessBase; }
.meter-bad .lk-pip { background-color: chudDangerBase; }

/* A rule per line: CS2 rejects the whole sheet when one rule lists too many selectors. */
.pips-1 .lk-pip-1, .pips-1 .lk-pip-2, .pips-1 .lk-pip-3, .pips-1 .lk-pip-4, .pips-1 .lk-pip-5, .pips-1 .lk-pip-6, .pips-1 .lk-pip-7, .pips-1 .lk-pip-8, .pips-1 .lk-pip-9, .pips-1 .lk-pip-10, .pips-1 .lk-pip-11, .pips-1 .lk-pip-12, .pips-1 .lk-pip-13, .pips-1 .lk-pip-14, .pips-1 .lk-pip-15, .pips-1 .lk-pip-16, .pips-1 .lk-pip-17, .pips-1 .lk-pip-18, .pips-1 .lk-pip-19 { visibility: collapse; }
.pips-2 .lk-pip-2, .pips-2 .lk-pip-3, .pips-2 .lk-pip-4, .pips-2 .lk-pip-5, .pips-2 .lk-pip-6, .pips-2 .lk-pip-7, .pips-2 .lk-pip-8, .pips-2 .lk-pip-9, .pips-2 .lk-pip-10, .pips-2 .lk-pip-11, .pips-2 .lk-pip-12, .pips-2 .lk-pip-13, .pips-2 .lk-pip-14, .pips-2 .lk-pip-15, .pips-2 .lk-pip-16, .pips-2 .lk-pip-17, .pips-2 .lk-pip-18, .pips-2 .lk-pip-19 { visibility: collapse; }
.pips-3 .lk-pip-3, .pips-3 .lk-pip-4, .pips-3 .lk-pip-5, .pips-3 .lk-pip-6, .pips-3 .lk-pip-7, .pips-3 .lk-pip-8, .pips-3 .lk-pip-9, .pips-3 .lk-pip-10, .pips-3 .lk-pip-11, .pips-3 .lk-pip-12, .pips-3 .lk-pip-13, .pips-3 .lk-pip-14, .pips-3 .lk-pip-15, .pips-3 .lk-pip-16, .pips-3 .lk-pip-17, .pips-3 .lk-pip-18, .pips-3 .lk-pip-19 { visibility: collapse; }
.pips-4 .lk-pip-4, .pips-4 .lk-pip-5, .pips-4 .lk-pip-6, .pips-4 .lk-pip-7, .pips-4 .lk-pip-8, .pips-4 .lk-pip-9, .pips-4 .lk-pip-10, .pips-4 .lk-pip-11, .pips-4 .lk-pip-12, .pips-4 .lk-pip-13, .pips-4 .lk-pip-14, .pips-4 .lk-pip-15, .pips-4 .lk-pip-16, .pips-4 .lk-pip-17, .pips-4 .lk-pip-18, .pips-4 .lk-pip-19 { visibility: collapse; }
.pips-5 .lk-pip-5, .pips-5 .lk-pip-6, .pips-5 .lk-pip-7, .pips-5 .lk-pip-8, .pips-5 .lk-pip-9, .pips-5 .lk-pip-10, .pips-5 .lk-pip-11, .pips-5 .lk-pip-12, .pips-5 .lk-pip-13, .pips-5 .lk-pip-14, .pips-5 .lk-pip-15, .pips-5 .lk-pip-16, .pips-5 .lk-pip-17, .pips-5 .lk-pip-18, .pips-5 .lk-pip-19 { visibility: collapse; }
.pips-6 .lk-pip-6, .pips-6 .lk-pip-7, .pips-6 .lk-pip-8, .pips-6 .lk-pip-9, .pips-6 .lk-pip-10, .pips-6 .lk-pip-11, .pips-6 .lk-pip-12, .pips-6 .lk-pip-13, .pips-6 .lk-pip-14, .pips-6 .lk-pip-15, .pips-6 .lk-pip-16, .pips-6 .lk-pip-17, .pips-6 .lk-pip-18, .pips-6 .lk-pip-19 { visibility: collapse; }
.pips-7 .lk-pip-7, .pips-7 .lk-pip-8, .pips-7 .lk-pip-9, .pips-7 .lk-pip-10, .pips-7 .lk-pip-11, .pips-7 .lk-pip-12, .pips-7 .lk-pip-13, .pips-7 .lk-pip-14, .pips-7 .lk-pip-15, .pips-7 .lk-pip-16, .pips-7 .lk-pip-17, .pips-7 .lk-pip-18, .pips-7 .lk-pip-19 { visibility: collapse; }
.pips-8 .lk-pip-8, .pips-8 .lk-pip-9, .pips-8 .lk-pip-10, .pips-8 .lk-pip-11, .pips-8 .lk-pip-12, .pips-8 .lk-pip-13, .pips-8 .lk-pip-14, .pips-8 .lk-pip-15, .pips-8 .lk-pip-16, .pips-8 .lk-pip-17, .pips-8 .lk-pip-18, .pips-8 .lk-pip-19 { visibility: collapse; }
.pips-9 .lk-pip-9, .pips-9 .lk-pip-10, .pips-9 .lk-pip-11, .pips-9 .lk-pip-12, .pips-9 .lk-pip-13, .pips-9 .lk-pip-14, .pips-9 .lk-pip-15, .pips-9 .lk-pip-16, .pips-9 .lk-pip-17, .pips-9 .lk-pip-18, .pips-9 .lk-pip-19 { visibility: collapse; }
.pips-10 .lk-pip-10, .pips-10 .lk-pip-11, .pips-10 .lk-pip-12, .pips-10 .lk-pip-13, .pips-10 .lk-pip-14, .pips-10 .lk-pip-15, .pips-10 .lk-pip-16, .pips-10 .lk-pip-17, .pips-10 .lk-pip-18, .pips-10 .lk-pip-19 { visibility: collapse; }
.pips-11 .lk-pip-11, .pips-11 .lk-pip-12, .pips-11 .lk-pip-13, .pips-11 .lk-pip-14, .pips-11 .lk-pip-15, .pips-11 .lk-pip-16, .pips-11 .lk-pip-17, .pips-11 .lk-pip-18, .pips-11 .lk-pip-19 { visibility: collapse; }
.pips-12 .lk-pip-12, .pips-12 .lk-pip-13, .pips-12 .lk-pip-14, .pips-12 .lk-pip-15, .pips-12 .lk-pip-16, .pips-12 .lk-pip-17, .pips-12 .lk-pip-18, .pips-12 .lk-pip-19 { visibility: collapse; }
.pips-13 .lk-pip-13, .pips-13 .lk-pip-14, .pips-13 .lk-pip-15, .pips-13 .lk-pip-16, .pips-13 .lk-pip-17, .pips-13 .lk-pip-18, .pips-13 .lk-pip-19 { visibility: collapse; }
.pips-14 .lk-pip-14, .pips-14 .lk-pip-15, .pips-14 .lk-pip-16, .pips-14 .lk-pip-17, .pips-14 .lk-pip-18, .pips-14 .lk-pip-19 { visibility: collapse; }
.pips-15 .lk-pip-15, .pips-15 .lk-pip-16, .pips-15 .lk-pip-17, .pips-15 .lk-pip-18, .pips-15 .lk-pip-19 { visibility: collapse; }
.pips-16 .lk-pip-16, .pips-16 .lk-pip-17, .pips-16 .lk-pip-18, .pips-16 .lk-pip-19 { visibility: collapse; }
