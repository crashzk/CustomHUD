.lk-slot.lit-11 .lk-pips .lk-pip-11, .lk-slot.lit-11 .lk-pips .lk-pip-12, .lk-slot.lit-11 .lk-pips .lk-pip-13, .lk-slot.lit-11 .lk-pips .lk-pip-14, .lk-slot.lit-11 .lk-pips .lk-pip-15, .lk-slot.lit-11 .lk-pips .lk-pip-16, .lk-slot.lit-11 .lk-pips .lk-pip-17, .lk-slot.lit-11 .lk-pips .lk-pip-18, .lk-slot.lit-11 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-12 .lk-pips .lk-pip-12, .lk-slot.lit-12 .lk-pips .lk-pip-13, .lk-slot.lit-12 .lk-pips .lk-pip-14, .lk-slot.lit-12 .lk-pips .lk-pip-15, .lk-slot.lit-12 .lk-pips .lk-pip-16, .lk-slot.lit-12 .lk-pips .lk-pip-17, .lk-slot.lit-12 .lk-pips .lk-pip-18, .lk-slot.lit-12 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-13 .lk-pips .lk-pip-13, .lk-slot.lit-13 .lk-pips .lk-pip-14, .lk-slot.lit-13 .lk-pips .lk-pip-15, .lk-slot.lit-13 .lk-pips .lk-pip-16, .lk-slot.lit-13 .lk-pips .lk-pip-17, .lk-slot.lit-13 .lk-pips .lk-pip-18, .lk-slot.lit-13 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-14 .lk-pips .lk-pip-14, .lk-slot.lit-14 .lk-pips .lk-pip-15, .lk-slot.lit-14 .lk-pips .lk-pip-16, .lk-slot.lit-14 .lk-pips .lk-pip-17, .lk-slot.lit-14 .lk-pips .lk-pip-18, .lk-slot.lit-14 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-15 .lk-pips .lk-pip-15, .lk-slot.lit-15 .lk-pips .lk-pip-16, .lk-slot.lit-15 .lk-pips .lk-pip-17, .lk-slot.lit-15 .lk-pips .lk-pip-18, .lk-slot.lit-15 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-16 .lk-pips .lk-pip-16, .lk-slot.lit-16 .lk-pips .lk-pip-17, .lk-slot.lit-16 .lk-pips .lk-pip-18, .lk-slot.lit-16 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-17 .lk-pips .lk-pip-17, .lk-slot.lit-17 .lk-pips .lk-pip-18, .lk-slot.lit-17 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-18 .lk-pips .lk-pip-18, .lk-slot.lit-18 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }
.lk-slot.lit-19 .lk-pips .lk-pip-19 { background-color: chudStoreEdge; }

/* An inline entry's own Button, on top of the row (ShopCore's Sell). */
.lk-inline
{
	height: 34px;
	horizontal-align: right;
	vertical-align: center;
	margin-right: 14px;
	padding: 0px 14px;
	flow-children: right;
	visibility: collapse;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk-slot.has-inline .lk-inline
{
	visibility: visible;
}

.lk-inline__label
{
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
}

.lk-inline__value
{
	vertical-align: center;
	margin-left: 14px;
	font-family: chudDigitsBold;
	font-size: 12px;
	color: chudSuccessBase;
	white-space: nowrap;
}

.inline-disabled .lk-inline
{
	border: 1px solid transparent;
	background-color: transparent;
}

.inline-disabled .lk-inline__label
{
	color: chudStoreFaint;
}

/* A row's act= buttons over its right end, each sending one menu action to the row. Their
   colours are the Inset control and Danger looks below. */
.lk-acts
{
	height: 100%;
	horizontal-align: right;
	margin-right: 12px;
	flow-children: right;
	visibility: collapse;
}

.lk-slot.has-acts .lk-acts
{
	visibility: visible;
}

.lk-act
{
	width: 32px;
	height: 32px;
	vertical-align: center;
	margin-left: 6px;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk-act.hidden
{
	visibility: collapse;
}

/* The arrowheads are 2:1, so 16 x 8 inside this box; the bin fills it. */
.lk-act__glyph
{
	width: 16px;
	height: 16px;
	horizontal-align: center;
	vertical-align: center;
	wash-color: chudStoreText;
}

.lk-act:hover .lk-act__glyph
{
	wash-color: chudTextMain;
}

.lk-act.act-danger:hover .lk-act__glyph
{
	wash-color: chudDangerStrong;
}

/* Nowhere to go (the first map can't move up): dimmed, and left out of the click map. */
.lk-act.act-off
{
	opacity: 0.3;
}

.lk-act.act-off:hover .lk-act__glyph
{
	wash-color: chudStoreText;
}

/* ==== Looks: one rule each, shared by every view ====
   Every menu draws its surfaces from these, so a card, a button or a chosen row
   looks the same in every plugin. A view joins a look by adding its selector to the
   list; its own sheet keeps the geometry and arrangement, never these colours.
   The tile, the eyebrow and the chrome are shared with WeaponSkins: menu_mouse.vcss. */

/* Chosen: the player's own pick in a list, and the open tab. Tiles and poll rows outline instead. */
.lk-tab.selected,
.lk-tab.selected:hover,
.lk .lk-list .lk-slot.chosen .lk-hit,
.lk .lk-list .lk-slot.chosen .lk-hit:hover,
.lk.view-admins-players .lk-detail .grp-action.kind-action.chosen .lk-hit,
.lk.view-vip-users .grp-step.chosen .lk-hit,
.lk.view-vip-users .grp-step.chosen .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-pill.chosen .lk-hit,
.lk.view-vip-grant .lk-detail .lk-slot.grp-pill.chosen .lk-hit:hover,
.lk.view-mix-captains .lk-banner .lk-slot.chosen .lk-hit,
.lk.view-mix-captains .lk-banner .lk-slot.chosen .lk-hit:hover,
.lk.view-mix-draft .lk-strip .lk-slot.chosen .lk-hit,
.lk.view-mix-draft .grp-open.chosen .lk-hit,
.lk.view-mix-draft .grp-open.chosen .lk-hit:hover,
.lk.view-mix-control .lk-detail .is-on .lk-hit,
.lk.view-mix-control .lk-detail .is-on .lk-hit:hover
{
	border: 1px solid chudNavBase;
	background-color: chudNavSoft;
}

/* Bare: text with no surface. A banner, a foot and a bar's text are bare by default. */
.lk .lk-banner .lk-hit,
.lk .lk-banner .lk-hit:hover,
.lk .lk-foot .lk-hit,
.lk .lk-foot .lk-hit:hover,
.lk .lk-detail__bar .kind-text .lk-hit,
.lk .lk-detail__bar .kind-text .lk-hit:hover,
.lk.view-vip-users .lk-detail .lk-hit,
.lk.view-vip-users .lk-detail .lk-hit:hover,
.lk.view-ranks-board .grp-gap .lk-hit,
.lk.view-ranks-board .grp-gap .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-hint .lk-hit,
.lk.view-vip-grant .lk-detail .lk-slot.grp-hint .lk-hit:hover,
.lk.view-mix-captains .lk-list .tag-dark .lk-tag,
.lk.view-mix-draft .lk-strip .lk-slot.section .lk-hit,
.lk.view-mix-draft .lk-strip .lk-slot.section .lk-hit:hover,
.lk.view-mix-control .lk-list .lk-hit,
.lk.view-mix-control .lk-list .lk-hit:hover,
.lk.view-mix-control .lk-detail .grp-hint .lk-hit,
.lk.view-mix-control .lk-detail .grp-hint .lk-hit:hover
{
	border: 0px solid transparent;
	background-color: transparent;
}

/* Bare, continued: past about 30 selectors a list stops the whole sheet loading (PanoramaAuthoring.md). */
.lk.view-admins-players .lk-detail .lk-hit,
.lk.view-admins-players .lk-detail .lk-hit:hover,
.lk.view-admins-player .lk-detail .lk-hit,
.lk.view-admins-player .lk-detail .lk-hit:hover,
.lk.view-admins-bans .lk-detail .lk-hit,
.lk.view-admins-bans .lk-detail .lk-hit:hover,
.lk.view-admins-record .lk-detail .lk-hit,
.lk.view-admins-record .lk-detail .lk-hit:hover,
.lk.view-admins-ban .lk-detail .lk-hit,
.lk.view-admins-ban .lk-detail .lk-hit:hover,
.lk.view-admins-votes .grp-hint.has-glyph .lk-hit,
.lk.view-admins-votes .grp-hint.has-glyph .lk-hit:hover
{
	border: 0px solid transparent;
	background-color: transparent;
}

/* Control: a button, quiet until hovered, and a static box on the same ground.
   A foot's and a bar's actions are controls by default. */
.lk .lk-detail__bar .lk-hit,
.lk.view-vip-users .grp-gcard .lk-hit,
.lk.view-vip-users .grp-gcard .lk-hit:hover,
.lk.view-vip-users .grp-step .lk-hit,
.lk .lk-foot .kind-action .lk-hit,
.lk.view-maps-rows .lk-list .lk-hit,
.lk.view-maps-cycle .lk-list .lk-hit,
.lk.view-maps-rtv .grp-more .lk-hit,
.lk.view-admins-players .lk-detail .grp-action.kind-action .lk-hit,
.lk.view-admins-player .lk-list .lk-hit,
.lk.view-admins-player .lk-list .grp-playtime .lk-hit:hover,
.lk.view-admins-player .lk-list .grp-playtime-end .lk-hit:hover,
.lk.view-admins-player .lk-list .grp-playtime-total .lk-hit:hover,
.lk.view-admins-ban .lk-list .lk-hit,
.lk.view-admins-votes .lk-list .lk-hit,
.lk.view-mix-ballot .lk-list .lk-hit,
.lk.view-mix-control .lk-detail .lk-hit
{
	border: 1px solid chudStoreEdge;
	border-radius: 4px;
	background-color: chudStoreRow;
}

.lk-tab:hover,
.lk .lk-detail__bar .lk-hit:hover,
.lk .lk-foot .kind-action .lk-hit:hover,
.lk.view-maps-rows .lk-list .lk-hit:hover,
.lk.view-maps-cycle .lk-list .lk-hit:hover,
.lk.view-maps-rtv .grp-more .lk-hit:hover,
.lk.view-admins-players .lk-detail .grp-action.kind-action .lk-hit:hover,
.lk.view-admins-player .lk-list .lk-hit:hover,
.lk.view-admins-ban .lk-list .lk-hit:hover,
.lk.view-admins-votes .lk-list .lk-hit:hover,
.lk.view-vip-users .grp-step .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-pill .lk-hit:hover,
.lk.view-mix-captains .lk-banner .lk-hit:hover,
.lk.view-mix-draft .lk-list .lk-hit:hover,
.lk.view-mix-ballot .lk-list .lk-hit:hover,
.lk.view-mix-control .lk-detail .lk-hit:hover,
.lk-inline:hover,
.lk-act:hover
{
	border: 1px solid chudNavBase;
	background-color: chudStoreHover;
}

/* Inset control: a control sitting on a row or card, a step darker than its ground. */
.lk-inline,
.lk-act,
.lk-act.act-off:hover,
.lk.view-vip-perks .lk-list .kind-submenu .lk-end,
.lk.view-mix-captains .lk-banner .lk-note
{
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	background-color: chudStoreTileDeep;
}

/* Chip: a control sized to its text. */
.lk.view-maps-rtv .lk-list .lk-hit,
.lk.view-maps-rtv .lk-list .lk-hit:hover,
.lk.view-shop-product .grp-badge .lk-hit,
.lk.view-shop-product .grp-badge .lk-hit:hover,
.lk.view-vip-grant .lk-detail .lk-slot.grp-pill .lk-hit
{
	width: fit-children;
	padding: 0px 10px;
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	background-color: chudStoreRow;
}

/* Solid pill: on a picture or hanging off a card's edge a pill needs a solid ground,
   so it is the hue itself with dark ink. Everywhere else a pill is soft. A poll row's
   pill is solid too: it sits on the share's fill, where a soft one disappears. */
.lk.view-maps-board .tag-info .lk-tag,
.lk.view-maps-pool .tag-info .lk-tag,
.lk.view-maps-rows .tag-info .lk-tag
{
	border: 1px solid chudInfoBase;
	background-color: chudInfoBase;
	color: chudTextInk;
}

.lk.view-maps-board .tag-accent .lk-tag,
.lk.view-maps-pool .tag-accent .lk-tag,
.lk.view-maps-rows .tag-accent .lk-tag,
.lk.view-vip-tiers .lk-banner .tag-accent .lk-tag,
.lk.view-mix-sides .tag-accent .lk-tag
{
	border: 1px solid chudNavBase;
	background-color: chudNavBase;
	color: chudTextInk;
}

.lk.view-maps-board .tag-gold .lk-tag,
.lk.view-maps-pool .tag-gold .lk-tag,
.lk.view-maps-rows .tag-gold .lk-tag
{
	border: 1px solid chudGoldBase;
	background-color: chudGoldBase;
	color: chudTextInk;
}

.lk.view-maps-board .tag-info .lk-tagglyph,
.lk.view-maps-board .tag-accent .lk-tagglyph,
.lk.view-maps-board .tag-gold .lk-tagglyph,
.lk.view-maps-pool .tag-info .lk-tagglyph,
.lk.view-maps-pool .tag-accent .lk-tagglyph,
.lk.view-maps-pool .tag-gold .lk-tagglyph,
.lk.view-maps-rows .tag-info .lk-tagglyph,
.lk.view-maps-rows .tag-accent .lk-tagglyph,
.lk.view-maps-rows .tag-gold .lk-tagglyph
{
	wash-color: chudTextInk;
}

/* Danger: a destructive button, red at rest and a deeper red on hover. */
.lk .lk-detail__bar .danger .lk-hit,
.lk .lk-foot .danger.kind-action .lk-hit,
.lk.view-admins-players .lk-detail .grp-action.kind-action.danger .lk-hit,
.lk.view-admins-player .lk-list .grp-action.danger .lk-hit,
.lk.view-mix-control .lk-detail .danger .lk-hit,
.inline-danger .lk-inline
{
	border: 1px solid chudDangerBase;
	background-color: chudDangerSoft;
}

.lk .lk-detail__bar .danger .lk-hit:hover,
.lk .lk-foot .danger.kind-action .lk-hit:hover,
.lk.view-admins-players .lk-detail .grp-action.kind-action.danger .lk-hit:hover,
.lk.view-admins-player .lk-list .grp-action.danger .lk-hit:hover,
.lk.view-mix-control .lk-detail .danger .lk-hit:hover,
.inline-danger .lk-inline:hover,
.lk-act.act-danger:hover
{
	border: 1px solid chudDangerBase;
	background-color: chudDangerDim;
}

.lk .lk-detail__bar .danger .lk-name,
.lk .lk-foot .danger.kind-action .lk-name,
.lk.view-admins-players .grp-action.kind-action.danger .lk-name,
.lk.view-admins-player .lk-list .grp-action.danger .lk-name,
.lk.view-mix-control .lk-detail .danger .lk-name
{
	color: chudDangerStrong;
}

.lk.view-admins-players .grp-action.kind-action.danger .lk-glyph,
.lk.view-mix-control .lk-detail .danger .lk-glyph
{
	wash-color: chudDangerStrong;
}

/* Primary: the page's one main action. */
.lk .lk-content .lk-slot.primary .lk-hit
{
	border: 1px solid chudNavBase;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavDim ), to( chudNavSoft ) );
}

.lk .lk-content .lk-slot.primary .lk-hit:hover
{
	border: 1px solid chudNavBase;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavHalf ), to( chudNavDim ) );
	box-shadow: fill chudNavSoft 0px 0px 14px 0px;
}

/* Featured: the leader, a podium's first place, the tier on offer. */
.lk.view-ranks-weapons .lk-slot.lead .lk-hit,
.lk.view-ranks-board #banner_0 .lk-hit,
.lk.view-vip-tiers .lk-banner .lk-slot.chosen .lk-hit
{
	border: 1px solid chudGoldHalf;
	background-color: gradient( radial, 50% 0%, 0% 0%, 70% 80%, from( chudGoldSoft ), to( chudStoreTileDeep ) );
}

/* Panel: a box holding part of a page (a hero, a price, a side pane). */
.lk.view-ranks-rank .lk-banner .lk-hit,
.lk.view-ranks-rank .lk-banner .lk-hit:hover,
.lk.view-ranks-rank .lk-list,
.lk.view-ranks-board .lk-banner .lk-hit,
.lk.view-ranks-board .lk-banner .lk-hit:hover,
.lk.view-shop-product .lk-banner .lk-hit,
.lk.view-shop-product .lk-banner .lk-hit:hover,
.lk.view-shop-product .grp-price .lk-hit,
.lk.view-shop-product .grp-price .lk-hit:hover,
.lk.view-vip-perks .lk-banner,
.lk.view-vip-guns .lk-foot,
.lk.view-vip-users .lk-detail,
.lk.view-admins-players .lk-detail,
.lk.view-admins-player .lk-detail,
.lk.view-admins-bans .lk-detail,
.lk.view-admins-record .lk-detail,
.lk.view-admins-ban .lk-detail,
.lk.view-admins-ban .lk-banner,
.lk.view-maps-rtv .lk-detail__body,
.lk.view-maps-rtv .lk-detail__bar,
.lk.view-vip-grant .lk-detail__bar,
.lk.view-mix-captains .lk-banner .lk-hit,
.lk.view-mix-draft .lk-list .lk-hit,
.lk.view-mix-sides .lk-banner .lk-hit,
.lk.view-mix-sides .lk-banner .lk-hit:hover,
.lk.view-mix-sides .lk-list .lk-hit,
.lk.view-mix-control .lk-col
{
	border: 1px solid chudStoreEdge;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreTileBase ), to( chudStoreTileDeep ) );
}

/* Team: a slot that belongs to one side (a pick in the order, a roster's head). */
.lk.view-mix-draft .lk-strip .tone-ct .lk-hit,
.lk.view-mix-draft .grp-head.tone-ct .lk-hit
{
	border: 1px solid chudTeamCtDim;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudTeamCtSoft ), to( chudStoreRow ) );
}

.lk.view-mix-draft .lk-strip .tone-t .lk-hit,
.lk.view-mix-draft .grp-head.tone-t .lk-hit
{
	border: 1px solid chudTeamTDim;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudTeamTSoft ), to( chudStoreRow ) );
}

/* Side: a card for one team, its colour glowing behind the emblem on a solid ground (the
   slot), since a glow is clear at its heart. Ground only, after Chosen, so a chosen side
   keeps its accent edge over its own glow. */
.lk.view-mix-sides .lk-list .tone-t,
.lk.view-mix-sides .lk-list .tone-ct
{
	border-radius: 6px;
	background-color: chudStoreTileDeep;
}

.lk.view-mix-sides .lk-list .tone-t .lk-hit
{
	background-color: gradient( radial, 50% 32%, 0% 0%, 75% 70%, from( chudTeamTSoft ), to( chudStoreTileDeep ) );
}

.lk.view-mix-sides .lk-list .tone-ct .lk-hit
{
	background-color: gradient( radial, 50% 32%, 0% 0%, 75% 70%, from( chudTeamCtSoft ), to( chudStoreTileDeep ) );
}

.lk.view-mix-sides .lk-list .lk-hit:hover
{
	border: 1px solid chudNavBase;
}

/* Empty: a place still to fill, outlined on no ground. */
.lk.view-mix-draft .grp-open .lk-hit,
.lk.view-mix-draft .grp-open .lk-hit:hover
{
	border: 1px solid chudStoreEdge;
	background-color: transparent;
}

/* Target: the player a vote is about, outlined in red. */
.lk.view-mix-ballot .lk-banner .has-rating .lk-hit,
.lk.view-mix-ballot .lk-banner .has-rating .lk-hit:hover
{
	border: 1px solid chudDangerDim;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerWash ), to( chudStoreTileDeep ) );
}

/* Stage: the backdrop of a live vote. */
.lk.view-maps-rtv .lk-col,
.lk.view-admins-votes .lk-col
{
	border: 1px solid chudStoreEdge;
	border-radius: 6px;
	background-color: gradient( radial, 30% 25%, 0% 0%, 75% 80%, from( chudStoreTileBase ), to( chudStoreTileDeep ) );
}

/* Vote pips: one per voter, lit in the accent as the votes come in. */
.lk.view-maps-rtv .lk-pip,
.lk.view-admins-votes .lk-pip
{
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudNavStrong ), to( chudNavBase ) );
}

/* Ballot pips: a team's yes votes in green, its no votes red (nays=, the ladder above). */
.lk.view-mix-ballot .lk-pip
{
	border-radius: 2px;
	background-color: chudSuccessBase;
}

/* Well: where typed text goes. */
.lk.view-vip-grant .grp-search .lk-hit,
.lk.view-vip-grant .grp-search .lk-hit:hover
{
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	background-color: chudShadowDim;
}

/* Poll row: a share filling the row behind its text, with a bright leading edge. */
.lk.view-maps-rows .lk-slot.chosen .lk-hit,
.lk.view-maps-rows .lk-slot.chosen .lk-hit:hover,
.lk.view-admins-votes .lk-list .lk-slot.chosen .lk-hit,
.lk.view-admins-votes .lk-list .lk-slot.chosen .lk-hit:hover
{
	border: 2px solid chudNavBase;
	background-color: chudStoreRow;
}

.lk.view-maps-rows .chud-meter__fill,
.lk.view-admins-votes .lk-list .chud-meter__fill
{
	border-radius: 0px;
	border-right: 2px solid chudInfoHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudInfoWash ), to( chudInfoSoft ) );
}

.lk.view-maps-rows .lead .chud-meter__fill,
.lk.view-admins-votes .lk-list .lead .chud-meter__fill
{
	border-right: 2px solid chudGoldHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudGoldWash ), to( chudGoldSoft ) );
}

.lk.view-maps-rows .chosen .chud-meter__fill,
.lk.view-admins-votes .lk-list .chosen .chud-meter__fill
{
	border-right: 2px solid chudNavHalf;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavWash ), to( chudNavSoft ) );
}

/* ---- Text: the styles a page's words share ---- */

/* Plain value: a word or count read as text, not as a gold figure. */
.lk.view-admins-players .lk-list .lk-value,
.lk.view-admins-bans .grp-field .lk-value,
.lk.view-admins-record .grp-field .lk-value,
.lk.view-admins-staff .lk-list .lk-value,
.lk.view-vip-perks .lk-list .kind-submenu .lk-value
{
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	color: chudTextMain;
}

/* Id line: the SteamID under a player's name. */
.lk.view-admins-players .grp-head .lk-sub,
.lk.view-admins-player .grp-head .lk-sub,
.lk.view-admins-bans .grp-head .lk-sub,
.lk.view-admins-record .grp-head .lk-sub,
.lk.view-admins-ban .grp-target .lk-sub,
.lk.view-vip-users .grp-head .lk-sub,
.lk.view-vip-grant .lk-list .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	color: chudStoreFaint;
	letter-spacing: 0px;
}

/* Small caption: a quiet uppercase label beside a control or a state. */
.lk.view-maps-rows .lk-foot .lk-name,
.lk.view-shop-inventory .lk-slot.kind-toggle .lk-value
{
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

/* Table pill: a pill in a table's groups column. */
.lk.view-admins-staff .lk-list .lk-tag,
.lk.view-admins-staff .lk-list .lk-tag2,
.lk.view-vip-users .lk-list .lk-tag,
.lk.view-vip-users .lk-list .lk-tag2
{
	margin: 0px 4px 0px 0px;
	padding: 2px 6px;
	border-radius: 2px;
	font-family: chudFontBody;
	font-weight: bold;
	letter-spacing: 1px;
}

/* A section: a heading row that also starts the next line of a card grid. It flows,
   so its count (the value) follows the heading whatever the heading's width. The
   .lk .lk-content prefix outranks a view's rules for ordinary rows. */
.lk .lk-content .lk-slot.section
{
	width: 100%;
	height: 30px;
	margin: 4px 0px 6px 0px;
}

.lk .lk-content .lk-slot.section .lk-hit,
.lk .lk-content .lk-slot.section .lk-hit:hover
{
	width: 100%;
	padding: 0px;
	flow-children: right;
	border-top: 0px solid chudStoreEdge;
	border-right: 0px solid chudStoreEdge;
	border-left: 0px solid chudStoreEdge;
	border-bottom: 1px solid chudStoreEdge;
	border-radius: 0px;
	background-color: transparent;
	box-shadow: none;
}

.lk .lk-content .lk-slot.section .lk-text
{
	width: fit-children;
	vertical-align: bottom;
	margin: 0px 0px 6px 0px;
	flow-children: right;
}

.lk .lk-content .lk-slot.section .lk-name
{
	width: fit-children;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 3px;
}

.lk .lk-content .lk-slot.section .lk-sub
{
	width: fit-children;
	margin: 0px 0px 0px 10px;
	color: chudStoreFaint;
	letter-spacing: 1px;
}

.lk .lk-content .lk-slot.section .lk-end
{
	vertical-align: bottom;
	margin: 0px 0px 6px 8px;
}

.lk .lk-content .lk-slot.section .lk-value
{
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudStoreFaint;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk .lk-content .lk-slot.section .lk-rarity,
.lk .lk-content .lk-slot.section .lk-glyph,
.lk .lk-content .lk-slot.section .lk-vglyph,
.lk .lk-content .lk-slot.section .lk-thumb,
.lk .lk-content .lk-slot.section .lk-logo,
.lk .lk-content .lk-slot.section .lk-mark,
.lk .lk-content .lk-slot.section .lk-swatch,
.lk .lk-content .lk-slot.section .lk-rating,
.lk .lk-content .lk-slot.section .lk-tags,
.lk .lk-content .lk-slot.section .lk-note,
.lk .lk-content .lk-slot.section .lk-switch,
.lk .lk-content .lk-slot.section .lk-chev,
.lk .lk-content .lk-slot.section .lk-meter,
.lk .lk-content .lk-slot.section .lk-meter2,
.lk .lk-content .lk-slot.section .lk-pips
{
	visibility: collapse;
}

/* ---- footer ---- */

.lk .chud-nav--page
{
	width: 40px;
	margin-left: 6px;
}

.lk .chud-nav--page Label
{
	font-size: 20px;
	color: chudNavStrong;
}

.lk .chud-nav--close
{
	margin-left: 12px;
}

