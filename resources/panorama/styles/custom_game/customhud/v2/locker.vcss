/* Generated by scripts/generate-v2-sheets.ps1 from locker.vcss in the store palette. Do not edit. */

/*
	menu_locker: the shared page shell. Plugin sheets (locker_<plugin>.vcss) restyle the
	slots per view (`view-<name>` on the shell); this sheet draws the frame, the regions
	and the plain `list` view any plugin falls back to.

	Every part of a slot starts collapsed and is shown by the class the composer writes
	with it (has-sub, has-tag, has-glyph ...), so an absent part never shows its
	{s:...} placeholder and a row without it closes up.
	Measurements follow menu_skins_mouse: a 1140px shell, a 194px sidebar, a 896x576 page.
*/

.lk
{
	width: 1140px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: center;
	padding: 16px;
	flow-children: down;
	/* Panorama draws every side of a panel in one colour, so the frame is all accent. */
	border-top: 2px solid chudNavBase;
	border-right: 1px solid chudNavBase;
	border-bottom: 1px solid chudNavBase;
	border-left: 1px solid chudNavBase;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudStoreRaised ), to( chudStoreDeep ) );
	box-shadow: fill chudShadowDrop 0px 8px 24px 0px;
	opacity: 1;
	transform: translateY( 0px );
	transition-property: opacity, transform;
	transition-duration: 0.2s;
	transition-timing-function: ease-in-out;
}

.lk.hidden
{
	opacity: 0;
	transform: translateY( 12px );
}

.lk.hk-scale-80 { ui-scale: 80%; }
.lk.hk-scale-90 { ui-scale: 90%; }
.lk.hk-scale-100 { ui-scale: 100%; }
.lk.hk-scale-110 { ui-scale: 110%; }
.lk.hk-scale-125 { ui-scale: 125%; }
.lk.hk-scale-150 { ui-scale: 150%; }

/* ---- header: eyebrow, crumb and title, chips ---- */

.lk-head
{
	width: 100%;
	height: 56px;
	flow-children: right;
}

.lk-titles
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.lk-eyebrow
{
	width: 100%;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 3px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.lk-heading
{
	width: 100%;
	margin-top: 4px;
	flow-children: right;
}

.lk-crumb,
.lk-crumb-sep,
.lk-title
{
	font-family: chudFontBody;
	font-size: 26px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.lk-crumb,
.lk-crumb-sep
{
	max-width: 420px;
	color: chudStoreFaint;
	visibility: collapse;
}

.lk-crumb-sep
{
	margin: 0px 10px;
}

.lk-head.has-crumb .lk-crumb,
.lk-head.has-crumb .lk-crumb-sep
{
	visibility: visible;
}

.lk-title
{
	max-width: 740px;
	color: chudTextMain;
}

.lk-chips
{
	height: 100%;
	flow-children: right;
}

.lk-chip
{
	height: 42px;
	vertical-align: center;
	margin-left: 8px;
	padding: 0px 14px 0px 12px;
	flow-children: right;
	border: 1px solid chudStoreEdge;
	border-radius: 4px;
	background-color: chudStoreRow;
}

.lk-chip.hidden
{
	visibility: collapse;
}

.lk-chip__glyph
{
	width: 18px;
	height: 18px;
	vertical-align: center;
	margin-right: 10px;
	wash-color: chudStoreText;
}

.lk-chip__glyph.hidden
{
	visibility: collapse;
}

/* A rank emblem: wide for skill groups, square art keeps its aspect inside. */
.lk-chip__thumb
{
	width: 52px;
	height: 22px;
	vertical-align: center;
	margin: 0px 10px 0px 0px;
}

/* An SVG rasterizes at its declared size (an emblem's is 32x13) unless given the size drawn; a level badge is square. */
.lk-chip.tone-r1 .lk-chip__thumb, .lk-chip.tone-r2 .lk-chip__thumb, .lk-chip.tone-r3 .lk-chip__thumb, .lk-chip.tone-r4 .lk-chip__thumb,
.lk-chip.tone-r5 .lk-chip__thumb, .lk-chip.tone-r6 .lk-chip__thumb, .lk-chip.tone-r7 .lk-chip__thumb
{
	background-texture-size: 52px 21px;
}

.lk-chip.tone-l1 .lk-chip__thumb, .lk-chip.tone-l2 .lk-chip__thumb, .lk-chip.tone-l4 .lk-chip__thumb,
.lk-chip.tone-l8 .lk-chip__thumb, .lk-chip.tone-l10 .lk-chip__thumb
{
	background-texture-size: 22px 22px;
}

.lk-chip__value
{
	vertical-align: center;
	font-family: chudDigitsBold;
	font-size: 20px;
	color: chudTextMain;
	white-space: nowrap;
}

.lk-chip__label
{
	vertical-align: center;
	margin-left: 8px;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
}

.lk-chip.tone-gold .lk-chip__glyph { wash-color: chudGoldBase; }
.lk-chip.tone-gold .lk-chip__value { color: chudGoldBase; }

.lk-chip.tone-warn
{
	border: 1px solid chudDangerDim;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudDangerSoft ), to( chudStoreRow ) );
}

.lk-chip.tone-warn .lk-chip__glyph { wash-color: chudDangerStrong; }
.lk-chip.tone-warn .lk-chip__value { color: chudDangerStrong; }

/* A rank chip: the CS Rating badge (or an emblem through glyph) before the band name. */
.lk-chip .lk-rating
{
	margin-right: 10px;
}

.lk-chip.has-rating .lk-chip__value,
.lk-chip.has-thumb .lk-chip__value
{
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk-divider
{
	width: 100%;
	height: 1px;
	margin: 10px 0px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudNavBase ), color-stop( 0.35, chudStoreEdge ), to( chudStoreFade ) );
}

/* ---- content: sidebar | main ---- */

.lk-content
{
	width: 100%;
	height: 576px;
	flow-children: right;
}

/* A menu that is its own root (MixScrims' pages, MapChooser's locked ballot) has nothing to list. */
.lk.no-sidebar .lk-side
{
	visibility: collapse;
}

.lk-category__count
{
	vertical-align: center;
	margin-left: 6px;
	font-family: chudDigitsBold;
	font-size: 11px;
	color: chudStoreFaint;
	visibility: collapse;
}

.lk-category.has-count .lk-category__count
{
	visibility: visible;
}

.lk-category.selected .lk-category__count
{
	color: chudNavStrong;
}

/* A page with something running on it now (MapChooser's vote): a red dot after its name. */
.lk-category__live
{
	width: 7px;
	height: 7px;
	vertical-align: center;
	margin-left: 6px;
	border-radius: 4px;
	background-color: chudDangerBase;
	box-shadow: fill chudDangerSoft 0px 0px 0px 3px;
	visibility: collapse;
}

.lk-category.live .lk-category__live
{
	visibility: visible;
}

.lk-main
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

/* ---- tabs: the second level ---- */

.lk-tabs
{
	width: 100%;
	height: 30px;
	margin-bottom: 12px;
	flow-children: right;
}

.lk-tabs.hidden
{
	visibility: collapse;
}

.lk-tab
{
	height: 30px;
	margin-right: 6px;
	padding: 0px 14px;
	flow-children: right;
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	background-color: chudStoreRow;
	transition-property: background-color, border;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk-tab.hidden
{
	visibility: collapse;
}

.lk-tab__label
{
	vertical-align: center;
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
}

.lk-tab__count
{
	vertical-align: center;
	margin-left: 8px;
	font-family: chudDigitsBold;
	font-size: 11px;
	color: chudStoreFaint;
	visibility: collapse;
}

.lk-tab.has-count .lk-tab__count
{
	visibility: visible;
}

.lk-tab:hover .lk-tab__label { color: chudTextMain; }

.lk-tab.selected .lk-tab__label { color: chudTextMain; }
.lk-tab.selected .lk-tab__count { color: chudNavStrong; }

.lk-tab.disabled
{
	opacity: 0.35;
}

/* ---- body: the column (banner, head, list, foot) beside the detail pane ---- */

.lk-body
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.lk-col
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.lk-detail
{
	width: 332px;
	height: 100%;
	margin-left: 14px;
	flow-children: down;
	visibility: collapse;
}

.lk.has-detail .lk-detail,
.lk.has-detailbar .lk-detail
{
	visibility: visible;
}

/* The box takes the pane's leftover height; the body is a plain 100% of it, for the reason
   given at .lk-list. */
.lk-detail__box
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
}

.lk-detail__body
{
	width: 100%;
	height: 100%;
	flow-children: down;
	overflow: squish scroll;
}

.lk-detail__items
{
	width: 100%;
	flow-children: down;
}

.lk-detail__bar
{
	width: 100%;
	margin-top: 8px;
	flow-children: right;
}

/* By default the bar's slots are buttons sharing its width (Add group | Remove all). */
.lk .lk-detail__bar .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 40px;
	margin: 0px 0px 0px 8px;
}

.lk .lk-detail__bar #detailbar_0
{
	margin-left: 0px;
}

.lk .lk-detail__bar .lk-glyph
{
	width: 16px;
	height: 16px;
	margin-left: 22px;
	wash-color: chudTextMain;
}

/* A glyph sits before the centred label, so the label keeps clear of it. */
.lk .lk-detail__bar .has-glyph .lk-text
{
	padding-left: 24px;
}

.lk .lk-detail__bar .lk-slot .lk-text
{
	width: fit-children;
	horizontal-align: center;
	margin: 0px;
}

.lk .lk-detail__bar .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk-banner
{
	width: 100%;
	flow-children: right;
	visibility: collapse;
}

.lk.has-banner .lk-banner
{
	visibility: visible;
}

.lk-thead
{
	width: 100%;
	height: 26px;
	padding: 0px 14px 4px 10px;
	flow-children: right;
	border-bottom: 1px solid chudStoreEdge;
	visibility: collapse;
}

.lk.has-head .lk-thead
{
	visibility: visible;
}

.lk-col-head
{
	vertical-align: bottom;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudGoldDeep;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
}

/* The list scrolls in game only inside a box of fixed height, as the WeaponSkins grid does: one that
   fills the column's leftover height drew a scrollbar that neither the wheel nor the thumb moved.
   576 is the page, 534 under the tabs; a band sharing the column falls back to filling it. Squish
   keeps the 100%-wide items inside the padding, clear of the scrollbar in the gutter. */
.lk-listbox
{
	width: 100%;
	height: 576px;
}

.lk.has-tabs .lk-listbox
{
	height: 534px;
}

.lk.has-strip .lk-listbox,
.lk.has-banner .lk-listbox,
.lk.has-head .lk-listbox,
.lk.has-foot .lk-listbox,
.lk.view-maps-rtv .lk-listbox,
.lk.view-admins-votes .lk-listbox,
.lk.view-mix-control .lk-listbox
{
	height: fill-parent-flow( 1.0 );
}

.lk-list
{
	width: 100%;
	height: 100%;
	padding-right: 14px;
	flow-children: down;
	overflow: squish scroll;
}

.lk-items
{
	width: 100%;
	flow-children: right-wrap;
}

/* The renderer's scroll rewind (LayoutClasses.Rewind), on the shell for three ticks after a new
   list replaces the last: the content measures 1px and draws past it, so the scroll offset clamps
   to the top while the new rows already show. A view whose box fits its rows caps them at its own
   cap instead, or opts out where it never scrolls; either way its box keeps its height. */
.lk.chud-rewind .lk-items,
.lk.chud-rewind .lk-detail__items
{
	height: 1px;
	overflow: squish noclip;
}

.lk-foot
{
	width: 100%;
	flow-children: right;
	visibility: collapse;
}

.lk.has-foot .lk-foot
{
	visibility: visible;
}

/* ---- strip and aside: a row of small slots over the body, a column left of the list ---- */

.lk-strip
{
	width: 100%;
	height: 34px;
	margin-bottom: 14px;
	flow-children: right;
	visibility: collapse;
}

.lk.has-strip .lk-strip
{
	visibility: visible;
}

.lk-strip .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin: 0px 6px 0px 0px;
}

.lk-aside
{
	width: 250px;
	height: 100%;
	margin-right: 16px;
	flow-children: down;
	visibility: collapse;
}

.lk.has-aside .lk-aside
{
	visibility: visible;
}

/* ---- slots: every region's rows share this anatomy ---- */

.lk-slot
{
	width: 100%;
	height: 44px;
	margin-bottom: 4px;
	flow-children: none;
}

.lk-slot.hidden
{
	visibility: collapse;
}

.lk-hit
{
	width: 100%;
	height: 100%;
	flow-children: none;
	border-left: 2px solid transparent;
	border-radius: 3px;
	background-color: chudStoreRow;
	transition-property: background-color, border, box-shadow;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk-hit:hover
{
	border-left: 2px solid chudNavBase;
	background-color: chudStoreHover;
}

/* Plain text has nothing to pick. */
.lk-slot.kind-text .lk-hit:hover
{
	border-left: 2px solid transparent;
	background-color: chudStoreRow;
}

.lk-slot.disabled
{
	opacity: 0.4;
}

.lk-rarity
{
	width: 100%;
	height: 100%;
	visibility: collapse;
}

.lk-thumb,
.lk-logo
{
	background-size: contain;
	background-position: 50% 50%;
	background-repeat: no-repeat;
}

.lk-thumb
{
	width: 56px;
	height: 36px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 10px;
}

.lk-thumb.hidden,
.lk-logo,
.lk-logo.hidden
{
	visibility: collapse;
}

.lk-mark
{
	width: 32px;
	height: 32px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 10px;
	border-radius: 3px;
	background-color: chudStoreEdge;
	visibility: collapse;
}

.lk-slot.has-mark .lk-mark
{
	visibility: visible;
}

.lk-mark__text
{
	horizontal-align: center;
	vertical-align: center;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
}

/* Avatar colours: muted, so a name still reads first. */
.lk-slot.av-0 .lk-mark { background-color: chudTint02; }
.lk-slot.av-1 .lk-mark { background-color: chudTint10; }
.lk-slot.av-2 .lk-mark { background-color: chudTint06; }
.lk-slot.av-3 .lk-mark { background-color: chudTint04; }
.lk-slot.av-4 .lk-mark { background-color: chudTint07; }
.lk-slot.av-5 .lk-mark { background-color: chudTint03; }
.lk-slot.av-6 .lk-mark { background-color: chudTint05; }
.lk-slot.av-7 .lk-mark { background-color: chudTint08; }

/* A view's overlay above the art (a fade under a map's name); nothing by default. */
.lk-shade
{
	width: 100%;
	height: 100%;
	visibility: collapse;
}

.lk-swatch
{
	width: 20px;
	height: 20px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 12px;
	border: 2px solid chudShadowDim;
	border-radius: 10px;
	visibility: collapse;
}

.lk-slot.sw-red .lk-swatch { visibility: visible; background-color: chudSwatchRed; }
.lk-slot.sw-blue .lk-swatch { visibility: visible; background-color: chudSwatchBlue; }
.lk-slot.sw-green .lk-swatch { visibility: visible; background-color: chudSwatchGreen; }
.lk-slot.sw-yellow .lk-swatch { visibility: visible; background-color: chudSwatchYellow; }
.lk-slot.sw-purple .lk-swatch { visibility: visible; background-color: chudSwatchPurple; }
.lk-slot.sw-orange .lk-swatch { visibility: visible; background-color: chudSwatchOrange; }
.lk-slot.sw-pink .lk-swatch { visibility: visible; background-color: chudSwatchPink; }
.lk-slot.sw-cyan .lk-swatch { visibility: visible; background-color: chudSwatchCyan; }
.lk-slot.sw-white .lk-swatch { visibility: visible; background-color: chudSwatchWhite; }
.lk-slot.sw-black .lk-swatch { visibility: visible; background-color: chudSwatchBlack; }
.lk-slot.sw-team .lk-swatch { visibility: visible; background-color: gradient( linear, 0% 0%, 100% 100%, from( chudTeamTBase ), color-stop( 0.5, chudTeamTBase ), color-stop( 0.5, chudTeamCtBase ), to( chudTeamCtBase ) ); }
.lk-slot.sw-random .lk-swatch { visibility: visible; background-color: gradient( linear, 0% 0%, 100% 100%, from( chudSwatchRed ), color-stop( 0.25, chudSwatchYellow ), color-stop( 0.5, chudSwatchGreen ), color-stop( 0.75, chudSwatchBlue ), to( chudSwatchPurple ) ); }

/* Size and colour only; customhud_icons.vcss picks the art. */
.lk-glyph
{
	width: 20px;
	height: 20px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 12px;
	wash-color: chudStoreText;
}

.lk-glyph.hidden
{
	visibility: collapse;
}

/* The CS Rating badge: CS2's own background washed in the band colour, the thousands
   large and the rest small. The wash reaches the digits too, as on the scoreboard. */
.lk-rating
{
	width: 92px;
	height: 26px;
	horizontal-align: left;
	vertical-align: center;
	padding-left: 30px;
	flow-children: right;
	background-image: url( "s2r://panorama/images/icons/ui/premier_rating_bg_large.vsvg" );
	background-size: 100% 100%;
	background-repeat: no-repeat;
	wash-color: chudRating0Base;
	visibility: collapse;
}

.has-rating .lk-rating
{
	visibility: visible;
}

.lk-rating__major
{
	vertical-align: center;
	font-family: Stratum2 Black Italic, "Arial Unicode MS";
	font-size: 18px;
	color: chudTextMain;
}

.lk-rating__minor
{
	vertical-align: center;
	margin-top: 3px;
	font-family: Stratum2 Black Italic, "Arial Unicode MS";
	font-size: 13px;
	color: chudTextMain;
}

.csr-0 .lk-rating { wash-color: chudRating0Base; }
.csr-1 .lk-rating { wash-color: chudRating1Base; }
.csr-2 .lk-rating { wash-color: chudRating2Base; }
.csr-3 .lk-rating { wash-color: chudRating3Base; }
.csr-4 .lk-rating { wash-color: chudRating4Base; }
.csr-5 .lk-rating { wash-color: chudRating5Base; }
.csr-6 .lk-rating { wash-color: chudRating6Base; }

/* type over name over sub, centred on the row; whatever is absent closes up. */
.lk-text
{
	width: 440px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 14px;
	flow-children: down;
}

.lk-slot.has-thumb .lk-text,
.lk-slot.has-mark .lk-text,
.lk-slot.has-glyph .lk-text
{
	margin-left: 56px;
}

.lk-slot.has-thumb .lk-text
{
	margin-left: 80px;
}

.lk-slot.sw-red .lk-text, .lk-slot.sw-blue .lk-text, .lk-slot.sw-green .lk-text, .lk-slot.sw-yellow .lk-text,
.lk-slot.sw-purple .lk-text, .lk-slot.sw-orange .lk-text, .lk-slot.sw-pink .lk-text, .lk-slot.sw-cyan .lk-text,
.lk-slot.sw-white .lk-text, .lk-slot.sw-black .lk-text, .lk-slot.sw-team .lk-text, .lk-slot.sw-random .lk-text
{
	margin-left: 46px;
}

.lk-type
{
	width: 100%;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudGoldDeep;
	text-transform: uppercase;
	letter-spacing: 2px;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.lk-slot.has-type .lk-type
{
	visibility: visible;
}

.lk-name
{
	width: 100%;
	font-family: chudFontMedium;
	font-size: 14px;
	color: chudTextMain;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.lk-slot.danger .lk-name
{
	color: chudDangerBase;
}

.lk-sub
{
	width: 100%;
	margin-top: 2px;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.lk-slot.has-sub .lk-sub
{
	visibility: visible;
}

/* `badge=`: a small boxed label after the name (a map's kind). It brings its own dark ground,
   so it reads alike on a card, under a share's fill and on the list's orange cursor row. */
.lk-badge
{
	max-width: 100%;
	margin-top: 4px;
	padding: 2px 7px;
	border: 1px solid chudStoreEdge;
	border-radius: 2px;
	background-color: chudStoreDeep;
	font-family: chudFontBody;
	font-size: 10px;
	font-weight: bold;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.lk-slot.has-badge .lk-badge
{
	visibility: visible;
}

/* `unit=`: a word after the name. Views that want it beside the name ("1 210 won")
   make lk-text right-wrap; elsewhere it is a line of its own. */
.lk-unit
{
	font-family: chudFontMedium;
	font-size: 12px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	visibility: collapse;
}

.lk-slot.has-unit .lk-unit
{
	visibility: visible;
}

/* A row that opens a page, in views that mark one. */
.lk-chev
{
	horizontal-align: right;
	vertical-align: center;
	margin-right: 16px;
	font-family: chudFontBody;
	font-size: 22px;
	color: chudStoreFaint;
	visibility: collapse;
}

/* Tones: what a value means, one hue each (DesignLanguage.md, principle 1). */
.sub-info .lk-sub { color: chudInfoBase; }
.sub-gold .lk-sub { color: chudGoldBase; }
.sub-good .lk-sub { color: chudSuccessBase; }
.sub-bad .lk-sub { color: chudDangerStrong; }
.sub-faint .lk-sub { color: chudStoreFaint; }

.badge-info .lk-badge { border: 1px solid chudInfoDim; color: chudInfoStrong; }
.badge-gold .lk-badge { border: 1px solid chudGoldDim; color: chudGoldBase; }
.badge-accent .lk-badge { border: 1px solid chudNavDim; color: chudNavStrong; }
.badge-good .lk-badge { border: 1px solid chudSuccessDim; color: chudSuccessStrong; }
.badge-bad .lk-badge { border: 1px solid chudDangerDim; color: chudDangerStrong; }

.lk-tags
{
	horizontal-align: right;
	vertical-align: center;
	margin-right: 250px;
	flow-children: right;
	visibility: collapse;
}

/* Collapsed when empty: a fit-children slot would otherwise count its margin. */
.lk-slot.has-tag .lk-tags,
.lk-slot.has-tag2 .lk-tags
{
	visibility: visible;
}

.lk-tag,
.lk-tag2
{
	margin-left: 6px;
	padding: 2px 7px;
	border: 1px solid chudStoreEdge;
	border-radius: 3px;
	background-color: chudStoreRow;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	visibility: collapse;
}

.lk-slot.has-tag .lk-tag,
.lk-slot.has-tag2 .lk-tag2
{
	visibility: visible;
}

.tag-accent .lk-tag, .tag2-accent .lk-tag2 { border: 1px solid chudNavDim; background-color: chudNavSoft; color: chudNavStrong; }
.tag-gold .lk-tag, .tag2-gold .lk-tag2 { border: 1px solid chudGoldDim; background-color: chudGoldSoft; color: chudGoldBase; }
.tag-info .lk-tag, .tag2-info .lk-tag2 { border: 1px solid chudInfoDim; background-color: chudInfoSoft; color: chudInfoStrong; }
.tag-good .lk-tag, .tag2-good .lk-tag2 { border: 1px solid chudSuccessDim; background-color: chudSuccessSoft; color: chudSuccessStrong; }
.tag-bad .lk-tag, .tag2-bad .lk-tag2 { border: 1px solid chudDangerDim; background-color: chudDangerSoft; color: chudDangerStrong; }
.tag-ct .lk-tag, .tag2-ct .lk-tag2 { border: 1px solid chudTeamCtDim; background-color: chudTeamCtSoft; color: chudTeamCtStrong; }
.tag-t .lk-tag, .tag2-t .lk-tag2 { border: 1px solid chudTeamTDim; background-color: chudTeamTSoft; color: chudTeamTStrong; }
.tag-dark .lk-tag, .tag2-dark .lk-tag2 { border: 1px solid chudStoreEdge; background-color: chudStoreDeep; color: chudStoreText; }
.tag-legend .lk-tag, .tag2-legend .lk-tag2 { border: 1px solid chudLegendDim; background-color: chudLegendSoft; color: chudLegendStrong; }

/* `tagglyph=`: an icon inside the tag's pill, before its words. It sits in the pill's left
   padding, which widens to fit it: margin-left is the tag's margin, edge and padding, and
   margin-right takes that and the icon back, so the pill starts where it would without one.
   A view that repads its pills moves both. z-index lifts it over the pill, which is drawn
   after it. */
.lk-tagglyph
{
	width: 12px;
	height: 12px;
	vertical-align: center;
	margin: 0px -26px 0px 14px;
	z-index: 1;
	wash-color: chudStoreText;
	visibility: collapse;
}

.lk-slot.has-tagglyph .lk-tagglyph
{
	visibility: visible;
}

.lk-slot.has-tagglyph .lk-tag
{
	padding-left: 24px;
}

.tag-accent .lk-tagglyph { wash-color: chudNavStrong; }
.tag-gold .lk-tagglyph { wash-color: chudGoldBase; }
.tag-info .lk-tagglyph { wash-color: chudInfoStrong; }
.tag-good .lk-tagglyph { wash-color: chudSuccessStrong; }
.tag-bad .lk-tagglyph { wash-color: chudDangerStrong; }
.tag-ct .lk-tagglyph { wash-color: chudTeamCtStrong; }
.tag-t .lk-tagglyph { wash-color: chudTeamTStrong; }
.tag-legend .lk-tagglyph { wash-color: chudLegendStrong; }

.lk-note
{
	horizontal-align: right;
	vertical-align: center;
	margin-right: 130px;
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudStoreText;
	text-transform: uppercase;
	letter-spacing: 1.5px;
	white-space: nowrap;
	visibility: collapse;
}

.lk-slot.has-note .lk-note
{
	visibility: visible;
}

.note-accent .lk-note { color: chudNavStrong; }
.note-gold .lk-note { color: chudGoldBase; }
.note-info .lk-note { color: chudInfoBase; }
.note-good .lk-note { color: chudSuccessBase; }
.note-bad .lk-note { color: chudDangerStrong; }
.note-faint .lk-note { color: chudStoreFaint; }

/* The value and the glyph a view may put before it, as one right-aligned group. */
.lk-end
{
	horizontal-align: right;
	vertical-align: center;
	margin-right: 14px;
	flow-children: right;
	visibility: collapse;
}

.lk-slot.has-value .lk-end
{
	visibility: visible;
}

.lk-vglyph
{
	width: 16px;
	height: 16px;
	vertical-align: center;
	margin-right: 6px;
	wash-color: chudGoldBase;
	visibility: collapse;
}

.lk-value
{
	vertical-align: center;
	font-family: chudDigitsBold;
	font-size: 16px;
	color: chudGoldBase;
	white-space: nowrap;
	visibility: collapse;
}

.lk-slot.has-value .lk-value
{
	visibility: visible;
}

/* `vunit=`: the value's unit after it, smaller and muted ("45" then "%"). Bottom-aligned;
   a view whose value is large lifts it onto the value's baseline. */
.lk-vunit
{
	vertical-align: bottom;
	margin-left: 2px;
	font-family: chudFontBody;
	font-size: 11px;
	font-weight: bold;
	color: chudStoreText;
	white-space: nowrap;
	visibility: collapse;
}

.lk-slot.has-vunit .lk-vunit
{
	visibility: visible;
}

.tone-good .lk-value { color: chudSuccessBase; }
.tone-bad .lk-value { color: chudDangerBase; }
.tone-info .lk-value { color: chudInfoBase; }
.tone-main .lk-value { color: chudTextMain; }
.tone-faint .lk-value { color: chudStoreFaint; }
.lk-slot.danger .lk-value { color: chudDangerBase; }

.tone-good .lk-vglyph { wash-color: chudSuccessBase; }
.tone-bad .lk-vglyph { wash-color: chudDangerBase; }
.tone-info .lk-vglyph { wash-color: chudInfoBase; }
.tone-main .lk-vglyph { wash-color: chudTextMain; }
.tone-faint .lk-vglyph { wash-color: chudStoreFaint; }
.lk-slot.danger .lk-vglyph { wash-color: chudDangerBase; }

/* A ToggleComponent row: its value moves into a switch. */
.lk-switch
{
	width: 34px;
	height: 18px;
	horizontal-align: right;
	vertical-align: center;
	margin-right: 14px;
	border-radius: 9px;
	background-color: chudStoreEdge;
	visibility: collapse;
}

.lk-switch__knob
{
	width: 14px;
	height: 14px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 2px;
	border-radius: 7px;
	background-color: chudStoreFaint;
	transition-property: margin-left, background-color;
	transition-duration: 0.12s;
	transition-timing-function: ease-in-out;
}

.lk-slot.kind-toggle .lk-switch
{
	visibility: visible;
}

.lk-slot.kind-toggle .lk-value
{
	visibility: collapse;
}

.lk-slot.is-on .lk-switch
{
	background-color: chudNavDim;
}

.lk-slot.is-on .lk-switch__knob
{
	margin-left: 18px;
	background-color: chudNavBase;
}

/* The meter's width ladder lives in menu.vcss (bar-0 .. bar-100). */
.lk-meter
{
	width: 200px;
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 14px 6px 0px;
}

.lk-slot.has-bar .lk-meter
{
	visibility: visible;
}

.meter-accent .chud-meter__fill { background-color: chudNavBase; }
.meter-gold .chud-meter__fill { background-color: chudGoldBase; }
.meter-good .chud-meter__fill { background-color: chudSuccessBase; }
.meter-bad .chud-meter__fill { background-color: chudDangerBase; }

/* The leader's share in gold, your own in the accent, in every view. */
.lk-slot.lead .chud-meter__fill { background-color: chudGoldBase; }
.lk-slot.chosen .chud-meter__fill { background-color: chudNavBase; }

/* bar2=N: a second meter beside the first (a weapon's accuracy next to its headshot share). */
.lk-meter2
{
	width: 120px;
	height: 3px;
	horizontal-align: right;
	vertical-align: center;
	margin-right: 14px;
	border-radius: 2px;
	background-color: chudStoreEdge;
	visibility: collapse;
}

.lk-slot.has-bar2 .lk-meter2
{
	visibility: visible;
}

.lk-meter2__fill
{
	width: 0%;
	height: 100%;
	border-radius: 2px;
	background-color: chudInfoBase;
}

.bar2-0 .lk-meter2__fill { width: 0%; }
.bar2-1 .lk-meter2__fill { width: 1%; }
.bar2-2 .lk-meter2__fill { width: 2%; }
.bar2-3 .lk-meter2__fill { width: 3%; }
.bar2-4 .lk-meter2__fill { width: 4%; }
.bar2-5 .lk-meter2__fill { width: 5%; }
