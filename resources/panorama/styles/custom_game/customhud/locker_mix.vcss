/*
	MixScrims' views on menu_locker. Every MixScrims menu is its own root, so none has a
	sidebar and a page spans the whole 1108px. Surfaces come from the Looks in
	locker.vcss; this sheet only arranges.
*/

/* ---- shared: "You" after a player's name ---- */

/* `unit=You` reads as a pill beside the name, the sub on the line below. */
.lk.view-mix-captains .lk-list .lk-text,
.lk.view-mix-draft .lk-aside .lk-text,
.lk.view-mix-draft .lk-detail .lk-text
{
	flow-children: right-wrap;
}

.lk.view-mix-captains .lk-list .lk-name,
.lk.view-mix-draft .lk-aside .lk-name,
.lk.view-mix-draft .lk-detail .lk-name
{
	width: fit-children;
}

.lk.view-mix-captains .lk-list .lk-unit,
.lk.view-mix-draft .lk-aside .lk-unit,
.lk.view-mix-draft .lk-detail .lk-unit
{
	margin: 3px 0px 0px 8px;
	padding: 1px 5px;
	border-radius: 2px;
	background-color: chudGoldSoft;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
	color: chudGoldBase;
	letter-spacing: 1px;
}

/* ---- mix-captains: both captain slots over the players ---- */

/* 2 x 547 + 14 = 1108. */
.lk.view-mix-captains .lk-banner
{
	margin-bottom: 14px;
}

.lk.view-mix-captains .lk-banner .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 84px;
	margin: 0px 0px 0px 14px;
}

.lk.view-mix-captains #banner_0
{
	margin-left: 0px;
}

/* The side's emblem in its colour, then who holds the slot. */
.lk.view-mix-captains .lk-banner .lk-glyph
{
	width: 44px;
	height: 44px;
	margin-left: 22px;
}

.lk.view-mix-captains .lk-banner .tone-ct .lk-glyph { wash-color: chudTeamCtBase; }
.lk.view-mix-captains .lk-banner .tone-t .lk-glyph { wash-color: chudTeamTBase; }

.lk.view-mix-captains .lk-banner .lk-mark
{
	width: 32px;
	height: 32px;
	vertical-align: top;
	margin: 34px 0px 0px 84px;
}

.lk.view-mix-captains .lk-banner .lk-slot .lk-text
{
	width: 300px;
	margin-left: 84px;
}

.lk.view-mix-captains .lk-banner .has-mark .lk-text
{
	margin-left: 126px;
}

.lk.view-mix-captains .lk-banner .lk-name
{
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
}

.lk.view-mix-captains .lk-banner .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

/* A state (Picking) in the card's corner. */
.lk.view-mix-captains .lk-banner .lk-tags
{
	horizontal-align: right;
	vertical-align: top;
	margin: 8px 10px 0px 0px;
}

/* The card's own action (Clear, Random), drawn as its button. */
.lk.view-mix-captains .lk-banner .lk-note
{
	margin: 8px 20px 0px 0px;
	padding: 9px 18px;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	color: chudTextMain;
	letter-spacing: 2px;
}

/* The table: avatar and name, then rating, K/D and headshots in columns. */
.lk.view-mix-captains .lk-thead
{
	padding: 0px 0px 4px 0px;
	margin-bottom: 4px;
	flow-children: none;
}

.lk.view-mix-captains .lk-col-head
{
	horizontal-align: left;
}

.lk.view-mix-captains .lk-col-head-0 { margin-left: 56px; }
.lk.view-mix-captains .lk-col-head-1 { margin-left: 480px; }
.lk.view-mix-captains .lk-col-head-2 { margin-left: 672px; }
.lk.view-mix-captains .lk-col-head-3 { margin-left: 752px; }

.lk.view-mix-captains .lk-list .lk-slot
{
	height: 40px;
}

.lk.view-mix-captains .lk-list .lk-mark
{
	width: 28px;
	height: 28px;
	margin-left: 12px;
}

.lk.view-mix-captains .lk-list .lk-mark__text
{
	font-size: 13px;
}

.lk.view-mix-captains .lk-list .lk-slot .lk-text
{
	width: 400px;
	margin-left: 56px;
}

.lk.view-mix-captains .lk-list .lk-rating
{
	margin-left: 480px;
}

.lk.view-mix-captains .lk-list .lk-end
{
	width: 70px;
	horizontal-align: left;
	margin: 0px 0px 0px 672px;
}

.lk.view-mix-captains .lk-list .lk-value,
.lk.view-mix-captains .lk-list .lk-note
{
	font-family: chudDigitsBold;
	font-size: 14px;
	color: chudTextMain;
	letter-spacing: 0px;
}

.lk.view-mix-captains .lk-list .lk-note
{
	horizontal-align: left;
	margin: 0px 0px 0px 752px;
}

.lk.view-mix-captains .lk-list .lk-tags
{
	margin-right: 12px;
}

/* The row's button (Make T captain) shows under the pointer. */
.lk.view-mix-captains .lk-list .lk-tag2
{
	padding: 6px 12px;
	font-family: chudFontBody;
	font-weight: bold;
	visibility: collapse;
}

.lk.view-mix-captains .lk-list .lk-hit:hover .lk-tag2
{
	visibility: visible;
}

/* Not ready: the row steps back, the words stay plain text. */
.lk.view-mix-captains .lk-list .tone-faint .lk-mark,
.lk.view-mix-captains .lk-list .tone-faint .lk-text,
.lk.view-mix-captains .lk-list .tone-faint .lk-rating,
.lk.view-mix-captains .lk-list .tone-faint .lk-end,
.lk.view-mix-captains .lk-list .tone-faint .lk-note
{
	opacity: 0.45;
}

.lk.view-mix-captains .lk-list .tag-dark .lk-tag
{
	padding: 0px;
	color: chudTextFaint;
}

/* ---- mix-draft: the pick order over the page, a team down each side, the pool between ---- */

/* The pick order: its label, then a cell per pick. */
.lk.view-mix-draft .lk-strip .lk-slot.section
{
	width: 112px;
	height: 100%;
	margin: 0px;
}

.lk.view-mix-draft .lk-strip .lk-slot.section .lk-text
{
	vertical-align: center;
	margin: 0px;
}

.lk.view-mix-draft .lk-strip .lk-slot.section .lk-name
{
	letter-spacing: 2.5px;
}

.lk.view-mix-draft .lk-strip .lk-slot .lk-text
{
	width: fit-children;
	margin-left: 10px;
}

.lk.view-mix-draft .lk-strip .lk-name
{
	font-family: chudDigitsBold;
	font-size: 13px;
	color: chudTextMuted;
}

/* Who was picked, or the side still to pick, at the cell's end. */
.lk.view-mix-draft .lk-strip .lk-mark
{
	width: 20px;
	height: 20px;
	horizontal-align: right;
	margin: 0px 7px 0px 0px;
}

.lk.view-mix-draft .lk-strip .lk-mark__text
{
	font-size: 11px;
}

.lk.view-mix-draft .lk-strip .lk-note
{
	margin-right: 9px;
	font-family: chudFontBody;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 1px;
}

.lk.view-mix-draft .lk-strip .tone-ct .lk-note { color: chudTeamCtBase; }
.lk.view-mix-draft .lk-strip .tone-t .lk-note { color: chudTeamTBase; }

.lk.view-mix-draft .lk-strip .chosen .lk-name,
.lk.view-mix-draft .lk-strip .chosen .lk-note
{
	color: chudAccentStrong;
}

/* Picks still to come step back. */
.lk.view-mix-draft .lk-strip .has-note .lk-hit
{
	opacity: 0.55;
}

.lk.view-mix-draft .lk-strip .chosen .lk-hit
{
	opacity: 1;
}

/* The rosters: 250 + 16 either side of the pool's 576. */
.lk.view-mix-draft .lk-detail
{
	width: 250px;
	margin-left: 16px;
}

.lk.view-mix-draft .lk-aside .lk-slot,
.lk.view-mix-draft .lk-detail .lk-slot
{
	height: 58px;
	margin-bottom: 6px;
}

.lk.view-mix-draft .lk-aside .lk-mark,
.lk.view-mix-draft .lk-detail .lk-mark
{
	margin-left: 12px;
}

.lk.view-mix-draft .lk-aside .lk-slot .lk-text,
.lk.view-mix-draft .lk-detail .lk-slot .lk-text
{
	width: 180px;
	margin-left: 56px;
}

.lk.view-mix-draft .lk-aside .lk-name,
.lk.view-mix-draft .lk-detail .lk-name
{
	max-width: 124px;
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
}

.lk.view-mix-draft .lk-aside .lk-sub,
.lk.view-mix-draft .lk-detail .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

/* A roster's head: the side's emblem, the team and its average, the count. */
.lk.view-mix-draft .lk-aside .grp-head,
.lk.view-mix-draft .lk-detail .grp-head
{
	height: 52px;
}

.lk.view-mix-draft .grp-head .lk-glyph
{
	width: 26px;
	height: 26px;
	margin-left: 12px;
}

.lk.view-mix-draft .grp-head.tone-ct .lk-glyph { wash-color: chudTeamCtBase; }
.lk.view-mix-draft .grp-head.tone-t .lk-glyph { wash-color: chudTeamTBase; }

.lk.view-mix-draft .lk-aside .grp-head .lk-text,
.lk.view-mix-draft .lk-detail .grp-head .lk-text
{
	margin-left: 48px;
}

.lk.view-mix-draft .lk-aside .grp-head .lk-name,
.lk.view-mix-draft .lk-detail .grp-head .lk-name
{
	max-width: 150px;
	font-size: 13px;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-mix-draft .lk-aside .grp-head .lk-sub,
.lk.view-mix-draft .lk-detail .grp-head .lk-sub
{
	font-family: chudFontMedium;
	font-size: 9px;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-mix-draft .grp-head .lk-end
{
	margin-right: 12px;
}

.lk.view-mix-draft .grp-head .lk-value
{
	font-size: 15px;
	color: chudTextMain;
}

/* A pick still to make: its name centred in an outline (the Empty look). */
.lk.view-mix-draft .lk-aside .grp-open .lk-text,
.lk.view-mix-draft .lk-detail .grp-open .lk-text
{
	width: 100%;
	margin: 0px;
}

.lk.view-mix-draft .lk-aside .grp-open .lk-name,
.lk.view-mix-draft .lk-detail .grp-open .lk-name
{
	width: 100%;
	max-width: 250px;
	font-family: chudFontMedium;
	font-size: 11px;
	font-weight: normal;
	color: chudTextFaint;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-mix-draft .lk-aside .grp-open.chosen .lk-name,
.lk.view-mix-draft .lk-detail .grp-open.chosen .lk-name
{
	color: chudAccentStrong;
}

/* Whose pick it is, and the time left to make it. */
.lk.view-mix-draft .lk-banner
{
	margin-bottom: 10px;
}

.lk.view-mix-draft .lk-banner .lk-slot
{
	height: 56px;
	margin: 0px;
}

.lk.view-mix-draft .lk-banner .lk-slot .lk-text
{
	width: 360px;
	margin: 0px;
}

.lk.view-mix-draft .lk-banner .lk-name
{
	font-family: chudFontBody;
	font-size: 24px;
	font-weight: bold;
	color: chudAccentBase;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-mix-draft .lk-banner .lk-end
{
	vertical-align: top;
	margin: 6px 46px 0px 0px;
}

.lk.view-mix-draft .lk-banner .lk-value
{
	font-size: 20px;
	color: chudTextMain;
}

.lk.view-mix-draft .lk-banner .lk-note
{
	vertical-align: top;
	margin: 13px 0px 0px 0px;
}

.lk.view-mix-draft .lk-banner .lk-meter
{
	width: 150px;
	height: 4px;
	margin: 0px 0px 6px 0px;
}

/* The pool: a card per player still to pick. */
.lk.view-mix-draft .lk-list .lk-slot
{
	height: 74px;
	margin-bottom: 8px;
}

.lk.view-mix-draft .lk-list .lk-mark
{
	width: 46px;
	height: 46px;
	margin-left: 14px;
}

.lk.view-mix-draft .lk-list .lk-mark__text
{
	font-size: 20px;
}

.lk.view-mix-draft .lk-list .lk-slot .lk-text
{
	width: 300px;
	margin-left: 74px;
}

.lk.view-mix-draft .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
}

.lk.view-mix-draft .lk-list .lk-sub
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-mix-draft .lk-list .lk-rating
{
	horizontal-align: right;
	margin-right: 16px;
}

.lk.view-mix-draft .lk-list .lk-tags
{
	margin-right: 14px;
}

/* Under the pointer the card's button (Pick) moves in and the rating makes room. */
.lk.view-mix-draft .lk-list .lk-hit:hover .lk-rating
{
	margin-right: 92px;
}

.lk.view-mix-draft .lk-list .lk-tag2
{
	padding: 6px 14px;
	font-family: chudFontBody;
	font-weight: bold;
	visibility: collapse;
}

.lk.view-mix-draft .lk-list .lk-hit:hover .lk-tag2
{
	visibility: visible;
}

/* ---- mix-sides: the knife round's winner, then a card for each side ---- */

.lk.view-mix-sides .lk-banner
{
	margin-bottom: 14px;
}

.lk.view-mix-sides .lk-banner .lk-slot
{
	height: 60px;
	margin: 0px;
}

/* One line: what happened and whose side, then who decides at the end. The tags fill
   the middle (shown even when empty), which is what pushes the note to the edge. */
.lk.view-mix-sides .lk-banner .lk-hit
{
	flow-children: right;
}

.lk.view-mix-sides .lk-banner .lk-glyph
{
	width: 30px;
	height: 30px;
	margin: 0px 0px 0px 22px;
	wash-color: chudTextMain;
}

.lk.view-mix-sides .lk-banner .lk-slot .lk-text
{
	width: fit-children;
	margin: 0px 0px 0px 16px;
}

.lk.view-mix-sides .lk-banner .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-mix-sides .lk-banner .lk-tags
{
	width: fill-parent-flow( 1.0 );
	margin: 0px 0px 0px 6px;
	visibility: visible;
}

.lk.view-mix-sides .lk-banner .lk-note
{
	margin: 0px 22px 0px 0px;
}

/* The two sides: 2 x 546 + 14 = 1106 of 1108. */
.lk.view-mix-sides .lk-list
{
	padding-right: 0px;
}

.lk.view-mix-sides .lk-list .lk-slot
{
	width: 546px;
	height: 498px;
	margin: 0px 0px 0px 14px;
}

.lk.view-mix-sides #option_0
{
	margin-left: 0px;
}

.lk.view-mix-sides .lk-list .lk-glyph
{
	width: 124px;
	height: 124px;
	horizontal-align: center;
	vertical-align: top;
	margin: 96px 0px 0px 0px;
}

.lk.view-mix-sides .lk-list .tone-t .lk-glyph { wash-color: chudTeamTBase; }
.lk.view-mix-sides .lk-list .tone-ct .lk-glyph { wash-color: chudTeamCtBase; }

/* Without an emblem (a plugin sending only Stay and Switch) the name is centred alone. */
.lk.view-mix-sides .lk-list .lk-slot .lk-text
{
	width: 100%;
	horizontal-align: center;
	margin: 0px;
}

.lk.view-mix-sides .lk-list .has-glyph .lk-text
{
	vertical-align: top;
	margin-top: 246px;
}

.lk.view-mix-sides .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 44px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 3px;
}

.lk.view-mix-sides .lk-list .lk-sub
{
	margin-top: 8px;
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-align: center;
	letter-spacing: 1.5px;
}

.lk.view-mix-sides .lk-list .tone-t .lk-sub { color: chudTeamTStrong; }
.lk.view-mix-sides .lk-list .tone-ct .lk-sub { color: chudTeamCtStrong; }

/* What the other team gets, then the votes so far. */
.lk.view-mix-sides .lk-list .lk-note
{
	horizontal-align: center;
	vertical-align: top;
	margin: 346px 0px 0px 0px;
	color: chudTextFaint;
}

.lk.view-mix-sides .lk-list .lk-end
{
	horizontal-align: center;
	vertical-align: top;
	margin: 384px 0px 0px 0px;
}

.lk.view-mix-sides .lk-list .lk-value
{
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-mix-sides .lk-list .lk-meter
{
	width: 140px;
	horizontal-align: center;
	vertical-align: top;
	margin: 408px 0px 0px 0px;
}

/* Your vote, in the card's corner. */
.lk.view-mix-sides .lk-list .lk-tags
{
	horizontal-align: right;
	vertical-align: top;
	margin: 14px 14px 0px 0px;
}

.lk.view-mix-sides .lk-list .lk-tag
{
	padding: 3px 9px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* A side ahead in the vote is tagged Leading, with its trophy in the 9px padding. */
.lk.view-mix-sides .lk-list .lk-tagglyph
{
	margin: 0px -28px 0px 16px;
}

.lk.view-mix-sides .lk-list .has-tagglyph .lk-tag
{
	padding-left: 26px;
}

/* ---- mix-ballot: a vote everyone in a team gets mid-round, docked at the side ---- */

.lk.view-mix-ballot
{
	width: 440px;
	horizontal-align: left;
	margin-left: 64px;
}

/* The timer in the corner, the question under the eyebrow. */
.lk.view-mix-ballot .lk-head
{
	flow-children: none;
}

.lk.view-mix-ballot .lk-titles
{
	width: 100%;
}

.lk.view-mix-ballot .lk-title
{
	max-width: 400px;
	font-size: 24px;
}

.lk.view-mix-ballot .lk-chips
{
	height: fit-children;
	horizontal-align: right;
	vertical-align: top;
}

.lk.view-mix-ballot .lk-chip
{
	height: 22px;
	margin-left: 6px;
	padding: 0px 8px;
}

.lk.view-mix-ballot .lk-chip__glyph
{
	width: 12px;
	height: 12px;
	margin-right: 6px;
}

.lk.view-mix-ballot .lk-chip__value
{
	font-size: 13px;
}

.lk.view-mix-ballot .lk-chip__label
{
	margin-left: 5px;
	font-size: 9px;
	letter-spacing: 1.5px;
}

.lk.view-mix-ballot .lk-divider
{
	margin: 8px 0px 12px 0px;
}

/* Sized to what it holds rather than the page's 576px. */
.lk.view-mix-ballot .lk-content,
.lk.view-mix-ballot .lk-main,
.lk.view-mix-ballot .lk-body,
.lk.view-mix-ballot .lk-col,
.lk.view-mix-ballot .lk-listbox,
.lk.view-mix-ballot .lk-list
{
	height: fit-children;
}

.lk.view-mix-ballot .lk-listbox
{
	overflow: noclip noclip;
}

.lk.view-mix-ballot .lk-list
{
	padding-right: 0px;
	overflow: noclip noclip;
}

.lk.view-mix-ballot .lk-items
{
	flow-children: right;
}

.lk.view-mix-ballot.chud-rewind .lk-items
{
	height: fit-children;
	overflow: squish squish;
}

/* Who called it on one line; a kick's target below as a player card. */
.lk.view-mix-ballot .lk-banner
{
	margin-bottom: 4px;
	flow-children: down;
}

.lk.view-mix-ballot .lk-banner .lk-slot
{
	height: 24px;
	margin: 0px 0px 10px 0px;
}

.lk.view-mix-ballot .lk-banner .lk-hit
{
	flow-children: right;
}

.lk.view-mix-ballot .lk-banner .lk-mark
{
	width: 22px;
	height: 22px;
	margin: 0px 8px 0px 0px;
}

.lk.view-mix-ballot .lk-banner .lk-mark__text
{
	font-size: 11px;
}

.lk.view-mix-ballot .lk-banner .lk-slot .lk-text
{
	width: fit-children;
	margin: 0px;
	flow-children: right;
}

.lk.view-mix-ballot .lk-banner .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
}

.lk.view-mix-ballot .lk-banner .lk-sub
{
	width: fit-children;
	margin: 0px 0px 0px 6px;
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-mix-ballot .lk-banner .lk-tags
{
	margin: 0px 0px 0px 6px;
}

.lk.view-mix-ballot .lk-banner .has-rating
{
	height: 52px;
	margin-bottom: 12px;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-hit
{
	flow-children: none;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-mark
{
	width: 30px;
	height: 30px;
	margin: 0px 0px 0px 12px;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-mark__text
{
	font-size: 14px;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-text
{
	width: 230px;
	margin: 0px 0px 0px 54px;
	flow-children: down;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-name
{
	font-size: 13px;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-sub
{
	margin: 2px 0px 0px 0px;
}

.lk.view-mix-ballot .lk-banner .has-rating .lk-rating
{
	horizontal-align: right;
	margin-right: 12px;
}

/* Yes | No: 2 x 199 + 10 = 408. The glyph and word sit centred together, the rarity
   layer and the tags filling either side of them. */
.lk.view-mix-ballot .lk-list .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 46px;
	margin: 0px 0px 0px 10px;
}

.lk.view-mix-ballot #option_0
{
	margin-left: 0px;
}

.lk.view-mix-ballot .lk-list .lk-hit
{
	flow-children: right;
}

.lk.view-mix-ballot .lk-list .lk-rarity,
.lk.view-mix-ballot .lk-list .lk-rarity.hidden,
.lk.view-mix-ballot .lk-list .lk-tags
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin: 0px;
	visibility: visible;
}

.lk.view-mix-ballot .lk-list .lk-glyph
{
	width: 16px;
	height: 16px;
	margin: 0px 10px 0px 0px;
}

.lk.view-mix-ballot .lk-list .tone-good .lk-glyph { wash-color: chudSuccessBase; }
.lk.view-mix-ballot .lk-list .tone-bad .lk-glyph { wash-color: chudDangerBase; }

.lk.view-mix-ballot .lk-list .lk-slot .lk-text
{
	width: fit-children;
	margin: 0px;
}

.lk.view-mix-ballot .lk-list .lk-name
{
	width: fit-children;
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

/* Turnout as pips, then the rule that passes it, ruled off below. */
.lk.view-mix-ballot .lk-foot
{
	margin-top: 14px;
	flow-children: down;
}

.lk.view-mix-ballot .lk-foot .lk-slot
{
	height: 24px;
	margin: 0px;
}

.lk.view-mix-ballot .lk-foot .lk-pips
{
	width: 290px;
	height: 8px;
	horizontal-align: left;
	vertical-align: center;
}

.lk.view-mix-ballot .lk-foot .lk-pip
{
	margin-right: 4px;
}

.lk.view-mix-ballot .lk-foot .lk-slot .lk-text
{
	width: fit-children;
	horizontal-align: right;
	margin: 0px;
}

.lk.view-mix-ballot .lk-foot .lk-name
{
	width: fit-children;
	font-family: chudFontMedium;
	font-size: 11px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-mix-ballot .lk-foot .has-glyph
{
	height: 34px;
	margin-top: 10px;
}

.lk.view-mix-ballot .lk-foot .has-glyph .lk-hit
{
	border-top: 1px solid chudSurfaceEdge;
}

.lk.view-mix-ballot .lk-foot .has-glyph .lk-glyph
{
	width: 12px;
	height: 12px;
	margin: 4px 0px 0px 0px;
	wash-color: chudTextFaint;
}

.lk.view-mix-ballot .lk-foot .has-glyph .lk-text
{
	horizontal-align: left;
	margin: 4px 0px 0px 20px;
}

.lk.view-mix-ballot .lk-foot .has-glyph .lk-name
{
	color: chudTextFaint;
}

.lk.view-mix-ballot .lk-foot .lk-end
{
	margin: 4px 0px 0px 0px;
}

.lk.view-mix-ballot .lk-foot .lk-value
{
	font-family: chudFontBody;
	font-size: 11px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* ---- mix-control: where the mix is, and every admin command as a tile ---- */

.lk.view-mix-control .lk-col
{
	width: 330px;
	padding: 14px 18px;
}

.lk.view-mix-control .lk-detail
{
	width: fill-parent-flow( 1.0 );
	margin-left: 18px;
}

.lk.view-mix-control .lk-list
{
	padding-right: 0px;
}

/* The steps: a circle each, joined by a line, the done ones ticked. The line hangs
   below its own slot into the next one's, so neither may clip it. */
.lk.view-mix-control .lk-list .has-mark,
.lk.view-mix-control .lk-list .has-glyph
{
	height: 52px;
	margin: 0px;
	overflow: noclip noclip;
}

.lk.view-mix-control .lk-list .has-mark .lk-hit,
.lk.view-mix-control .lk-list .has-glyph .lk-hit
{
	overflow: noclip noclip;
}

.lk.view-mix-control .lk-list .lk-mark
{
	width: 28px;
	height: 28px;
	margin: 0px 0px 0px 12px;
	border: 1px solid chudSurfaceEdge;
	border-radius: 14px;
	background-color: transparent;
}

.lk.view-mix-control .lk-list .lk-mark__text
{
	font-family: chudDigitsBold;
	font-size: 12px;
	color: chudTextFaint;
}

.lk.view-mix-control .lk-list .grp-current .lk-mark
{
	border: 1px solid chudAccentBase;
	background-color: chudAccentSoft;
}

.lk.view-mix-control .lk-list .grp-current .lk-mark__text
{
	color: chudAccentStrong;
}

/* A done step: the rarity layer is its circle, the tick on top. */
.lk.view-mix-control .lk-list .grp-done .lk-rarity,
.lk.view-mix-control .lk-list .grp-done .lk-rarity.hidden
{
	width: 28px;
	height: 28px;
	horizontal-align: left;
	vertical-align: center;
	margin-left: 12px;
	border: 1px solid chudSuccessDim;
	border-radius: 14px;
	background-color: chudSuccessSoft;
	visibility: visible;
}

.lk.view-mix-control .lk-list .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 19px;
	wash-color: chudSuccessBase;
}

.lk.view-mix-control .lk-list .has-mark .lk-shade,
.lk.view-mix-control .lk-list .has-glyph .lk-shade
{
	width: 2px;
	height: 24px;
	horizontal-align: left;
	vertical-align: top;
	margin: 40px 0px 0px 25px;
	background-color: chudSurfaceEdge;
	visibility: visible;
}

.lk.view-mix-control .lk-list .grp-done .lk-shade
{
	background-color: chudSuccessDim;
}

.lk.view-mix-control .lk-list .has-mark .lk-text,
.lk.view-mix-control .lk-list .has-glyph .lk-text
{
	width: 230px;
	margin-left: 56px;
}

.lk.view-mix-control .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-mix-control .lk-list .grp-done .lk-name { color: chudTextMain; }
.lk.view-mix-control .lk-list .grp-current .lk-name { color: chudAccentStrong; }

.lk.view-mix-control .lk-list .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

/* The commands: tiles under their headings, 5 x (136 + 10) = 730 of 760. */
.lk.view-mix-control .lk-detail__items
{
	flow-children: right-wrap;
}

.lk.view-mix-control .lk-detail .lk-slot.section
{
	height: 22px;
	margin: 4px 0px 8px 0px;
}

.lk.view-mix-control .lk-detail .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

.lk.view-mix-control .lk-detail .kind-action,
.lk.view-mix-control .lk-detail .kind-toggle,
.lk.view-mix-control .lk-detail .kind-submenu
{
	width: 136px;
	height: 96px;
	margin: 0px 10px 10px 0px;
}

.lk.view-mix-control .lk-detail .lk-glyph
{
	width: 28px;
	height: 28px;
	horizontal-align: center;
	vertical-align: top;
	margin: 20px 0px 0px 0px;
	wash-color: chudTextMain;
}

.lk.view-mix-control .lk-detail .is-on .lk-glyph
{
	wash-color: chudAccentStrong;
}

.lk.view-mix-control .lk-detail .kind-action .lk-text,
.lk.view-mix-control .lk-detail .kind-toggle .lk-text,
.lk.view-mix-control .lk-detail .kind-submenu .lk-text
{
	width: 100%;
	horizontal-align: center;
	vertical-align: bottom;
	margin: 0px 0px 16px 0px;
}

.lk.view-mix-control .lk-detail .lk-name
{
	font-family: chudFontBody;
	font-size: 11px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

/* A switch is the tile itself, lit when on (the Chosen look); a page opens from the
   tile, so it carries the chevron in its corner. */
.lk.view-mix-control .lk-detail .lk-switch,
.lk.view-mix-control .lk-detail .lk-end
{
	visibility: collapse;
}

.lk.view-mix-control .lk-detail .kind-submenu .lk-chev
{
	horizontal-align: right;
	vertical-align: top;
	margin: 2px 8px 0px 0px;
	font-size: 16px;
	visibility: visible;
}

.lk.view-mix-control .lk-detail .grp-hint
{
	width: 100%;
	height: 28px;
	margin: 6px 0px 0px 0px;
}

.lk.view-mix-control .lk-detail .grp-hint .lk-glyph
{
	width: 12px;
	height: 12px;
	horizontal-align: left;
	vertical-align: center;
	margin: 0px;
	wash-color: chudTextFaint;
}

.lk.view-mix-control .lk-detail .grp-hint .lk-text
{
	margin-left: 20px;
}

.lk.view-mix-control .lk-detail .grp-hint .lk-name
{
	font-family: chudFontMedium;
	font-weight: normal;
	color: chudTextFaint;
	text-align: left;
}

/* The last step has nothing to join on to; hk-rows-N on the list says which it is. */
/* A rule per line: CS2 rejects the whole sheet when one rule lists too many selectors. */
.lk.view-mix-control .hk-rows-1 #option_0 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-2 #option_1 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-3 #option_2 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-4 #option_3 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-5 #option_4 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-6 #option_5 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-7 #option_6 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-8 #option_7 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-9 #option_8 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-10 #option_9 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-11 #option_10 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-12 #option_11 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-13 #option_12 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-14 #option_13 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-15 #option_14 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-16 #option_15 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-17 #option_16 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-18 #option_17 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-19 #option_18 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-20 #option_19 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-21 #option_20 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-22 #option_21 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-23 #option_22 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-24 #option_23 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-25 #option_24 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-26 #option_25 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-27 #option_26 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-28 #option_27 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-29 #option_28 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-30 #option_29 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-31 #option_30 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-32 #option_31 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-33 #option_32 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-34 #option_33 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-35 #option_34 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-36 #option_35 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-37 #option_36 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-38 #option_37 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-39 #option_38 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-40 #option_39 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-41 #option_40 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-42 #option_41 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-43 #option_42 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-44 #option_43 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-45 #option_44 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-46 #option_45 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-47 #option_46 .lk-shade { visibility: collapse; }
.lk.view-mix-control .hk-rows-48 #option_47 .lk-shade { visibility: collapse; }
