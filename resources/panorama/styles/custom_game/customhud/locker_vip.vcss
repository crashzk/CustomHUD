/*
	VIPCore's views on menu_locker. A tier's colour arrives as its tone: info (VIP),
	gold (PREMIUM), legend (LEGEND); the block at the end applies it to glyphs and names.
*/

/* ---- vip-perks: the membership card, then a tile per perk ---- */

.lk.view-vip-perks .lk-banner
{
	height: 112px;
	margin-bottom: 10px;
	flow-children: none;
	background-color: gradient( radial, 6% 50%, 0% 0%, 38% 90%, from( chudGoldSoft ), to( chudGoldFade ) );
}

/* Column one: the tier, its emblem large. */
.lk.view-vip-perks #banner_0
{
	width: 320px;
	height: 100%;
	margin: 0px;
}

.lk.view-vip-perks #banner_0 .lk-glyph
{
	width: 54px;
	height: 54px;
	margin-left: 25px;
}

.lk.view-vip-perks #banner_0 .lk-text
{
	width: 200px;
	vertical-align: top;
	margin: 18px 0px 0px 104px;
}

.lk.view-vip-perks #banner_0 .lk-name
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 34px;
	font-weight: bold;
	letter-spacing: 3px;
}

.lk.view-vip-perks #banner_0 .lk-sub
{
	margin-top: 4px;
	font-size: 11px;
	letter-spacing: 1px;
}

/* Column two: when it ends. */
.lk.view-vip-perks #banner_1
{
	width: 236px;
	height: 100%;
	margin: 0px 0px 0px 320px;
	border-left: 1px solid chudSurfaceEdge;
}

.lk.view-vip-perks #banner_1 .lk-text
{
	width: 192px;
	vertical-align: top;
	margin: 18px 0px 0px 22px;
}

.lk.view-vip-perks #banner_1 .lk-name
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 22px;
	font-weight: bold;
}

.lk.view-vip-perks #banner_1 .lk-meter
{
	width: 192px;
	height: 6px;
	horizontal-align: left;
	vertical-align: top;
	margin: 66px 0px 0px 22px;
	border-radius: 3px;
	background-color: chudShadowDim;
}

.lk.view-vip-perks #banner_1 .chud-meter__fill
{
	border-radius: 3px;
}

.lk.view-vip-perks #banner_1 .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 80px 0px 0px 22px;
	font-size: 12px;
	color: chudTextMuted;
	letter-spacing: 1px;
}

/* Column three: a caption, then one row per group. */
.lk.view-vip-perks #banner_2,
.lk.view-vip-perks #banner_3,
.lk.view-vip-perks #banner_4
{
	width: 324px;
	height: 30px;
	margin: 0px 0px 0px 556px;
	padding: 0px 16px;
	border-left: 1px solid chudSurfaceEdge;
}

.lk.view-vip-perks #banner_2
{
	height: 112px;
}

.lk.view-vip-perks #banner_2 .lk-text
{
	vertical-align: top;
	margin: 14px 0px 0px 0px;
}

.lk.view-vip-perks #banner_2 .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 2px;
}

.lk.view-vip-perks #banner_3,
.lk.view-vip-perks #banner_4
{
	width: 302px;
	margin-left: 571px;
	padding: 0px;
	border-left: 0px solid transparent;
}

.lk.view-vip-perks #banner_3 { margin-top: 36px; }
.lk.view-vip-perks #banner_4 { margin-top: 70px; }

.lk.view-vip-perks #banner_3 .lk-hit,
.lk.view-vip-perks #banner_4 .lk-hit
{
	border: 1px solid transparent;
	border-radius: 3px;
	background-color: chudShadowSoft;
}

.lk.view-vip-perks #banner_3.chosen .lk-hit,
.lk.view-vip-perks #banner_4.chosen .lk-hit
{
	border: 1px solid chudGoldDim;
}

.lk.view-vip-perks #banner_3 .lk-glyph,
.lk.view-vip-perks #banner_4 .lk-glyph
{
	width: 13px;
	height: 13px;
	margin-left: 10px;
}

.lk.view-vip-perks #banner_3 .lk-text,
.lk.view-vip-perks #banner_4 .lk-text
{
	width: 190px;
	margin-left: 30px;
	flow-children: right;
}

.lk.view-vip-perks #banner_3 .lk-name,
.lk.view-vip-perks #banner_4 .lk-name
{
	width: 82px;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	letter-spacing: 1.5px;
}

.lk.view-vip-perks #banner_3 .lk-sub,
.lk.view-vip-perks #banner_4 .lk-sub
{
	width: fit-children;
	margin-top: 0px;
	font-size: 10px;
	letter-spacing: 1px;
}

.lk.view-vip-perks #banner_3 .lk-note,
.lk.view-vip-perks #banner_4 .lk-note
{
	margin-right: 10px;
	font-size: 9px;
	letter-spacing: 1px;
}

/* The perks: 4 x (212 + 6) = 872 of 882, a switch or a picked value in the corner. The
   section heading keeps its own full-width shape (base rule) ahead of them. */
.lk.view-vip-perks .lk-list .lk-slot.kind-toggle,
.lk.view-vip-perks .lk-list .lk-slot.kind-submenu
{
	width: 212px;
	height: 126px;
	margin: 0px 6px 8px 0px;
}

/* The rarity layer, under every part, is the icon's square. */
.lk.view-vip-perks .lk-list .kind-toggle .lk-rarity,
.lk.view-vip-perks .lk-list .kind-toggle .lk-rarity.hidden,
.lk.view-vip-perks .lk-list .kind-submenu .lk-rarity,
.lk.view-vip-perks .lk-list .kind-submenu .lk-rarity.hidden
{
	width: 40px;
	height: 40px;
	horizontal-align: left;
	vertical-align: top;
	margin: 14px 0px 0px 14px;
	border-radius: 4px;
	background-color: chudSurfaceRow;
	visibility: visible;
}

.lk.view-vip-perks .lk-list .is-on .lk-rarity,
.lk.view-vip-perks .lk-list .kind-submenu .lk-rarity
{
	background-color: chudAccentSoft;
}

.lk.view-vip-perks .lk-list .lk-glyph
{
	width: 22px;
	height: 22px;
	vertical-align: top;
	margin: 23px 0px 0px 23px;
	wash-color: chudTextFaint;
}

.lk.view-vip-perks .lk-list .is-on .lk-glyph,
.lk.view-vip-perks .lk-list .kind-submenu .lk-glyph
{
	wash-color: chudAccentStrong;
}

.lk.view-vip-perks .lk-list .lk-slot.kind-toggle .lk-text,
.lk.view-vip-perks .lk-list .lk-slot.kind-submenu .lk-text
{
	width: 184px;
	vertical-align: top;
	margin: 66px 0px 0px 14px;
}

.lk.view-vip-perks .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-vip-perks .lk-list .lk-sub
{
	margin-top: 4px;
	font-size: 12px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-vip-perks .lk-list .kind-toggle .lk-name { color: chudTextMuted; }
.lk.view-vip-perks .lk-list .kind-toggle .lk-sub { color: chudTextFaint; }
.lk.view-vip-perks .lk-list .kind-toggle.is-on .lk-name { color: chudTextMain; }
.lk.view-vip-perks .lk-list .kind-toggle.is-on .lk-sub { color: chudTextMuted; }

.lk.view-vip-perks .lk-list .lk-switch
{
	vertical-align: top;
	margin: 14px 14px 0px 0px;
}

/* A picker's current value, boxed, with the way in beside it. */
.lk.view-vip-perks .lk-list .kind-submenu .lk-end
{
	height: 26px;
	vertical-align: top;
	margin: 14px 14px 0px 0px;
	padding: 0px 22px 0px 10px;
}

.lk.view-vip-perks .lk-list .kind-submenu .lk-chev
{
	vertical-align: top;
	margin: 14px 22px 0px 0px;
	font-size: 18px;
	visibility: visible;
}

/* ---- vip-options: field-of-view cards, then chat tags as chat lines ---- */

.lk.view-vip-options .grp-fov
{
	width: 212px;
	height: 176px;
	margin: 0px 6px 8px 0px;
}

.lk.view-vip-options .grp-fov .lk-glyph
{
	width: 72px;
	height: 44px;
	horizontal-align: center;
	vertical-align: top;
	margin: 34px 0px 0px 0px;
}

.lk.view-vip-options .grp-fov.chosen .lk-glyph
{
	wash-color: chudAccentBase;
}

.lk.view-vip-options .grp-fov .lk-text
{
	width: 100%;
	horizontal-align: center;
	vertical-align: top;
	margin: 100px 0px 0px 0px;
}

.lk.view-vip-options .grp-fov .lk-name
{
	font-family: chudDigitsBold;
	font-size: 34px;
	text-align: center;
}

.lk.view-vip-options .grp-fov .lk-sub
{
	margin-top: 2px;
	font-size: 11px;
	text-align: center;
	letter-spacing: 1px;
}

/* A card shows one marker: the default's on the left, the one in use on the right. */
.lk.view-vip-options .grp-fov .lk-tags
{
	vertical-align: top;
	margin: 8px 8px 0px 0px;
}

.lk.view-vip-options .grp-fov.has-tag2 .lk-tags
{
	horizontal-align: left;
	margin: 8px 0px 0px 8px;
}

.lk.view-vip-options .grp-fov .lk-tag,
.lk.view-vip-options .grp-fov .lk-tag2
{
	margin: 0px;
	padding: 2px 7px;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
}

.lk.view-vip-options .grp-chattag
{
	height: 46px;
	margin-bottom: 6px;
}

/* "[PREMIUM] nadeking: gg wp", as the chat prints it. */
.lk.view-vip-options .grp-chattag .lk-text
{
	width: fit-children;
	margin-left: 16px;
	flow-children: right;
}

.lk.view-vip-options .grp-chattag .lk-type,
.lk.view-vip-options .grp-chattag .lk-name,
.lk.view-vip-options .grp-chattag .lk-sub
{
	width: fit-children;
	vertical-align: center;
	margin: 0px;
	font-family: chudFontBody;
	font-size: 16px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-vip-options .grp-chattag .lk-type
{
	margin-right: 8px;
	font-weight: bold;
	color: chudTextMain;
}

.lk.view-vip-options .grp-chattag .lk-name
{
	font-weight: bold;
	color: chudInfoStrong;
}

.lk.view-vip-options .grp-chattag .lk-sub
{
	color: chudTextMain;
}

.lk.view-vip-options .grp-chattag.tone-info .lk-type { color: chudInfoBase; }
.lk.view-vip-options .grp-chattag.tone-gold .lk-type { color: chudGoldBase; }
.lk.view-vip-options .grp-chattag.tone-good .lk-type { color: chudSuccessBase; }

.lk.view-vip-options .grp-chattag .lk-note
{
	margin-right: 16px;
}

/* ---- vip-guns: the group's guns as cards, the loadout bar under them ---- */

/* 6 x (136 + 8) = 864 and 9 x (88 + 8) = 864 of the list's 882. */
.lk.view-vip-guns .lk-list .lk-slot.grp-primary
{
	width: 136px;
	height: 196px;
	margin: 0px 8px 8px 0px;
}

.lk.view-vip-guns .lk-list .lk-slot.grp-pistol
{
	width: 88px;
	height: 148px;
	margin: 0px 8px 8px 0px;
}

.lk.view-vip-guns .lk-list .lk-slot.section
{
	width: 100%;
}

.lk.view-vip-guns .lk-list .kind-action .lk-thumb
{
	width: 126px;
	height: 150px;
	horizontal-align: center;
	vertical-align: top;
	margin: 0px;
}

.lk.view-vip-guns .lk-list .grp-pistol .lk-thumb
{
	width: 82px;
	height: 112px;
}

/* Name at the foot; the category, when there is one, in the top corner. */
.lk.view-vip-guns .lk-list .kind-action .lk-text
{
	width: 100%;
	height: 100%;
	margin: 0px;
}

.lk.view-vip-guns .lk-list .kind-action .lk-type
{
	margin: 8px 0px 0px 9px;
	font-size: 9px;
	color: chudInfoBase;
	letter-spacing: 1.5px;
}

.lk.view-vip-guns .lk-list .kind-action .lk-name
{
	vertical-align: bottom;
	margin-bottom: 22px;
	padding: 0px 8px;
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* lk-text fills the card and stacks its labels, so the name sits at the foot. */
.lk.view-vip-guns .lk-list .kind-action .lk-text
{
	flow-children: none;
}

.lk.view-vip-guns .lk-list .kind-action .lk-type
{
	vertical-align: top;
}

.lk.view-vip-guns .lk-list .grp-pistol .lk-name
{
	margin-bottom: 18px;
	padding: 0px 4px;
	font-size: 11px;
	letter-spacing: 0.5px;
}

.lk.view-vip-guns .lk-foot
{
	height: 76px;
	margin-top: 14px;
	padding: 0px 14px 0px 20px;
}

.lk.view-vip-guns .lk-foot .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin: 0px;
}

.lk.view-vip-guns .lk-foot .lk-slot .lk-text
{
	width: 300px;
	margin-left: 0px;
}

.lk.view-vip-guns .lk-foot .lk-name
{
	margin-top: 4px;
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-vip-guns .lk-foot .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 320px;
}

.lk.view-vip-guns .lk-foot .lk-note
{
	horizontal-align: left;
	margin: 0px 0px 0px 342px;
	font-size: 12px;
	letter-spacing: 1px;
}

.lk.view-vip-guns .lk-content .lk-foot .lk-slot.primary,
.lk.view-vip-tiers .lk-content .lk-foot .lk-slot.primary,
.lk.view-vip-grant .lk-content .lk-detail__bar .lk-slot.primary
{
	width: 210px;
	height: 46px;
	vertical-align: center;
}

/* ---- the primary button, wherever a VIP view puts one ---- */

.lk.view-vip-guns .lk-content .lk-slot.primary .lk-text,
.lk.view-vip-tiers .lk-content .lk-slot.primary .lk-text,
.lk.view-vip-grant .lk-content .lk-slot.primary .lk-text
{
	width: fit-children;
	horizontal-align: center;
	margin: 0px;
}

.lk.view-vip-guns .lk-content .lk-slot.primary .lk-name,
.lk.view-vip-tiers .lk-content .lk-slot.primary .lk-name,
.lk.view-vip-grant .lk-content .lk-slot.primary .lk-name
{
	width: fit-children;
	margin: 0px;
	font-family: chudFontBody;
	font-size: 15px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 2px;
}

/* ---- vip-tiers: three tier heads over a comparison, the featured tier in the middle ---- */

/* The label column takes what the three 204px value columns leave of the list's 882. */
.lk.view-vip-tiers .lk-banner
{
	width: 882px;
	margin-bottom: 0px;
	padding-left: 270px;
}

.lk.view-vip-tiers .lk-banner .lk-slot
{
	width: 196px;
	height: 78px;
	margin: 0px 0px 0px 8px;
}

.lk.view-vip-tiers .lk-banner .lk-hit,
.lk.view-vip-tiers .lk-banner .lk-hit:hover
{
	border-top: 1px solid chudSurfaceEdge;
	border-right: 1px solid chudSurfaceEdge;
	border-left: 1px solid chudSurfaceEdge;
	border-bottom: 0px solid chudSurfaceEdge;
	border-radius: 6px 6px 0px 0px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( chudTileBase ), to( chudTileDeep ) );
}

.lk.view-vip-tiers .lk-banner .lk-slot.chosen .lk-hit
{
	border-top: 1px solid chudGoldHalf;
	border-right: 1px solid chudGoldHalf;
	border-left: 1px solid chudGoldHalf;
	border-bottom: 0px solid chudGoldHalf;
}

.lk.view-vip-tiers .lk-banner .lk-glyph
{
	width: 24px;
	height: 24px;
	horizontal-align: center;
	vertical-align: top;
	margin: 12px 0px 0px 0px;
}

.lk.view-vip-tiers .lk-banner .lk-slot .lk-text
{
	width: 100%;
	vertical-align: top;
	margin: 42px 0px 0px 0px;
}

.lk.view-vip-tiers .lk-banner .lk-name
{
	font-family: chudFontBody;
	font-size: 17px;
	font-weight: bold;
	text-align: center;
	letter-spacing: 2px;
}

.lk.view-vip-tiers .lk-banner .lk-sub
{
	text-align: center;
}

.lk.view-vip-tiers .lk-banner .lk-tags
{
	horizontal-align: center;
	vertical-align: top;
	margin: 0px;
}

.lk.view-vip-tiers .lk-banner .lk-tag
{
	margin: 0px;
	padding: 2px 9px;
	border-radius: 0px 0px 3px 3px;
	font-family: chudFontBody;
	font-size: 9px;
	font-weight: bold;
}

/* The rows: a label, then one cell per tier. */
.lk.view-vip-tiers .lk-list .lk-slot
{
	height: 30px;
	margin: 0px;
}

.lk.view-vip-tiers .lk-list .lk-hit,
.lk.view-vip-tiers .lk-list .lk-hit:hover
{
	border-top: 1px solid chudGlassWash;
	border-right: 0px solid chudGlassWash;
	border-bottom: 0px solid chudGlassWash;
	border-left: 0px solid chudGlassWash;
	border-radius: 0px;
	background-color: transparent;
}

.lk.view-vip-tiers .lk-list .lk-glyph
{
	width: 15px;
	height: 15px;
	wash-color: chudTextFaint;
}

.lk.view-vip-tiers .lk-list .lk-slot .lk-text
{
	width: 220px;
	margin-left: 37px;
}

.lk.view-vip-tiers .lk-list .lk-name
{
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1px;
}

/* Each cell centred in its 196px column. */
.lk.view-vip-tiers .lk-list .lk-tags,
.lk.view-vip-tiers .lk-list .lk-end,
.lk.view-vip-tiers .lk-list .lk-note
{
	width: 196px;
	height: 100%;
	horizontal-align: left;
	margin: 0px;
}

.lk.view-vip-tiers .lk-list .lk-tags { margin-left: 278px; }
.lk.view-vip-tiers .lk-list .lk-end { margin-left: 482px; }
.lk.view-vip-tiers .lk-list .lk-note { margin-left: 686px; }

.lk.view-vip-tiers .lk-list .lk-tag
{
	width: 100%;
	vertical-align: center;
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	color: chudTextMain;
	text-align: center;
	text-transform: none;
	letter-spacing: 0px;
}

/* The featured column runs from its head to the table's foot. */
.lk.view-vip-tiers .lk-list .lk-end
{
	border-left: 1px solid chudGoldSoft;
	border-right: 1px solid chudGoldSoft;
	background-color: chudGoldWash;
}

.lk.view-vip-tiers .lk-list .lk-value
{
	width: 100%;
	vertical-align: center;
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	color: chudTextMain;
	text-align: center;
}

.lk.view-vip-tiers .lk-list .lk-note
{
	padding-top: 7px;
	font-family: chudFontBody;
	font-size: 13px;
	font-weight: bold;
	color: chudTextMain;
	text-align: center;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-vip-tiers .lk-list .tag-good .lk-tag { color: chudSuccessBase; }
.lk.view-vip-tiers .lk-list .tag-faint .lk-tag { color: chudTextFaint; }
.lk.view-vip-tiers .lk-list .tone-good .lk-value { color: chudSuccessBase; }
.lk.view-vip-tiers .lk-list .tone-faint .lk-value { color: chudTextFaint; }
.lk.view-vip-tiers .lk-list .note-good .lk-note { color: chudSuccessBase; }
.lk.view-vip-tiers .lk-list .note-faint .lk-note { color: chudTextFaint; }

/* The trial offer under the table. */
.lk.view-vip-tiers .lk-foot
{
	height: 62px;
	margin-top: 12px;
	padding: 0px 14px;
	border: 1px solid chudAccentDim;
	border-radius: 6px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( chudAccentSoft ), color-stop( 0.7, chudAccentFade ), to( chudAccentFade ) );
}

.lk.view-vip-tiers .lk-foot .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	margin: 0px;
}

/* The gift in its own square: foot slots have no rarity layer, so the shade draws it. */
.lk.view-vip-tiers .lk-foot .has-glyph .lk-shade
{
	width: 38px;
	height: 38px;
	horizontal-align: left;
	vertical-align: center;
	border-radius: 4px;
	background-color: chudAccentSoft;
	visibility: visible;
}

.lk.view-vip-tiers .lk-foot .lk-glyph
{
	width: 20px;
	height: 20px;
	margin-left: 9px;
	wash-color: chudAccentStrong;
}

.lk.view-vip-tiers .lk-foot .lk-slot .lk-text
{
	width: 500px;
	margin-left: 52px;
}

.lk.view-vip-tiers .lk-foot .lk-name
{
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-vip-tiers .lk-foot .lk-sub
{
	font-size: 12px;
	letter-spacing: 1px;
}

.lk.view-vip-tiers .lk-content .lk-foot .lk-slot.primary
{
	width: 190px;
}

/* ---- vip-users: the VIPs as a table, the selected one's groups beside it ---- */

.lk.view-vip-users .lk-thead
{
	padding: 0px 12px 4px 10px;
}

.lk.view-vip-users .lk-col-head
{
	color: chudAccentStrong;
}

.lk.view-vip-users .lk-col-head-0 { width: 178px; }
.lk.view-vip-users .lk-col-head-1 { width: 176px; }

.lk.view-vip-users .lk-list .lk-slot
{
	height: 46px;
	margin: 4px 0px 0px 0px;
}

.lk.view-vip-users .lk-list .lk-slot .lk-text
{
	width: 130px;
	margin-left: 52px;
}

.lk.view-vip-users .lk-list .lk-name
{
	font-size: 14px;
}

.lk.view-vip-users .lk-list .lk-sub
{
	font-family: chudFontBody;
	font-size: 11px;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-vip-users .lk-list .lk-tags
{
	horizontal-align: left;
	margin: 0px 0px 0px 182px;
}

/* Expires: the date, the days left at the column's end, a bar under both. */
.lk.view-vip-users .lk-list .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 9px 0px 0px 300px;
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: none;
	letter-spacing: 0px;
}

.lk.view-vip-users .lk-list .note-gold .lk-note
{
	vertical-align: center;
	margin-top: 0px;
	font-size: 11px;
	color: chudGoldBase;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-vip-users .lk-list .lk-end
{
	vertical-align: top;
	margin: 10px 12px 0px 0px;
}

.lk.view-vip-users .lk-list .lk-value
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-vip-users .lk-list .tone-bad .lk-value
{
	color: chudDangerStrong;
}

.lk.view-vip-users .lk-list .lk-meter
{
	width: 228px;
	height: 4px;
	horizontal-align: left;
	vertical-align: top;
	margin: 30px 0px 0px 300px;
	border-radius: 2px;
	background-color: chudShadowDim;
}

.lk.view-vip-users .lk-list .chud-meter__fill
{
	border-radius: 2px;
}

/* Time left reads the same on the selected row; only an ending one turns red (metertone). */
.lk.view-vip-users .lk-slot.chosen .chud-meter__fill
{
	background-color: chudInfoBase;
}

.lk.view-vip-users .lk-slot.chosen.meter-bad .chud-meter__fill
{
	background-color: chudDangerBase;
}

/* The detail pane: one card holding its buttons, its items wrapping so the extend steps share a line. */
.lk.view-vip-users .lk-detail
{
	padding: 16px;
}

.lk.view-vip-users .lk-detail__items
{
	flow-children: right-wrap;
}

.lk.view-vip-users .grp-head
{
	height: 70px;
}

.lk.view-vip-users .grp-head .lk-mark
{
	width: 64px;
	height: 64px;
	margin: 0px;
	border-radius: 4px;
}

.lk.view-vip-users .grp-head .lk-mark__text
{
	font-size: 30px;
}

.lk.view-vip-users .grp-head .lk-text
{
	width: 200px;
	vertical-align: top;
	margin: 6px 0px 0px 78px;
}

.lk.view-vip-users .grp-head .lk-name
{
	font-family: chudFontBody;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 1px;
}

.lk.view-vip-users .grp-head .lk-note
{
	horizontal-align: left;
	vertical-align: top;
	margin: 48px 0px 0px 78px;
	font-size: 11px;
	color: chudTextFaint;
	letter-spacing: 1px;
}

.lk.view-vip-users .lk-detail .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

.lk.view-vip-users .lk-detail .lk-slot.section .lk-name
{
	font-size: 10px;
}

/* The expanded group's card reaches down around its extend steps and links: the negative
   margin starts their lines inside it, and as later siblings they draw over it. */
.lk.view-vip-users .grp-gcard.chosen
{
	height: 132px;
	margin-bottom: -58px;
}

.lk.view-vip-users .lk-detail .grp-gcard.chosen .lk-hit,
.lk.view-vip-users .lk-detail .grp-gcard.chosen .lk-hit:hover
{
	border: 1px solid chudAccentDim;
}

/* The pane's own rule clears every row inside it, which caught these buttons too. */
.lk.view-vip-users .lk-detail .lk-detail__bar .lk-hit
{
	border: 1px solid chudSurfaceEdge;
	border-radius: 4px;
	background-color: chudSurfaceRow;
}

.lk.view-vip-users .lk-detail .lk-detail__bar .lk-hit:hover
{
	border: 1px solid chudAccentBase;
	background-color: chudSurfaceHover;
}

.lk.view-vip-users .lk-detail .lk-detail__bar .danger .lk-hit
{
	border: 1px solid chudDangerBase;
	background-color: chudDangerSoft;
}

.lk.view-vip-users .lk-detail .lk-detail__bar .danger .lk-hit:hover
{
	border: 1px solid chudDangerBase;
	background-color: chudDangerDim;
}

/* The count at the box's right edge. */
.lk.view-vip-users .lk-detail .lk-slot.section .lk-text
{
	width: fill-parent-flow( 1.0 );
}

/* A group: tier, scope, end date and days left, its bar. */
.lk.view-vip-users .grp-gcard
{
	height: 76px;
	margin-bottom: 8px;
}

.lk.view-vip-users .grp-gcard .lk-glyph
{
	width: 14px;
	height: 14px;
	vertical-align: top;
	margin: 14px 0px 0px 12px;
}

.lk.view-vip-users .grp-gcard .lk-text
{
	width: 260px;
	vertical-align: top;
	margin: 11px 0px 0px 32px;
}

.lk.view-vip-users .grp-gcard .lk-name
{
	font-family: chudFontBody;
	font-size: 14px;
	font-weight: bold;
	letter-spacing: 1.5px;
}

.lk.view-vip-users .grp-gcard .lk-sub
{
	margin: 10px 0px 0px -20px;
	font-size: 11px;
	letter-spacing: 1px;
}

.lk.view-vip-users .grp-gcard .lk-tags
{
	vertical-align: top;
	margin: 12px 12px 0px 0px;
}

.lk.view-vip-users .grp-gcard .lk-tag
{
	margin: 0px;
	padding: 0px;
	border: 0px solid transparent;
	background-color: transparent;
	color: chudTextMuted;
	letter-spacing: 1px;
}

.lk.view-vip-users .grp-gcard .lk-end
{
	vertical-align: top;
	margin: 38px 12px 0px 0px;
}

.lk.view-vip-users .grp-gcard .lk-value
{
	font-family: chudFontBody;
	font-size: 12px;
	font-weight: bold;
	color: chudTextMain;
	text-transform: uppercase;
}

.lk.view-vip-users .grp-gcard .lk-meter
{
	width: 274px;
	height: 6px;
	horizontal-align: left;
	vertical-align: top;
	margin: 58px 0px 0px 12px;
	border-radius: 3px;
	background-color: chudShadowDim;
}

.lk.view-vip-users .grp-gcard .chud-meter__fill
{
	border-radius: 3px;
}

/* Extend: a caption and five steps on one line, 76 + 5 x 43 = 291 of 300; the last step ends level
   with the card's right-hand text. */
.lk.view-vip-users .grp-caption
{
	width: 76px;
	height: 30px;
	margin: 0px;
}

.lk.view-vip-users .grp-caption .lk-text
{
	margin-left: 12px;
}

.lk.view-vip-users .grp-caption .lk-name,
.lk.view-vip-users .grp-link .lk-name
{
	font-family: chudFontMedium;
	font-size: 10px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-vip-users .grp-step
{
	width: 40px;
	height: 26px;
	margin: 2px 3px 0px 0px;
}

/* Steps take the Control look, not Chip: a 100% label inside a fit-children button resolves to nothing. */
.lk.view-vip-users .grp-step .lk-text
{
	width: 100%;
	margin: 0px;
}

.lk.view-vip-users .grp-step .lk-name
{
	font-size: 11px;
	text-align: center;
}

/* Two links on a line, 2 x 140 = 280 of 300: two halves would make the line exactly full. */
.lk.view-vip-users .grp-link
{
	width: 140px;
	height: 30px;
	margin-bottom: 8px;
}

.lk.view-vip-users .grp-link .lk-text
{
	width: 120px;
	margin: 0px 0px 0px 12px;
}

.lk.view-vip-users .grp-link.danger .lk-text
{
	horizontal-align: right;
	margin: 0px 12px 0px 0px;
}

.lk.view-vip-users .grp-link .lk-name
{
	font-size: 11px;
	color: chudAccentStrong;
}

.lk.view-vip-users .grp-link.danger .lk-name
{
	color: chudDangerStrong;
	text-align: right;
}

/* ---- vip-grant: player on the left; group, scope and length beside it ---- */

.lk.view-vip-grant .lk-detail
{
	width: 540px;
	margin-left: 20px;
}

/* 488 = the page's 576 less the bar's 88: a taller form squished the bar to a strip in game. */
.lk.view-vip-grant .lk-detail__box,
.lk.view-vip-grant .lk-detail__body
{
	height: fit-children;
	max-height: 488px;
}

/* Past VipIntegration.CompactGroups: a pixel height, the only kind of box seen scrolling in game. */
.lk.view-vip-grant.variant-scroll .lk-detail__box,
.lk.view-vip-grant.variant-scroll .lk-detail__body
{
	height: 488px;
}

.lk.view-vip-grant.chud-rewind .lk-detail__items
{
	height: fit-children;
	max-height: 488px;
}

.lk.view-vip-grant .lk-detail__items
{
	flow-children: right-wrap;
}

.lk.view-vip-grant .lk-list .lk-slot
{
	height: 50px;
}

.lk.view-vip-grant .lk-list .lk-slot .lk-text
{
	width: 200px;
}

/* The list's heading outranks the two rules above, which size player rows; with them it stood
   20px taller than the detail's headings and pushed its count to the far edge. */
.lk.view-vip-grant .lk-list .lk-slot.section
{
	height: 30px;
}

.lk.view-vip-grant .lk-list .lk-slot.section .lk-text
{
	width: fit-children;
}

.lk.view-vip-grant .lk-list .lk-tags
{
	margin-right: 12px;
}

.lk.view-vip-grant .lk-list .lk-tag
{
	padding: 2px 6px;
	border-radius: 2px;
	font-family: chudFontBody;
	font-weight: bold;
}

/* The search field: a sunken box with its placeholder. */
.lk.view-vip-grant .grp-search
{
	height: 36px;
	margin-bottom: 6px;
}

.lk.view-vip-grant .grp-search .lk-glyph
{
	width: 14px;
	height: 14px;
	wash-color: chudTextFaint;
}

.lk.view-vip-grant .grp-search .lk-text
{
	margin-left: 36px;
}

.lk.view-vip-grant .grp-search .lk-name
{
	font-size: 12px;
	color: chudTextFaint;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-vip-grant .lk-detail .lk-slot
{
	width: 100%;
	margin: 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.section
{
	height: 24px;
	margin: 6px 0px 4px 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.section .lk-hit
{
	border-bottom: 0px solid transparent;
}

/* Group: three cards to a line, 3 x (170 + 8) = 534 of 540, 8px apart either way like the other card grids. */
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier
{
	width: 170px;
	height: 88px;
	margin: 0px 8px 8px 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-tier .lk-glyph
{
	width: 22px;
	height: 22px;
	vertical-align: top;
	margin: 14px 0px 0px 14px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-tier .lk-text
{
	vertical-align: top;
	margin: 44px 0px 0px 14px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-tier .lk-name
{
	font-family: chudFontBody;
	font-size: 16px;
	font-weight: bold;
	letter-spacing: 2px;
}

/* Past VipIntegration.RoomyGroups: 56px cards, glyph beside the name, three lines in 192px not 288. */
.lk.view-vip-grant.variant-compact .lk-detail .lk-slot.grp-tier
{
	height: 56px;
}

.lk.view-vip-grant.variant-compact .lk-detail .lk-slot.grp-tier .lk-glyph
{
	vertical-align: center;
	margin: 0px 0px 0px 14px;
}

.lk.view-vip-grant.variant-compact .lk-detail .lk-slot.grp-tier .lk-text
{
	width: 112px;
	vertical-align: center;
	margin: 0px 0px 0px 48px;
}

/* Scope: two halves of one control, the chosen one underlined; 2 x 264 = 528 of 540. */
.lk.view-vip-grant .lk-detail .lk-slot.grp-segment
{
	width: 264px;
	height: 40px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment .lk-hit
{
	border: 1px solid chudSurfaceEdge;
	border-radius: 0px;
	background-color: chudSurfaceRow;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment.chosen .lk-hit,
.lk.view-vip-grant .lk-detail .lk-slot.grp-segment.chosen .lk-hit:hover
{
	border-top: 0px solid chudAccentBase;
	border-right: 0px solid chudAccentBase;
	border-left: 0px solid chudAccentBase;
	border-bottom: 2px solid chudAccentBase;
	background-color: chudAccentSoft;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment .lk-glyph
{
	width: 14px;
	height: 14px;
	margin-left: 82px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment.chosen .lk-glyph
{
	wash-color: chudTextMain;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment .lk-text
{
	margin-left: 104px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment .lk-name
{
	font-size: 12px;
	color: chudTextMuted;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-segment.chosen .lk-name
{
	color: chudTextMain;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-hint
{
	height: 24px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-hint .lk-text
{
	width: 100%;
	margin: 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-hint .lk-name
{
	font-family: chudFontBody;
	font-size: 12px;
	color: chudTextFaint;
}

/* Length: pills that wrap. */
.lk.view-vip-grant .lk-detail .lk-slot.grp-pill
{
	width: fit-children;
	height: 34px;
	margin: 0px 6px 6px 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-pill .lk-hit
{
	padding: 0px 14px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-pill .lk-text
{
	width: fit-children;
	margin: 0px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-pill .lk-name
{
	width: fit-children;
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 1.5px;
}

.lk.view-vip-grant .lk-detail .lk-slot.grp-pill.tone-gold .lk-name
{
	color: chudGoldBase;
}

/* The summary and Grant, as one card. */
.lk.view-vip-grant .lk-detail__bar
{
	margin-top: 12px;
	padding: 14px 14px 14px 16px;
}

.lk.view-vip-grant .lk-detail__bar .lk-slot
{
	width: fill-parent-flow( 1.0 );
	height: 46px;
	margin: 0px;
}

.lk.view-vip-grant .lk-detail__bar .lk-text
{
	width: 320px;
	margin: 0px;
}

.lk.view-vip-grant .lk-detail__bar .lk-name
{
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.lk.view-vip-grant .lk-detail__bar .lk-sub
{
	font-size: 12px;
	letter-spacing: 1px;
}

.lk.view-vip-grant .lk-content .lk-detail__bar .lk-slot.primary
{
	width: 170px;
}

/* ---- tier colours on glyphs and names, for every VIP view ---- */

.lk.view-vip-perks .tone-gold .lk-glyph, .lk.view-vip-tiers .tone-gold .lk-glyph,
.lk.view-vip-users .tone-gold .lk-glyph, .lk.view-vip-grant .tone-gold .lk-glyph { wash-color: chudGoldBase; }
.lk.view-vip-perks .tone-info .lk-glyph, .lk.view-vip-tiers .tone-info .lk-glyph,
.lk.view-vip-users .tone-info .lk-glyph, .lk.view-vip-grant .tone-info .lk-glyph { wash-color: chudInfoBase; }
.lk.view-vip-perks .tone-legend .lk-glyph, .lk.view-vip-tiers .tone-legend .lk-glyph,
.lk.view-vip-users .tone-legend .lk-glyph, .lk.view-vip-grant .tone-legend .lk-glyph { wash-color: chudLegendBase; }

.lk.view-vip-perks .lk-banner .tone-gold .lk-name, .lk.view-vip-tiers .lk-banner .tone-gold .lk-name,
.lk.view-vip-users .tone-gold .lk-name, .lk.view-vip-grant .grp-tier.tone-gold .lk-name { color: chudGoldBase; }
.lk.view-vip-perks .lk-banner .tone-info .lk-name, .lk.view-vip-tiers .lk-banner .tone-info .lk-name,
.lk.view-vip-users .tone-info .lk-name, .lk.view-vip-grant .grp-tier.tone-info .lk-name { color: chudInfoBase; }
.lk.view-vip-tiers .lk-banner .tone-legend .lk-name, .lk.view-vip-users .tone-legend .lk-name,
.lk.view-vip-grant .lk-detail .lk-slot.grp-tier.tone-legend .lk-name { color: chudLegendBase; }
