/*
	CS2's own store and inventory look, which every v2 layout draws in. Copied from the game's
	sheets, not themed: Nav is selectedNavColor, Equip positiveColor and its "selected" tile,
	Store the panel, bars, tooltip rules and the store tile's foot shading. The v2 copies of the
	shared sheets (scripts/generate-v2-sheets.ps1) read Nav for Accent, Store for Surface and
	Text, and StoreTile for Tile, so Row, Hover, Fade and the StoreTile set exist for them.
*/
@define chudNavBase: #82d8ff;
@define chudNavStrong: #b4e8ff;
@define chudNavHalf: #82d8ff80;
@define chudNavDim: #82d8ff59;
@define chudNavSoft: #82d8ff2b;
