/* A third tier above gold (VIPCore's LEGEND), and the purple stand-in art. */
@define chudLegendBase: #c08cff;
@define chudLegendStrong: #d2b0ff;
@define chudLegendDim: #c08cff59;
@define chudLegendSoft: #c08cff1f;

/* Extend on a map vote: the orange MapChooser draws it in. Shade to Deep is its card's art. */
@define chudExtendBase: #ffa500;
@define chudExtendStrong: #ffc266;
@define chudExtendHalf: #ffa50080;
@define chudExtendDim: #ffa50059;
@define chudExtendSoft: #ffa50038;
