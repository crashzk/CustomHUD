@define chudDangerDim: #ff4f3f59;
@define chudDangerSoft: #ff4f3f33;
@define chudDangerWash: #ff4f3f14;
@define chudDangerFade: #ff4f3f00;

/* Teams. CT shares the info blue by choice, not by reference: re-theming one leaves the other. */
@define chudTeamCtBase: #5aaeff;
@define chudTeamCtStrong: #8cc4ff;
@define chudTeamCtDim: #5aaeff59;
@define chudTeamCtSoft: #5aaeff2b;
