/*
	CustomHUD design tokens: the whole palette. Include this sheet FIRST in every
	layout's <styles>: a @define is only visible to sheets included after it, and
	Panorama has no @import. No define name may be a prefix of another. csgostyles
	is not included, so the font stacks below are copied from it.

	No other sheet writes a colour literal. Each hue has one ladder, so a step
	means the same thing everywhere:
	  Fade   alpha 0     a gradient's end, in the hue's own colour
	  Wash   ~8%         a tinted area: a column, a stage, a quiet box
	  Soft   ~12-22%     a fill: pills, chosen rows, glows behind art
	  Dim    35%         an edge (pills, quiet borders, meter tracks), a label's fill when active
	  Half   50%         a strong edge, a hover fill
	  Base               the hue itself
	  Strong             the hue lightened, for text on a dark ground
	See docs/DesignLanguage.md.
*/

/* Fonts */
@define chudFontBody: Stratum2, "Arial Unicode MS";
@define chudFontMedium: Stratum2 Medium, "Arial Unicode MS";
@define chudFontLight: Stratum2 Light, "Arial Unicode MS";
@define chudFontCondensed: Stratum2 Medium Condensed, "Arial Unicode MS";
@define chudFontMono: notomono-regular;
@define chudDigitsRegular: Stratum2 Regular Monodigit, "Arial Unicode MS";
@define chudDigitsBold: Stratum2 Bold Monodigit, "Arial Unicode MS";

/*
	Accent: selection, the active entry, hover edges, your own pick. Swap this
	ladder to re-theme every layout (pink alternative: #f8a8d8 / #ffc4e6, same
	alphas). White text on full-strength orange is unreadable, so the bright hue
	goes into edges, bars and text; fills use Soft and Dim.
*/
@define chudAccentBase: #ff8a1f;
@define chudAccentStrong: #ffb066;
@define chudAccentHalf: #ff8a1f80;
@define chudAccentDim: #ff8a1f59;
@define chudAccentSoft: #ff8a1f38;
@define chudAccentWash: #ff8a1f14;
@define chudAccentFade: #ff8a1f00;

/* Gold: values, prices, headings and the leader. Deep is the quieter caption gold. */
@define chudGoldBase: #f7bd45;
@define chudGoldDeep: #d99a2b;
@define chudGoldHalf: #f7bd4580;
@define chudGoldDim: #f7bd4559;
@define chudGoldSoft: #f7bd452e;
@define chudGoldWash: #f7bd4514;
@define chudGoldFade: #f7bd4500;

/* Info: counters and shares. */
@define chudInfoBase: #5aaeff;
@define chudInfoStrong: #8cc4ff;
@define chudInfoHalf: #5aaeff80;
@define chudInfoDim: #5aaeff59;
@define chudInfoSoft: #5aaeff2b;
@define chudInfoWash: #5aaeff14;
@define chudInfoFade: #5aaeff00;

/* Status: good, a caution between good and bad, bad. */
@define chudSuccessBase: #8fd14f;
@define chudSuccessStrong: #a9e07a;
@define chudSuccessHalf: #8fd14f80;
@define chudSuccessDim: #8fd14f59;
@define chudSuccessSoft: #8fd14f1f;
