@define chudEquipSoft: #0f9d5826;
@define chudEquipRise: #08703e90;
@define chudEquipFade: #08703e00;
@define chudStoreRaised: #1e2d3df2;
@define chudStoreDeep: #14202bf2;
@define chudStoreBar: #00000040;
@define chudStoreEdge: #ffffff14;
@define chudStoreRule: #25282b;
@define chudStoreText: #cccccc;
@define chudStoreFaint: #7c7c7c;
