/*
	Surfaces: a cool near-black, so the hues carry the colour. Raised to Deep is
	every menu shell's gradient, about 86% opaque; Base is a HUD panel at 95%.
	Tiles are cards in a grid, Rows the list's lines.
*/
@define chudSurfaceBase: #0b0e13f2;
@define chudSurfaceRaised: #141a24dc;
@define chudSurfaceDeep: #0b0e13d9;
@define chudSurfaceEdge: #2a3443;
@define chudSurfaceFade: #2a344300;
@define chudSurfaceRow: #161d27;
@define chudSurfaceHover: #222c3a;
@define chudTileBase: #1c2431;
@define chudTileDeep: #0f141b;
@define chudTileHover: #283346;
@define chudTileFade: #0f141b00;

/* Shade and glass: black and white at fixed strengths, laid over any surface. */
@define chudShadowDrop: #000000b8;
@define chudShadowText: #000000cc;
@define chudShadowDim: #00000059;
@define chudShadowSoft: #0000002e;
@define chudShadowFade: #00000000;
@define chudGlassDim: #ffffff26;
@define chudGlassSoft: #ffffff1a;
@define chudGlassWash: #ffffff0d;

/* Text. Ink is the dark text on a solid hue (a gold or accent pill). */
@define chudTextMain: #f5f7fa;
@define chudTextMuted: #a5afbd;
@define chudTextFaint: #6d7787;
@define chudTextCream: #ffd28a;
@define chudTextInk: #1a1203;

