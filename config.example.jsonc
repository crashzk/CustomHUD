// CustomHUD: configs/plugins/CustomHUD/config.jsonc, exactly as CustomHUD writes it on first start.
// Changes apply on save; only RendererId needs a restart. The settings you add by hand (MenuOverrides,
// MenuLayouts, MessageLayouts, PanelLayouts, PageViews, Hints, LayoutRoot, RendererId) are in the wiki:
// https://github.com/shmitzas/CustomHUD/wiki/Configuration#settings-you-add-yourself
{
  "CustomHUD": {
    // Where players' starting navigation mode and the menu page size come from:
    // "swiftlys2" = Menus.InputMethod and MenuLayout.MaxVisibleLines in configs/menus/menus.jsonc,
    // "customhud" = DefaultNavMode and MaxVisibleLines below.
    "MenuConfig": "swiftlys2",
    // The mode players start in until they run !setnav: "buttons", "wasd", "numbers" or "mouse".
    // Used with "MenuConfig": "customhud".
    "DefaultNavMode": "buttons",
    // Lines on one page of a keyboard menu, 1-32. Used with "MenuConfig": "customhud".
    "MaxVisibleLines": 5,
    // The layout each plugin's menus draw in, for mouse players and for keyboard players (buttons, wasd, numbers).
    // Names ending in _v2 are CS2's store look, the rest the first designs. Every layout: https://github.com/shmitzas/CustomHUD/wiki/Layouts
    "Menus": {
      "WeaponSkins": {
        "Mouse": "menu_skins_mouse_v2",
        "Keyboard": "menu_list_skins_v2"
      },
      "ShopCore": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      "MapChooser": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      "Ranks": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      "VIPCore": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      "Admins": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      "MixScrims": {
        "Mouse": "menu_locker_v2",
        "Keyboard": "menu_list_v2"
      },
      // Every other plugin.
      "Other": {
        "Mouse": "menu_list_mouse_v2",
        "Keyboard": "menu_list_v2"
      }
    },
    // The game's own HUD messages: "game" leaves a kind to CS2, "hud_text" or "hud_alert" draws it in that CustomHUD layout.
    // "hud_text_v2" and "hud_alert_v2" are the same in CS2's store look.
    "Messages": {
      "Center": "game",
      "Alert": "game",
      "Notify": "game"
    },
    // Layout of each panel other plugins show through CustomHUD.
    "Panels": {
      "Versus": "panel_versus",
      "Ready": "panel_ready",
      "Timeout": "panel_timeout"
    },
    // Log every menu frame drawn and every message captured.
    "DetailedLogging": false
  }
}
