<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>CustomHUD</AssemblyName>
    <RootNamespace>CustomHUD</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/CustomHUD</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- No direct Microsoft.Extensions.* references: SwiftlyS2.CS2 brings them at the version SwiftlyS2
         itself builds against, and pinning them here fails restore (NU1605) whenever the SDK raises them. -->
    <!-- The menu framework (IMenuRenderer, MenuActionContext, Core.Menu) ships
         in 1.5.0. 1.4.x has none of it, so this floor is a hard requirement. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="[1.5.0,)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- MySqlConnector 2.4.0 arrives transitively via SwiftlyS2.CS2 1.5.0 and is never shipped or
         loaded by this plugin. Drop once the SDK floor is 1.5.1+ (which depends on 2.6.2). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-473q-m89c-ghf8" />
  </ItemGroup>

  <ItemGroup>
    <!-- resources/panorama/** are CLIENT-side assets shipped through the
         CustomHUD Workshop addon, never the plugin zip. -->
    <Content Include="resources/translations/**/*;resources/exports/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="build/**/*.cs" />
    <Compile Remove="CustomHUD.Contract/**" />
    <None Remove="CustomHUD.Contract/**" />
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the contract into resources/exports first; Private=false keeps it out of the plugin's own output. -->
    <ProjectReference Include="CustomHUD.Contract/CustomHUD.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Optional soft dependency (MIT, not on NuGet). Cookies exports this assembly
         itself; a shipped copy would be a second type identity and never resolve. -->
    <Reference Include="Cookies.Contract">
      <HintPath>lib/Cookies.Contract.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The provider plugins whose menus src/Integrations draws from their APIs, all optional and
         each exporting its own contract, so the same single-copy rule applies.
         scripts/update-contracts.ps1 rebuilds these from the providers' repositories. -->
    <Reference Include="Ranks.Contract" HintPath="lib/Ranks.Contract.dll" Private="false" />
    <Reference Include="Ranks_WeaponStats.Contract" HintPath="lib/Ranks_WeaponStats.Contract.dll" Private="false" />
    <Reference Include="Ranks_CustomCombos.Contract" HintPath="lib/Ranks_CustomCombos.Contract.dll" Private="false" />
    <Reference Include="Ranks_Prestige.Contract" HintPath="lib/Ranks_Prestige.Contract.dll" Private="false" />
    <Reference Include="WeaponSkins.Shared" HintPath="lib/WeaponSkins.Shared.dll" Private="false" />
    <Reference Include="ShopCore.Contract" HintPath="lib/ShopCore.Contract.dll" Private="false" />
    <Reference Include="MapChooser.Contract" HintPath="lib/MapChooser.Contract.dll" Private="false" />
    <Reference Include="VIPCore.Contract" HintPath="lib/VIPCore.Contract.dll" Private="false" />
    <Reference Include="Admins.Contract" HintPath="lib/Admins.Contract.dll" Private="false" />
  </ItemGroup>

  <Target Name="CreateZip" AfterTargets="Publish">
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>
